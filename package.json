{
  "name": "sourcier-uk",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.11.1",
  "scripts": {
    "clean": "rm -rf .astro dist public/pagefind .playwright-mcp",
    "dev": "pnpm assets:sync && SHOW_DRAFTS=true netlify dev",
    "dev:no-drafts": "pnpm assets:sync && netlify dev",
    "build": "astro build",
    "build:content:fetch": "git clone --depth 1 https://${GH_PAT}@github.com/sourcier/sourcier.uk-content.git collections/posts && rm -rf collections/posts/.git",
    "build:functions": "esbuild netlify/functions/*.ts --bundle --platform=node --format=esm --outdir=.netlify/functions-built",
    "build:search": "pagefind --site dist --exclude-selectors \".expressive-code\"",
    "preview": "astro preview",
    "serve:dist": "serve dist --listen 9000 --no-clipboard",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,mts,cts,astro}\"",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "astro": "astro",
    "thumbnails:generate": "node scripts/process-thumbnails.mjs",
    "thumbnails:copy": "node scripts/sync-public-assets.mjs thumbnails",
    "post-images:copy": "node scripts/sync-public-assets.mjs post-images",
    "assets:sync": "pnpm thumbnails:copy && pnpm post-images:copy",
    "search:index": "pnpm assets:sync && SHOW_DRAFTS=true astro build && pagefind --site dist --exclude-selectors \".expressive-code\" && rm -rf public/pagefind && cp -r dist/pagefind public/pagefind",
    "cover:download": "node scripts/download-cover-image.mjs",
    "crosspost:devto": "node scripts/crosspost-devto.js",
    "template:pptx": "node scripts/create-powerpoint-template.mjs",
    "talk:playwright": "node scripts/create-playwright-e2e-talk.mjs",
    "lighthouse:mobile": "node scripts/lighthouse.mjs mobile",
    "lighthouse:desktop": "node scripts/lighthouse.mjs desktop",
    "lighthouse:open:mobile": "open-cli ./reports/lighthouse/mobile.report.html",
    "lighthouse:open:desktop": "open-cli ./reports/lighthouse/desktop.report.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run --update",
    "typecheck:functions": "tsc --project netlify/functions/tsconfig.json",
    "test:visual:report": "playwright show-report reports/playwright",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.7",
    "@astrojs/rss": "^4.0.19",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@netlify/blobs": "^11.1.9",
    "astro": "^7.4.10",
    "astro-expressive-code": "^0.44.3",
    "expressive-code-color-chips": "^0.2.1",
    "mermaid": "^12.3.0",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.4",
    "stripe": "^23.1.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "^8.8.0",
    "@netlify/edge-functions": "^4.0.4",
    "@netlify/functions": "^6.1.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.6.0",
    "netlify-cli": "^27.17.0",
    "open-cli": "^9.0.0",
    "pagefind": "^1.6.0",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "remark-emoji": "^5.0.2",
    "serve": "^14.2.8",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
