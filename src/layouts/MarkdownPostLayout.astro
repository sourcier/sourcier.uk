---
import BaseLayout from "./BaseLayout.astro";
import PostHero from "../components/PostHero.astro";
import SharePost from "../components/SharePost.astro";
import Comments from "../components/Comments.astro";
import PageHistory from "../components/PageHistory.astro";
import PageCredits from "../components/PageCredits.astro";
import MailingListCTA from "../components/MailingListCTA.astro";
import SupportCTA from "../components/SponsorCTA.astro";
import SupportCheckoutModal from "../components/SupportCheckoutModal.astro";
import { getPublicationStatus } from "../utils/drafts";
import SeriesNavigation from "../components/SeriesNavigation.astro";

import TagsSidebar from "../components/TagsSidebar.astro";
const {
  frontmatter,
  postId,
  headings = [],
  readingTime,
  seriesNavigation,
} = Astro.props;
const tocHeadings = (
  headings as { depth: number; slug: string; text: string }[]
).filter((h) => h.depth === 2 || h.depth === 3);
const formattedDate = frontmatter.pubDate
  ? new Date(frontmatter.pubDate).toLocaleDateString("en-GB", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "Europe/London",
    })
  : null;
const publicationStatus = getPublicationStatus({
  draft: frontmatter.draft,
  pubDate: frontmatter.pubDate,
});
const statusValue =
  publicationStatus === "draft"
    ? "Draft"
    : publicationStatus === "scheduled"
      ? "Scheduled"
      : undefined;
const dateLabel =
  publicationStatus === "draft"
    ? "Target date"
    : publicationStatus === "scheduled"
      ? "Scheduled for"
      : "Published";

const ogImage = frontmatter.cover?.image?.src ?? undefined;
const pageTitle = `${frontmatter.title} — Sourcier`;

const thumbSrc = frontmatter.cover?.thumbnail
  ? `/search-thumbnails/${postId}/${postId}-thumbnail.webp`
  : null;
const supportPublishableKey =
  import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY?.trim() ?? "";
---

<BaseLayout
  pageTitle={pageTitle}
  description={frontmatter.description}
  ogImage={ogImage}
  ogType="article"
  pubDate={frontmatter.pubDate}
  author={frontmatter.author}
  tags={frontmatter.tags}
  tocHeadings={tocHeadings}
  pageMenuShareTitle={frontmatter.title}
  pageMenuShareUrl={Astro.url.href}
  pageMenuPostId={postId}
  pageMenuSupportEnabled={Boolean(supportPublishableKey)}
>
  <script
    is:inline
    defer
    src="https://cdn.jsdelivr.net/npm/mermaid@11.13.0/dist/mermaid.min.js"
    slot="head"></script>
  {
    supportPublishableKey && (
      <SupportCheckoutModal publishableKey={supportPublishableKey} />
    )
  }
  <article class="post" data-pagefind-body>
    <span data-pagefind-meta="title" class="visually-hidden"
      >{frontmatter.title}</span
    >
    {
      thumbSrc && (
        <img
          data-pagefind-meta="image[src]"
          src={thumbSrc}
          width="96"
          height="96"
          alt=""
          aria-hidden="true"
          class="visually-hidden"
        />
      )
    }
    <PostHero
      title={frontmatter.title}
      subtitle={frontmatter.subTitle}
      coverImage={frontmatter.cover
        ? {
            image: frontmatter.cover.image,
            alt: frontmatter.cover.alt,
            focalPoint: frontmatter.cover.focalPoint,
          }
        : undefined}
      tags={frontmatter.tags}
      status={statusValue}
      dateLabel={dateLabel}
      date={formattedDate ?? undefined}
      readingTime={readingTime}
      crumbs={[{ label: "Blog", href: "/blog" }, { label: frontmatter.title }]}
      shareUrl={Astro.url.href}
      postId={postId}
    />

    <div class="body">
      <div class="layout">
        <div class="main">
          {
            seriesNavigation && (
              <SeriesNavigation navigation={seriesNavigation} />
            )
          }
          <div class="content" id="post-content">
            <slot />
          </div>
        </div>
        <aside class="sidebar" aria-label="Post sidebar">
          {
            tocHeadings.length > 1 && (
              <nav class="toc">
                <p class="heading">On this page</p>
                <ol class="list">
                  {tocHeadings.map((h) => (
                    <li class="item" data-depth={h.depth}>
                      <a class="link" href={`#${h.slug}`}>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
          <SharePost
            title={frontmatter.title}
            url={Astro.url.href}
            vertical
            variant="sidebar"
          />
          <SupportCTA mode="support" placement="sidebar" />
          <TagsSidebar />
        </aside>
      </div>
    </div>

    <SupportCTA />
    {postId && <Comments postId={postId} />}
    <MailingListCTA />
    {
      (frontmatter.history?.length > 0 || frontmatter.credits?.length > 0) && (
        <section class="meta" aria-label="Page credits and history">
          <div class="inner">
            {frontmatter.credits && frontmatter.credits.length > 0 && (
              <PageCredits entries={frontmatter.credits} />
            )}
            {frontmatter.history && frontmatter.history.length > 0 && (
              <PageHistory entries={frontmatter.history} />
            )}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  :global(:where(.post) .mermaid-diagram),
  :global(:where(.post) .image) {
    position: relative;
    margin: 2rem 0;
    display: flex;
    justify-content: center;
    overflow-x: auto;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-compact);
    background: var(--surface-media-stage);
    padding: 2rem 1.5rem;
  }

  :global(:where(.post) .image img) {
    outline: none;
    margin: 0;
  }

  :global([data-theme="dark"] :where(.post) .mermaid-diagram),
  :global([data-theme="dark"] :where(.post) .image) {
    background: var(--surface-media-stage-dark);
  }

  :global(:where(.post) .expand) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: transparent;
    border: 1px solid rgba(var(--overlay-rgb), 0.25);
    border-radius: var(--radius-tight);
    color: rgba(var(--overlay-rgb), 0.5);
    cursor: pointer;
    transition:
      opacity 0.2s ease,
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  :global([data-theme="dark"] :where(.post) .expand) {
    border-color: var(--text-on-strong-alpha-25);
    color: var(--text-on-strong-alpha-50);
  }

  @media (hover: hover) {
    :global(:where(.post) .expand) {
      opacity: 0;
    }

    :global(:where(.post) .mermaid-diagram:hover .expand:not(:hover)),
    :global(:where(.post) .image:hover .expand:not(:hover)) {
      opacity: 0.75;
    }

    :global(:where(.post) .expand:hover) {
      opacity: 1;
    }
  }

  :global(:where(.post) .expand:hover) {
    background: rgba(var(--accent-primary-rgb), 0.1);
    border-color: rgba(var(--accent-primary-rgb), 0.5);
    color: var(--accent-primary);
  }

  :global(.lightbox) {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(var(--overlay-rgb), 0.85);
    align-items: center;
    justify-content: center;
    padding: 2rem;

    &:not([hidden]) {
      display: flex;
    }
  }

  :global(:where(.lightbox) .inner) {
    position: relative;
    background: var(--surface-media-stage);
    width: 98vw;
    max-width: 98vw;
    height: 94vh;
    max-height: 94vh;
    border-radius: var(--radius-compact);
    overflow: hidden;

    &::after {
      content: "scroll for more ↓";
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 5rem;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding-bottom: 0.75rem;
      pointer-events: none;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: rgba(var(--overlay-rgb), 0.45);
      background: linear-gradient(
        to bottom,
        transparent,
        var(--surface-media-stage)
      );
      transition: opacity 0.2s ease;
    }

    &[data-at-end]::after {
      opacity: 0;
    }
  }

  :global(:where(.lightbox) .scroll) {
    width: 100%;
    height: 100%;
    overflow: auto;
    padding: 2rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  :global(:where(.lightbox) .content) {
    margin: auto;
    flex-shrink: 0;
  }

  :global([data-theme="dark"] :where(.lightbox) .inner) {
    background: var(--surface-media-stage-dark);
  }

  :global([data-theme="dark"] :where(.lightbox) .inner::after) {
    color: rgba(var(--text-on-strong-rgb), 0.35);
    background: linear-gradient(
      to bottom,
      transparent,
      var(--surface-media-stage-dark)
    );
  }

  :global(:where(.lightbox) .close) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: transparent;
    border: 1px solid rgba(var(--overlay-rgb), 0.25);
    border-radius: var(--radius-tight);
    color: rgba(var(--overlay-rgb), 0.5);
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  :global([data-theme="dark"] :where(.lightbox) .close) {
    border-color: rgba(var(--text-on-strong-rgb), 0.25);
    color: rgba(var(--text-on-strong-rgb), 0.5);
  }

  :global(:where(.lightbox) .close:hover) {
    background: rgba(var(--accent-primary-rgb), 0.1);
    border-color: rgba(var(--accent-primary-rgb), 0.5);
    color: var(--accent-primary);
  }

  :global(:where(.post) .mermaid-diagram[data-loading]) {
    /* Approximates a typical small flowchart (2-6 nodes) so the swap from
       skeleton to rendered SVG causes minimal layout shift for real visitors. */
    min-height: 220px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.75rem;
    color: transparent; /* prevents definition text flashing between skeleton and SVG */
  }

  :global(:where(.post) .image[data-loading]) {
    min-height: 260px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  :global(:where(.post) .image[data-loading])::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--border-subtle) 25%,
      rgba(var(--accent-primary-rgb), 0.1) 50%,
      var(--border-subtle) 75%
    );
    background-size: 600px 100%;
    animation: skeleton-shimmer 1.6s ease-in-out infinite;
  }

  /* Skeleton fades out fast; image then fades in on its own via base transition */
  :global(:where(.post) .image[data-loading][data-loaded])::before {
    animation: expandable-fade-out 0.25s ease forwards;
  }

  :global(:where(.post .image) .icon) {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    z-index: 1;
    opacity: 0.25;
    color: currentColor;
    pointer-events: none;
  }

  :global(:where(.post) .image[data-loading][data-loaded] .icon) {
    animation: expandable-fade-out 0.2s ease forwards;
  }

  :global(:where(.post .image) .icon svg) {
    display: block;
  }

  :global([data-theme="dark"] :where(.post) .image[data-loading])::before {
    background: linear-gradient(
      90deg,
      rgba(var(--text-on-strong-rgb), 0.05) 25%,
      rgba(var(--accent-primary-rgb), 0.12) 50%,
      rgba(var(--text-on-strong-rgb), 0.05) 75%
    );
    background-size: 600px 100%;
  }

  /* Transition on base selector so it fires reliably when data-loading is removed */
  :global(:where(.post) .image img.zoom) {
    transition: opacity 0.5s ease;
  }

  :global(:where(.post) .image[data-loading] img) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(:where(.post) .image img.zoom) {
      transition: none;
    }
  }

  :global(:where(.post .mermaid-diagram) .skeleton) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 480px;
  }

  :global(:where(.post .mermaid-diagram .skeleton) .row) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
  }

  :global(:where(.post .mermaid-diagram .skeleton) .node) {
    height: 2.25rem;
    flex: 1;
    max-width: 140px;
    border-radius: var(--radius-tight);
    background: linear-gradient(
      90deg,
      var(--border-subtle) 25%,
      rgba(var(--accent-primary-rgb), 0.12) 50%,
      var(--border-subtle) 75%
    );
    background-size: 400px 100%;
    animation: skeleton-shimmer 1.6s ease-in-out infinite;
  }

  :global(:where(.post .mermaid-diagram .skeleton) [data-kind="wide"]) {
    max-width: 220px;
  }

  :global(:where(.post .mermaid-diagram .skeleton) [data-kind="narrow"]) {
    max-width: 90px;
  }

  :global(:where(.post .mermaid-diagram .skeleton) .connector) {
    width: 2px;
    height: 1.5rem;
    background: var(--border-subtle);
    border-radius: 1px;
    opacity: 0.6;
  }

  :global([data-theme="dark"] :where(.post .mermaid-diagram .skeleton) .node) {
    background: linear-gradient(
      90deg,
      rgba(var(--text-on-strong-rgb), 0.06) 25%,
      rgba(var(--accent-primary-rgb), 0.15) 50%,
      rgba(var(--text-on-strong-rgb), 0.06) 75%
    );
    background-size: 400px 100%;
  }

  :global(:where(.post) .mermaid-diagram svg) {
    max-width: 100%;
    height: auto;
  }

  :global(:where(.post) .mermaid-diagram text) {
    fill: var(--text-primary) !important;
  }

  :global(:where(.post) .mermaid-diagram .messageText),
  :global(:where(.post) .mermaid-diagram .labelText),
  :global(:where(.post) .mermaid-diagram .loopText),
  :global(:where(.post) .mermaid-diagram .noteText) {
    fill: var(--text-primary) !important;
    stroke: none !important;
  }

  :global(:where(.post) .mermaid-diagram line),
  :global(:where(.post) .mermaid-diagram path.arrowMarkerPath) {
    stroke: var(--text-primary) !important;
  }

  :global(:where(.post) .mermaid-diagram .messageLine0),
  :global(:where(.post) .mermaid-diagram .messageLine1) {
    stroke: var(--text-primary) !important;
  }
</style>

<script>
  // Mermaid diagrams — rendered client-side from fenced ```mermaid blocks
  import type { MermaidConfig } from "mermaid";
  import { faCircleXmark, faExpand } from "@fortawesome/free-solid-svg-icons";

  const toSvgIcon = (iconDef: typeof faExpand, size = 14): string => {
    const [width, height, , , pathData] = iconDef.icon;
    const paths = Array.isArray(pathData) ? pathData : [pathData];
    const pathElements = paths.map((d) => `<path d="${d}"/>`).join("");
    return `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${width} ${height}" fill="currentColor" aria-hidden="true">${pathElements}</svg>`;
  };

  const ICON_EXPAND = toSvgIcon(faExpand);
  const ICON_XMARK = toSvgIcon(faCircleXmark);

  const cssRgb = (name: string): string =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim();

  const cssColor = (name: string): string =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim();

  const cssRgba = (name: string, alpha: number): string =>
    `rgba(${cssRgb(name)}, ${alpha})`;

  const mermaidThemePalette = {
    dark: {
      primaryColor: "#3d1528",
      primaryTextColor: "#abb2bf",
      lineColor: "#767c89",
      secondaryColor: "#2c313a",
      titleColor: "#dcdcdc",
    },
    light: {
      primaryColor: "#fce8f2",
      primaryTextColor: "#383a42",
      lineColor: "#6b6b6b",
      secondaryColor: "#f0f0f0",
      titleColor: "#383a42",
    },
  } as const;

  function getMermaidConfig(isDark: boolean): MermaidConfig {
    const themePalette = isDark
      ? mermaidThemePalette.dark
      : mermaidThemePalette.light;
    const background = isDark
      ? cssColor("--surface-media-stage-dark")
      : cssColor("--surface-media-stage");
    const primaryBorderColor = cssRgba(
      "--accent-primary-rgb",
      isDark ? 0.4 : 0.3,
    );

    return {
      startOnLoad: false,
      theme: "base",
      darkMode: isDark,
      look: "handDrawn",
      themeVariables: {
        background,
        primaryColor: themePalette.primaryColor,
        primaryTextColor: themePalette.primaryTextColor,
        primaryBorderColor,
        lineColor: themePalette.lineColor,
        secondaryColor: themePalette.secondaryColor,
        tertiaryColor: background,
        edgeLabelBackground: background,
        clusterBkg: themePalette.secondaryColor,
        titleColor: themePalette.titleColor,
        nodeTextColor: themePalette.primaryTextColor,
        fontFamily: '"Barlow Condensed", sans-serif',
      },
    };
  }

  // Lightbox — created once, shared across all diagrams and images
  const lightbox = document.createElement("div");
  lightbox.className = "lightbox";
  lightbox.hidden = true;
  lightbox.setAttribute("role", "dialog");
  lightbox.setAttribute("aria-modal", "true");
  lightbox.setAttribute("aria-label", "Diagram fullscreen view");
  const lightboxInner = document.createElement("div");
  lightboxInner.className = "inner";
  const lightboxScroll = document.createElement("div");
  lightboxScroll.className = "scroll";
  const closeBtn = document.createElement("button");
  closeBtn.className = "close";
  closeBtn.innerHTML = ICON_XMARK;
  closeBtn.setAttribute("aria-label", "Close fullscreen diagram");
  lightboxInner.appendChild(lightboxScroll);
  lightboxInner.appendChild(closeBtn);
  lightbox.appendChild(lightboxInner);
  document.body.appendChild(lightbox);

  const closeLightbox = () => {
    lightbox.hidden = true;
    lightboxScroll.querySelector(".content")?.remove();
    document.documentElement.style.overflow = "";
    document.body.style.overflow = "";
  };

  const updateScrollHint = () => {
    const atBottom =
      lightboxScroll.scrollHeight - lightboxScroll.scrollTop <=
      lightboxScroll.clientHeight + 4; // 4px tolerance for sub-pixel browser rounding
    lightboxInner.toggleAttribute("data-at-end", atBottom);
  };

  lightboxScroll.addEventListener("scroll", updateScrollHint, {
    passive: true,
  });

  closeBtn.addEventListener("click", closeLightbox);
  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });

  // Store {definition, expandBtn} keyed by container for theme re-render
  const definitions = new Map<
    HTMLElement,
    { definition: string; btn: HTMLButtonElement }
  >();

  document
    .querySelectorAll<HTMLElement>(
      ".post .content .mermaid-diagram[data-mermaid]",
    )
    .forEach((container) => {
      const definition = container.dataset.mermaid!;

      const expandBtn = document.createElement("button");
      expandBtn.className = "expand";
      expandBtn.innerHTML = ICON_EXPAND;
      expandBtn.setAttribute("aria-label", "View diagram fullscreen");

      expandBtn.addEventListener("click", () => {
        const svgClone = container
          .querySelector("svg")!
          .cloneNode(true) as SVGElement;
        svgClone.classList.add("content");
        svgClone.removeAttribute("style");
        svgClone.removeAttribute("width");
        svgClone.removeAttribute("height");
        svgClone.style.display = "block";
        const viewBoxAttr = svgClone.getAttribute("viewBox");
        if (viewBoxAttr) {
          const parts = viewBoxAttr
            .trim()
            .split(/[\s,]+/)
            .map(Number);
          if (parts.length === 4 && parts[2] > 0 && parts[3] > 0) {
            const rem = parseFloat(
              getComputedStyle(document.documentElement).fontSize,
            );
            const availW = window.innerWidth * 0.98 - 4 * rem;
            const availH = window.innerHeight * 0.94 - 4 * rem;
            const scale = Math.min(availW / parts[2], availH / parts[3]);
            svgClone.style.width = `${Math.round(parts[2] * scale)}px`;
            svgClone.style.height = `${Math.round(parts[3] * scale)}px`;
          } else {
            svgClone.style.width = "100%";
            svgClone.style.height = "auto";
          }
        } else {
          svgClone.style.width = "100%";
          svgClone.style.height = "auto";
        }
        lightboxScroll.appendChild(svgClone);
        lightboxScroll.scrollTop = 0;
        lightbox.hidden = false;
        document.documentElement.style.overflow = "hidden";
        document.body.style.overflow = "hidden";
        updateScrollHint();
        closeBtn.focus();
      });

      definitions.set(container, { definition, btn: expandBtn });
    });

  // Image expand — wrapper div is injected at build time by rehype-images
  document
    .querySelectorAll<HTMLImageElement>(".post .content img.zoom")
    .forEach((imgEl) => {
      const wrapper = imgEl.parentElement!;

      // Icon is stamped into the HTML at build time by rehype-images
      const placeholder = wrapper.querySelector(".icon");

      const revealImage = (animate = true) => {
        if (!animate) {
          wrapper.removeAttribute("data-loading");
          placeholder?.remove();
          return;
        }
        wrapper.setAttribute("data-loaded", "");
        // After skeleton fades out (0.25s), remove data-loading → image's base
        // transition (0.5s) fires naturally as opacity goes 0 → 1
        setTimeout(() => {
          wrapper.removeAttribute("data-loading");
          wrapper.removeAttribute("data-loaded");
          placeholder?.remove();
        }, 280);
      };
      if (imgEl.complete) {
        revealImage(false);
      } else {
        imgEl.addEventListener("load", () => revealImage(true), { once: true });
        imgEl.addEventListener("error", () => revealImage(false), {
          once: true,
        });
      }

      const expandBtn = document.createElement("button");
      expandBtn.className = "expand";
      expandBtn.innerHTML = ICON_EXPAND;
      expandBtn.setAttribute("aria-label", "View image fullscreen");

      expandBtn.addEventListener("click", () => {
        const imgClone = document.createElement("img");
        imgClone.src = imgEl.src;
        imgClone.alt = imgEl.alt;
        imgClone.className = "content";
        imgClone.style.display = "block";
        const rem = parseFloat(
          getComputedStyle(document.documentElement).fontSize,
        );
        const availW = window.innerWidth * 0.98 - 4 * rem;
        const availH = window.innerHeight * 0.94 - 4 * rem;
        const nw = imgEl.naturalWidth;
        const nh = imgEl.naturalHeight;
        if (nw > 0 && nh > 0) {
          const scale = Math.min(availW / nw, availH / nh);
          imgClone.style.width = `${Math.round(nw * scale)}px`;
          imgClone.style.height = `${Math.round(nh * scale)}px`;
        } else {
          imgClone.style.width = "100%";
          imgClone.style.height = "auto";
        }
        lightboxScroll.appendChild(imgClone);
        lightboxScroll.scrollTop = 0;
        lightbox.hidden = false;
        document.documentElement.style.overflow = "hidden";
        document.body.style.overflow = "hidden";
        updateScrollHint();
        closeBtn.focus();
      });

      wrapper.appendChild(expandBtn);
    });

  type MermaidApi = {
    initialize: (config: unknown) => void;
    run: (options: { nodes: Element[] }) => Promise<void>;
  };

  async function renderDiagrams() {
    // Poll for mermaid — on slow connections the CDN defer script may not have executed yet
    const windowWithMermaid = window as Window & { mermaid?: MermaidApi };
    const mermaid = await new Promise<MermaidApi>((resolve) => {
      if (windowWithMermaid.mermaid) {
        resolve(windowWithMermaid.mermaid);
        return;
      }
      const id = setInterval(() => {
        if (windowWithMermaid.mermaid) {
          clearInterval(id);
          resolve(windowWithMermaid.mermaid);
        }
      }, 10);
    });

    // Mermaid measures text synchronously during run() — if Barlow/Barlow Condensed
    // haven't finished loading yet, it falls back to system font metrics and bakes
    // slightly different (and permanent) node dimensions into the rendered SVG.
    await document.fonts.ready;

    const isDark = document.documentElement.dataset.theme === "dark";
    mermaid.initialize(getMermaidConfig(isDark));

    // Replace skeleton with definition text — mermaid.run() will replace it with SVG
    definitions.forEach(({ definition }, container) => {
      container.removeAttribute("data-processed");
      container.setAttribute("data-loading", "");
      container.textContent = definition;
    });

    await mermaid.run({ nodes: [...definitions.keys()] });

    definitions.forEach(({ btn }, container) => {
      container.removeAttribute("data-loading");
      container.appendChild(btn);

      const svgEl = container.querySelector("svg");
      if (svgEl) {
        const titleText = container.dataset.title;
        if (titleText) {
          const titleId = `mermaid-title-${Math.random().toString(36).slice(2, 8)}`;
          const titleEl = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "title",
          );
          titleEl.id = titleId;
          titleEl.textContent = titleText;
          svgEl.prepend(titleEl);
          svgEl.setAttribute("role", "img");
          svgEl.setAttribute("aria-labelledby", titleId);
        } else {
          svgEl.setAttribute("role", "img");
          svgEl.setAttribute("aria-label", "Diagram");
        }
      }
    });
  }

  await renderDiagrams();

  // Re-render diagrams when the theme changes (Header.astro uses setAttribute)
  new MutationObserver(async (mutations) => {
    for (const m of mutations) {
      if (m.attributeName === "data-theme") {
        await renderDiagrams();
        break;
      }
    }
  }).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  // Highlight the active ToC link as the user scrolls
  const tocLinks =
    document.querySelectorAll<HTMLAnchorElement>(".post .toc .link");
  if (tocLinks.length) {
    const setActive = (id: string) => {
      tocLinks.forEach((link) => {
        if (link.getAttribute("href") === `#${id}`) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const headingEls = document.querySelectorAll<HTMLElement>(
      ".post .content h2, .post .content h3",
    );
    const obs = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
            break;
          }
        }
      },
      { rootMargin: "0px 0px -80% 0px" },
    );
    headingEls.forEach((h) => obs.observe(h));
  }
</script>
