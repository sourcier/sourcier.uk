---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import MailingListCTA from "../../components/MailingListCTA.astro";
import { audienceGuides } from "../../data/audienceGuides";
import GuideCard from "../../components/GuideCard.astro";
---

<BaseLayout
  pageTitle="Guides — Sourcier"
  description="Choose a practical, article-led guide for transitioning into tech, growing as an engineer, or improving engineering practice on your team."
>
  <PageHero
    kicker="Start here"
    title="Choose the guide that matches where you are now"
    tone="secondary"
    subtitle="Guides are the free, article-led way to get oriented. Start with the one that fits your situation, read the published pieces, and see what is planned next. If you want structured teaching with included 1:1 support, that is what courses are for."
  />

  <section
    class="section guides-grid flow-section flow-section--loose"
    aria-labelledby="guides-grid-heading"
  >
    <div class="container is-max-desktop">
      <p class="section-label">Guides</p>
      <h2 class="guides-grid__heading" id="guides-grid-heading">
        Three practical reading guides into the site
      </h2>
      <p class="guides-grid__intro">
        Each guide groups the published articles for one audience and shows the
        next topics still to come, so you can decide what to read first before
        you commit to anything more structured.
      </p>
      <div class="guides-grid__cards">
        {
          audienceGuides.map((guide) => (
            <GuideCard
              slug={guide.slug}
              title={guide.title}
              summary={guide.summary}
              href={guide.href}
              publishedCount={guide.currentPostIds.length}
              plannedCount={guide.plannedArticles.length}
            />
          ))
        }
      </div>
    </div>
  </section>

  <MailingListCTA />
</BaseLayout>

<style>
  .guides-grid {
    padding-top: 0;
    padding-bottom: 0;
  }

  .guides-grid__heading {
    margin: 0 0 1.5rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    line-height: 1.05;
    color: var(--text-primary);
  }

  .guides-grid__intro {
    max-width: 64ch;
    margin: 0 0 1.5rem;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .guides-grid__cards {
    display: grid;
    gap: 1rem;

    @media (min-width: 768px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
