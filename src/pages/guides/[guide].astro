---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import readingTime from "reading-time";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BlogPost from "../../components/BlogPost.astro";
import MailingListCTA from "../../components/MailingListCTA.astro";
import { audienceGuides, getAudienceGuide } from "../../data/audienceGuides";
import { getGuideIcon } from "../../utils/contentIcons";
import { faIcon } from "../../utils/icons";
import { isPublished } from "../../utils/drafts";
import {
  faCircleInfo,
  faClock,
  faListCheck,
  faUsers,
} from "@fortawesome/free-solid-svg-icons";

export async function getStaticPaths() {
  return audienceGuides.map((guide) => ({
    params: { guide: guide.slug },
    props: { guide },
  }));
}

const { guide: guideFromProps } = Astro.props;
const guide = guideFromProps ?? getAudienceGuide(Astro.params.guide ?? "");

if (!guide) {
  throw new Error(`Unknown audience guide: ${Astro.params.guide}`);
}

const allPosts = (await getCollection("posts"))
  .filter(isPublished)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsById = new Map(allPosts.map((post) => [post.id, post]));
function isPostEntry(
  post: CollectionEntry<"posts"> | undefined,
): post is CollectionEntry<"posts"> {
  return Boolean(post);
}
const guidePosts = guide.currentPostIds
  .map((postId) => postsById.get(postId))
  .filter(isPostEntry);

const guidePageIcon = getGuideIcon(guide.slug, 18);
const overviewIcon = faIcon(faCircleInfo, { size: 16 });
const audienceIcon = faIcon(faUsers, { size: 16 });
const coverageIcon = faIcon(faListCheck, { size: 16 });
const plannedIcon = faIcon(faClock, { size: 14 });
---

<BaseLayout
  pageTitle={`${guide.pageTitle} — Guides — Sourcier`}
  description={guide.pageDescription}
>
  <PageHero
    kicker="Start here"
    title={guide.pageTitle}
    tone="secondary"
    subtitle={guide.pageSubtitle}
  />

  <section
    class="section guide-intro flow-section flow-section--loose"
    aria-labelledby="guide-intro-heading"
  >
    <div class="layout-container layout-container-narrow">
      <div class="guide-intro__panel page-panel">
        <p class="section-label guide-intro__label">
          <span
            class="guide-intro__label-icon"
            aria-hidden="true"
            set:html={overviewIcon}
          />
          <span>Overview</span>
        </p>
        <div class="guide-intro__heading-row">
          <span
            class="guide-intro__icon"
            aria-hidden="true"
            set:html={guidePageIcon}
          />
          <h2 class="guide-intro__heading" id="guide-intro-heading">
            A practical reading guide, not a course syllabus
          </h2>
        </div>
        <p class="guide-intro__body">{guide.intro}</p>
        <p class="guide-intro__body">
          Use this guide when you want a curated set of articles, examples, and
          next topics in a sensible order. It is the free reading path through
          the subject, not the structured teaching product.
        </p>
      </div>
    </div>
  </section>

  <section
    class="section guide-panels flow-section"
    aria-labelledby="guide-panels-heading"
  >
    <div class="layout-container layout-container-narrow">
      <div class="guide-panels__grid">
        <article class="guide-panel">
          <p class="guide-panel__kicker">
            <span
              class="guide-panel__kicker-icon"
              aria-hidden="true"
              set:html={audienceIcon}
            />
            <span>Who this is for</span>
          </p>
          <h2 class="guide-panel__title" id="guide-panels-heading">
            Start here if this sounds like you
          </h2>
          <ul class="guide-panel__list" role="list">
            {guide.whoItsFor.map((item) => <li>{item}</li>)}
          </ul>
        </article>

        <article class="guide-panel">
          <p class="guide-panel__kicker">
            <span
              class="guide-panel__kicker-icon"
              aria-hidden="true"
              set:html={coverageIcon}
            />
            <span>What you will get</span>
          </p>
          <h2 class="guide-panel__title">What this guide will cover</h2>
          <ul class="guide-panel__list" role="list">
            {guide.whatYouWillGet.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section
    class="section guide-current flow-section"
    aria-labelledby="guide-current-heading"
  >
    <div class="layout-container layout-container-narrow">
      <p class="section-label">Published now</p>
      <h2 class="guide-current__heading" id="guide-current-heading">
        Read these first
      </h2>
      <div class="guide-current__grid">
        {
          guidePosts.map((post) => (
            <BlogPost
              title={post.data.title}
              subTitle={post.data.subTitle}
              description={post.data.description}
              url={`/blog/${post.id}`}
              cover={post.data.cover}
              pubDate={post.data.pubDate}
              draft={post.data.draft}
              readingTime={readingTime(post.body ?? "").text}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="section guide-planned flow-section"
    aria-labelledby="guide-planned-heading"
  >
    <div class="layout-container layout-container-narrow">
      <p class="section-label">Coming next</p>
      <h2 class="guide-planned__heading" id="guide-planned-heading">
        Planned articles for this path
      </h2>
      <p class="guide-planned__intro">
        These are the topics I plan to add next so this path becomes more useful
        over time.
      </p>
      <div class="guide-planned__grid">
        {
          guide.plannedArticles.map((article) => (
            <article class="planned-article-card">
              <p class="planned-article-card__status">
                <span
                  class="planned-article-card__status-icon"
                  aria-hidden="true"
                  set:html={plannedIcon}
                />
                <span>Planned</span>
              </p>
              <h3 class="planned-article-card__title">{article.title}</h3>
              <p class="planned-article-card__body">{article.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="section guide-cta flow-section"
    aria-labelledby="guide-cta-heading"
  >
    <div class="layout-container layout-container-narrow">
      <div class="guide-cta__panel">
        <div>
          <p class="guide-cta__kicker">Next step</p>
          <h2 class="guide-cta__title" id="guide-cta-heading">
            Want help beyond the articles?
          </h2>
          <p class="guide-cta__body">
            If this guide matches where you are now and you want help beyond the
            free articles, you can either get in touch directly or subscribe so
            you hear about new pieces as this guide grows.
          </p>
        </div>
        <div class="guide-cta__actions">
          <a href={guide.supportHref} class="guide-cta__primary">
            {guide.supportLabel}
          </a>
          <a href="/blog" class="guide-cta__secondary">Browse the blog</a>
        </div>
      </div>
    </div>
  </section>

  <MailingListCTA />
</BaseLayout>

<style>
  .guide-intro {
    padding-top: 0;
    padding-bottom: 0;
  }

  .guide-current__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;

    @media (min-width: 769px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .guide-panels,
  .guide-panels,
  .guide-current,
  .guide-planned,
  .guide-cta {
    padding-top: 0;
    padding-bottom: 0;
  }

  .guide-intro__panel {
    padding-top: 1.5rem;
  }

  .guide-intro__label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .guide-intro__label-icon,
  .guide-panel__kicker-icon,
  .planned-article-card__status-icon,
  .guide-intro__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;

    :global(svg) {
      display: block;
    }
  }

  .guide-intro__heading-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .guide-intro__icon {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-pill);
    background: color-mix(
      in srgb,
      var(--surface-page) 82%,
      var(--accent-primary) 18%
    );
    color: var(--accent-primary);
  }

  .guide-intro__heading,
  .guide-current__heading,
  .guide-planned__heading {
    margin: 0 0 1rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .guide-intro__body,
  .guide-planned__intro,
  .guide-cta__body {
    max-width: 64ch;
    margin: 0;
    line-height: 1.75;
    color: var(--text-muted);
  }

  .guide-intro__body + .guide-intro__body {
    margin-top: 1rem;
  }

  .guide-panels__grid,
  .guide-planned__grid {
    display: grid;
    gap: 1rem;

    @media (min-width: 768px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .guide-panel,
  .planned-article-card,
  .guide-cta__panel {
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--accent-primary);
    border-radius: 10px;
    background:
      linear-gradient(
        155deg,
        color-mix(in srgb, var(--accent-primary) 5%, var(--surface-elevated)) 0%,
        var(--surface-elevated) 58%
      ),
      var(--surface-elevated);
    box-shadow: var(--shadow-panel-soft);
  }

  .guide-panel,
  .planned-article-card {
    padding: 1.5rem;
  }

  .guide-panel__kicker,
  .planned-article-card__status,
  .guide-cta__kicker {
    margin: 0 0 0.6rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .guide-panel__kicker,
  .planned-article-card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .guide-panel__kicker-icon,
  .planned-article-card__status-icon,
  .guide-intro__label-icon {
    color: var(--accent-primary);
  }

  .guide-panel__title,
  .planned-article-card__title,
  .guide-cta__title {
    margin: 0 0 0.75rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.2rem;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .guide-panel__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;

    li {
      position: relative;
      padding-left: 1rem;
      line-height: 1.65;
      color: var(--text-muted);

      &::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.72em;
        width: 0.35rem;
        height: 0.35rem;
        border-radius: var(--radius-pill);
        background: var(--accent-primary);
      }
    }
  }

  .planned-article-card__body {
    margin: 0;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .guide-cta__panel {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem;

    @media (min-width: 768px) {
      grid-template-columns: minmax(0, 1.6fr) auto;
      align-items: center;
    }
  }

  .guide-cta__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .guide-cta__primary,
  .guide-cta__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-tight);
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .guide-cta__primary {
    background: var(--accent-primary);
    color: var(--text-on-strong);
  }

  .guide-cta__secondary {
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    background: transparent;
  }
</style>
