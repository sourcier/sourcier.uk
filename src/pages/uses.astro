---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import MailingListCTA from "../components/MailingListCTA.astro";
import SupportCTA from "../components/SponsorCTA.astro";
import SupportCheckoutModal from "../components/SupportCheckoutModal.astro";
import { faGithub } from "@fortawesome/free-brands-svg-icons";
import {
  faBolt,
  faBriefcase,
  faLaptop,
  faMobileScreen,
  faHeadphones,
  faCode,
  faTerminal,
  faHeart,
  faRobot,
  faMagnifyingGlass,
  faWindowRestore,
  faToggleOn,
  faCalendarDays,
} from "@fortawesome/free-solid-svg-icons";
import { faIcon } from "../utils/icons";

const hardware = [
  {
    name: "MacBook Pro M1",
    description:
      "Primary machine for all development, writing, and everything in between. Fast, quiet, and the battery life is still ridiculous.",
    icon: faIcon(faLaptop, { size: 24 }),
  },
  {
    name: "iPhone 14 Pro Max",
    description:
      "Daily driver. The large screen is the main reason — reading, notes, and testing mobile layouts.",
    icon: faIcon(faMobileScreen, { size: 24 }),
  },
  {
    name: "Bose QC35 Headphones",
    description:
      "Wireless noise cancellation for deep focus. A non-negotiable when working in a busy office or open plan environment.",
    icon: faIcon(faHeadphones, { size: 24 }),
  },
];

const devTools = [
  {
    name: "VS Code",
    description:
      "Primary editor for everything. Extensions, settings sync, and GitHub Copilot integration make it hard to reach for anything else.",
    url: "https://code.visualstudio.com",
    icon: faIcon(faCode, { size: 24 }),
  },
  {
    name: "iTerm2",
    description:
      "Terminal replacement with split panes, profiles, and better search. Paired with zsh and a minimal prompt.",
    url: "https://iterm2.com",
    icon: faIcon(faTerminal, { size: 24 }),
  },
  {
    name: "GitHub Copilot",
    description:
      "AI pair programmer used daily at work. Strongest for boilerplate and tests — less useful for architectural decisions.",
    url: "https://github.com/features/copilot",
    icon: faIcon(faGithub, { size: 24 }),
  },
  {
    name: "Claude",
    description:
      "Personal AI for writing, debugging, and thinking through problems. Tends to reason better than other models on complex tasks.",
    url: "https://claude.ai",
    icon: faIcon(faRobot, { size: 24 }),
  },
];

const macosApps = [
  {
    name: "Alfred",
    description:
      "App launcher and workflow automation. Replaced Spotlight years ago and never looked back. The clipboard history alone is worth it.",
    url: "https://www.alfredapp.com",
    icon: faIcon(faMagnifyingGlass, { size: 24 }),
  },
  {
    name: "Rectangle Pro",
    description:
      "Window management via keyboard shortcuts. Snap to halves, thirds, and corners without touching the mouse.",
    url: "https://rectangleapp.com/pro",
    icon: faIcon(faWindowRestore, { size: 24 }),
  },
  {
    name: "Only Switch",
    description:
      "Menu bar utility for toggling system settings — Night Shift, hidden files, AirPods switching — without digging through System Preferences.",
    url: "https://fireball.studio/onlyswitch",
    icon: faIcon(faToggleOn, { size: 24 }),
  },
  {
    name: "Calendar 366 II",
    description:
      "Full-featured calendar app that shows today's events in the menu bar. The week and year views make planning at a glance much easier.",
    url: "https://nspektor.com/calendar366/mac",
    icon: faIcon(faCalendarDays, { size: 24 }),
  },
];

const setupPrinciples = [
  {
    label: "Fast enough to stay out of the way",
    icon: faIcon(faBolt, { size: 16 }),
  },
  {
    label: "Portable between home and office",
    icon: faIcon(faBriefcase, { size: 16 }),
  },
  {
    label: "Low-friction tools I genuinely enjoy using",
    icon: faIcon(faHeart, { size: 16 }),
  },
];

const supportPublishableKey =
  import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY?.trim() ?? "";
---

<BaseLayout
  pageTitle="Uses — Sourcier"
  description="The hardware and software Roger Rajaratnam reaches for every day — MacBook Pro M1, VS Code, iTerm2, Alfred, and more."
  pageMenuSupportEnabled={Boolean(supportPublishableKey)}
>
  {
    supportPublishableKey && (
      <SupportCheckoutModal publishableKey={supportPublishableKey} />
    )
  }
  <PageHero
    kicker="My setup"
    title="Uses"
    tone="neutral"
    subtitle="The hardware and software I reach for every day"
  />

  <section
    class="uses-intro flow-section flow-section--loose"
    aria-labelledby="uses-intro-heading"
  >
    <div class="container is-max-desktop">
      <div class="page-panel uses-intro__panel">
        <div class="uses-intro__copy">
          <p class="uses-intro__eyebrow">Setup philosophy</p>
          <h2 class="uses-intro__title" id="uses-intro-heading">
            A setup built for focus, portability, and low friction
          </h2>
          <p class="uses-intro__text">
            I optimise for tools that help me ship, teach, write, and debug
            without getting in the way. Nothing here is chosen for novelty. It
            all earns its place by being useful day after day.
          </p>
        </div>
        <ul class="uses-intro__list" role="list">
          {
            setupPrinciples.map((item) => (
              <li>
                <span
                  class="uses-intro__list-icon"
                  aria-hidden="true"
                  set:html={item.icon}
                />
                <span>{item.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <div class="uses-page flow-section">
    <div class="container is-max-desktop">
      <!-- Hardware -->
      <section
        class="uses-section uses-section--hardware"
        aria-labelledby="hardware-heading"
      >
        <div class="uses-section__header">
          <p class="section-label" id="hardware-heading">Hardware</p>
          <p class="uses-section__intro">
            The devices I rely on for development, writing, and day-to-day
            testing.
          </p>
        </div>
        <ul class="uses-grid" role="list">
          {
            hardware.map(({ name, description, icon }) => (
              <li class="uses-card">
                <span
                  class="uses-card__icon"
                  set:html={icon}
                  aria-hidden="true"
                />
                <div class="uses-card__body">
                  <h2 class="uses-card__name">{name}</h2>
                  <p class="uses-card__desc">{description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Development -->
      <section
        class="uses-section uses-section--development"
        aria-labelledby="dev-heading"
      >
        <div class="uses-section__header">
          <p class="section-label" id="dev-heading">Development</p>
          <p class="uses-section__intro">
            The editor, terminal, and AI tools I use to write, test, and think
            through software work.
          </p>
        </div>
        <ul class="uses-grid" role="list">
          {
            devTools.map(({ name, description, url, icon }) => (
              <li class="uses-card">
                <span
                  class="uses-card__icon"
                  set:html={icon}
                  aria-hidden="true"
                />
                <div class="uses-card__body">
                  <h2 class="uses-card__name">
                    {url ? (
                      <a href={url} target="_blank" rel="noopener noreferrer">
                        {name}
                      </a>
                    ) : (
                      name
                    )}
                  </h2>
                  <p class="uses-card__desc">{description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- macOS Apps -->
      <section
        class="uses-section uses-section--apps"
        aria-labelledby="apps-heading"
      >
        <div class="uses-section__header">
          <p class="section-label" id="apps-heading">macOS Apps</p>
          <p class="uses-section__intro">
            Utility apps that remove friction from planning, window management,
            and daily navigation.
          </p>
        </div>
        <ul class="uses-grid" role="list">
          {
            macosApps.map(({ name, description, url, icon }) => (
              <li class="uses-card">
                <span
                  class="uses-card__icon"
                  set:html={icon}
                  aria-hidden="true"
                />
                <div class="uses-card__body">
                  <h2 class="uses-card__name">
                    {url ? (
                      <a href={url} target="_blank" rel="noopener noreferrer">
                        {name}
                      </a>
                    ) : (
                      name
                    )}
                  </h2>
                  <p class="uses-card__desc">{description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  <SupportCTA mode="support" />

  <MailingListCTA />
</BaseLayout>

<style>
  .uses-intro {
    padding: 0 1.5rem;
  }

  .uses-intro__panel {
    display: grid;
    gap: 1.5rem;
    background:
      radial-gradient(
        circle at top right,
        color-mix(in srgb, var(--accent-secondary) 14%, transparent) 0%,
        transparent 34%
      ),
      linear-gradient(
        150deg,
        color-mix(in srgb, var(--accent-primary) 4%, var(--surface-elevated)) 0%,
        var(--surface-elevated) 62%
      ),
      var(--surface-elevated);

    @media (min-width: 768px) {
      grid-template-columns: minmax(0, 1.45fr) minmax(16rem, 0.9fr);
      gap: 2rem;
      align-items: center;
    }
  }

  .uses-intro__eyebrow {
    margin: 0 0 0.65rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-secondary);
  }

  .uses-intro__title {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(2rem, 4vw, 2.85rem);
    line-height: 0.98;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .uses-intro__text {
    margin: 0.9rem 0 0;
    max-width: 58ch;
    line-height: 1.75;
    color: var(--text-muted);
  }

  .uses-intro__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .uses-intro__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.95rem 1rem;
    border: 1px solid var(--accent-secondary-alpha-16);
    border-radius: var(--radius-soft);
    background: color-mix(
      in srgb,
      var(--accent-secondary) 8%,
      var(--surface-elevated)
    );
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .uses-intro__list-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: var(--radius-pill);
    background: color-mix(
      in srgb,
      var(--surface-page) 82%,
      var(--accent-secondary) 18%
    );
    color: var(--accent-secondary);
    flex-shrink: 0;

    :global(svg) {
      display: block;
    }
  }

  .uses-page {
    padding: 0 1.5rem;
  }

  .uses-section {
    --uses-accent: var(--accent-primary);
    margin-bottom: 3.5rem;

    &:last-child {
      margin-bottom: 0;
    }
  }

  .uses-section--development {
    --uses-accent: var(--accent-secondary);
  }

  .uses-section--apps {
    --uses-accent: var(--text-primary);
  }

  .uses-section__header {
    display: grid;
    gap: 0.55rem;
    max-width: 56ch;
    margin-bottom: 1.25rem;
  }

  .uses-section__intro {
    margin: 0;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .uses-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;

    @media (min-width: 640px) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .uses-card {
    display: flex;
    gap: 1rem;
    min-height: 100%;
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--uses-accent);
    border-radius: var(--radius-panel);
    padding: 1.5rem 1.25rem 1.25rem;
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--uses-accent) 6%, var(--surface-elevated)) 0%,
        var(--surface-elevated) 62%
      ),
      var(--surface-elevated);
    box-shadow: var(--shadow-panel);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;

    &:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-lift);
    }
  }

  .uses-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    margin-top: 0.1rem;
    border-radius: var(--radius-panel);
    color: var(--uses-accent);
    background: color-mix(in srgb, var(--uses-accent) 10%, transparent);

    :global(svg) {
      display: block;
    }
  }

  .uses-card__body {
    display: grid;
    gap: 0.5rem;
  }

  .uses-card__name {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    margin-bottom: 0.5rem;

    a {
      color: inherit;
      text-decoration: none;

      &:hover {
        color: var(--uses-accent);
      }
    }
  }

  .uses-card__desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }
</style>
