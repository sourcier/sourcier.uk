---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CourseInterestForm from "../components/CourseInterestForm.astro";
import {
  faClock,
  faLayerGroup,
  faUsers,
} from "@fortawesome/free-solid-svg-icons";
import {
  courseBundle,
  courseLaunchLabel,
  courseOffers,
  courseSupportOffer,
} from "../data/courses";
import { getCourseIcon } from "../utils/contentIcons";
import { faIcon } from "../utils/icons";

const learningModel = [
  {
    title: "Still relevant in the age of AI",
    icon: faIcon(faLayerGroup, { size: 18 }),
    body: "AI can help you move faster, but it cannot replace judgment about semantics, accessibility, architecture, debugging, and delivery. These courses build the context you need to use AI well instead of trusting it blindly.",
  },
  {
    title: "More attention than a boot camp cohort",
    icon: faIcon(faClock, { size: 18 }),
    body: "When I taught at boot camps, one of the hardest things was giving every student the attention they needed at the exact moment they were stuck. The self-paced format plus included 1:1 support is designed to fix that.",
  },
  {
    title: "Smaller upfront commitment",
    icon: faIcon(faUsers, { size: 18 }),
    body: "You can start with one course instead of paying for an all-or-nothing programme, then add more only when it helps.",
  },
];

const supportMoments = [
  "Project reviews when you want grounded feedback on architecture, code, or delivery decisions.",
  "Debugging sessions when you are stuck and need to move faster than a forum thread or recorded lesson can help.",
  "Roadmap resets when you are not sure what to learn next or how to connect isolated topics into real project work.",
];

const supportInclusions = [
  {
    title: "Every path includes 1:1",
    body: "Whether you start with one course or take the full bundle, direct support is part of the offer.",
    icon: faIcon(faUsers, { size: 18 }),
  },
  {
    title: "Self-paced does not mean unsupported",
    body: "Use 1:1 to turn the recorded material into help that fits your pace, questions, and project context.",
    icon: faIcon(faLayerGroup, { size: 18 }),
  },
  {
    title: "Add more if you need it",
    body: "Top up with extra 1:1 sessions when you want more review, debugging, or planning time.",
    icon: faIcon(faClock, { size: 18 }),
  },
];
---

<BaseLayout
  pageTitle="Courses — Sourcier"
  description="Launching soon: self-paced web development courses built for the age of AI, with stronger fundamentals, included 1:1 support, and the option to start with one course or take the full bundle."
>
  <PageHero
    kicker="Courses"
    title="Choose the full bundle or start with one course"
    tone="secondary"
    subtitle="Launching soon: these are the structured learning paths. If you want free, article-led orientation, start with the guides. If you want a connected path through web foundations, frontend, backend, and DevOps with included 1:1 support, start here. Start with one course to keep the cost of entry smaller, or take the full bundle for end-to-end context."
  />

  <section
    class="section courses-bundle flow-section"
    aria-labelledby="courses-bundle-section-heading"
  >
    <div class="container" data-width="narrow">
      <div class="subheading">
        <p class="section-label section-label--secondary">Choose your path</p>
        <h2 class="heading" id="courses-bundle-section-heading">
          Pick the structured path that matches what you need next
        </h2>
      </div>

      <div class="surface" data-course-tabs>
        <div class="preface">
          <p class="section-label section-label--secondary">
            Why this offer works
          </p>
          <p class="text">
            AI makes it easier to generate code, but not to judge tradeoffs,
            debug bad assumptions, or connect the stack end to end. These
            courses are built to strengthen the fundamentals and decision-making
            that still matter.
          </p>
          <p class="text">
            If you want free, article-led orientation, start with the <a
              href="/guides">guides</a
            >. Choose a course when you want a more structured path through the
            material, with 1:1 support included and the option to build from one
            course to the full bundle.
          </p>
        </div>

        <div class="tabs" role="tablist" aria-label="Course purchase options">
          <button
            type="button"
            id="courses-bundle-tab"
            class="tab"
            role="tab"
            aria-selected="true"
            aria-controls="courses-bundle-panel"
            tabindex="0"
            data-course-tab="bundle"
          >
            Full bundle
          </button>
          <button
            type="button"
            id="course-catalogue-tab"
            class="tab"
            role="tab"
            aria-selected="false"
            aria-controls="course-catalogue"
            tabindex="-1"
            data-course-tab="catalogue"
          >
            Course catalogue
          </button>
        </div>

        <div
          class="pane"
          id="courses-bundle-panel"
          role="tabpanel"
          aria-labelledby="courses-bundle-tab"
          tabindex="0"
          data-course-panel="bundle"
        >
          <div class="panels">
            <div class="intro">
              <p class="kicker">Full bundle</p>
              <div class="chips" aria-label="Bundle details">
                <span class="chip" data-tone="status">
                  {courseLaunchLabel}
                </span>
                <span class="chip">4 courses</span>
                <span class="chip">Self-paced</span>
                <span class="chip">{courseSupportOffer.bundleShort}</span>
              </div>
              <h3 class="bundle" id="courses-bundle-heading">
                {courseBundle.title}
              </h3>
              <p class="body">{courseBundle.summary}</p>
              <ul class="benefits" role="list">
                {courseBundle.benefits.map((benefit) => <li>{benefit}</li>)}
              </ul>
              <div class="cta">
                <a
                  href="/contact?reason=course-enquiry#contact-form"
                  class="button"
                  data-variant="ink"
                  data-size="large"
                >
                  Ask about the full bundle
                </a>
                <a
                  href="#course-catalogue"
                  class="anchor"
                  data-course-switch="catalogue"
                >
                  Open the course catalogue
                </a>
              </div>
            </div>

            <div class="aside panel" data-tone="secondary">
              <p class="caption">Good fit for</p>
              <ul class="audience" role="list">
                {courseBundle.audience.map((item) => <li>{item}</li>)}
              </ul>
              <div class="support">
                <p class="eyebrow">Included support</p>
                <p class="detail">
                  {courseSupportOffer.singleDetail}
                </p>
                <p class="detail">
                  {courseSupportOffer.bundleDetail}
                </p>
                <p class="detail">
                  {courseSupportOffer.additionalSessionsDetail}
                </p>
              </div>
            </div>

            <div class="courses">
              {
                courseOffers.map((course) => (
                  <a
                    class="card"
                    href={`#course-${course.slug}`}
                    aria-label={`Show ${course.title} in the course catalogue`}
                    data-course-switch="catalogue"
                  >
                    <div class="header">
                      <span
                        class="icon"
                        aria-hidden="true"
                        set:html={getCourseIcon(course.slug, 18)}
                      />
                      <div class="group">
                        <p class="focus">{course.focus}</p>
                        <h4 class="name">{course.title}</h4>
                      </div>
                    </div>
                    <p class="copy">{course.teaser}</p>
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <div
          class="pane"
          id="course-catalogue"
          role="tabpanel"
          aria-labelledby="course-catalogue-tab"
          tabindex="0"
          data-course-panel="catalogue"
          hidden
          data-kind="catalogue"
        >
          <div class="overview">
            <p class="section-label section-label--secondary">
              Course catalogue
            </p>
            <h3 class="heading" id="course-catalogue-heading">
              Four focused courses you can take on their own or as one connected
              bundle
            </h3>
            <p class="description">
              Choose the one that matches the gap you need to close now, or use
              the bundle if you want the whole stack to connect from foundations
              to delivery.
            </p>
          </div>
          <div class="offerings">
            {
              courseOffers.map((course) => (
                <article class="course-card" id={`course-${course.slug}`}>
                  <div class="top">
                    <div class="header">
                      <span
                        class="icon"
                        aria-hidden="true"
                        set:html={getCourseIcon(course.slug, 20)}
                      />
                      <div class="group">
                        <p class="eyebrow">{course.focus}</p>
                        <h3 class="heading">{course.title}</h3>
                      </div>
                    </div>
                    <p class="status">{courseLaunchLabel}</p>
                  </div>
                  <p class="summary">{course.summary}</p>

                  <div class="details">
                    <div class="detail">
                      <p class="caption">Topics</p>
                      <ul class="list" role="list">
                        {course.topics.map((topic) => (
                          <li>{topic}</li>
                        ))}
                      </ul>
                    </div>

                    <div class="detail">
                      <p class="caption">You will leave with</p>
                      <ul class="list" role="list">
                        {course.outcomes.map((outcome) => (
                          <li>{outcome}</li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <a
                    href="/contact?reason=course-enquiry#contact-form"
                    class="cta"
                  >
                    Ask about this course
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="section courses-model flow-section flow-section--loose"
    aria-labelledby="courses-model-heading"
  >
    <div class="container" data-width="narrow">
      <p class="section-label section-label--secondary">Why this format</p>
      <h2 class="heading" id="courses-model-heading">
        Why this setup fits how people actually learn now
      </h2>
      <div class="grid">
        {
          learningModel.map((item) => (
            <article class="card">
              <div class="header">
                <span class="icon" aria-hidden="true" set:html={item.icon} />
                <h3 class="name">{item.title}</h3>
              </div>
              <p class="body">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="section course-support flow-section"
    aria-labelledby="course-support-heading"
  >
    <div class="container" data-width="narrow">
      <p class="section-label section-label--secondary">1:1 support</p>
      <h2 class="heading" id="course-support-heading">
        1:1 that feels usable, not token
      </h2>
      <article class="surface panel" data-tone="secondary" data-layout="solo">
        <p class="kicker">Included support</p>
        <p class="body">
          Having taught at boot camps, I know one of the hardest things is
          giving each student the attention they need at the exact moment they
          are stuck. The recorded material and notes here make self-paced study
          possible, and the included 1:1 support is there to restore that
          missing attention without forcing everyone through the same timetable.
        </p>
        <div class="grid" role="list">
          {
            supportInclusions.map((item) => (
              <div class="card" role="listitem">
                <div class="header">
                  <span class="icon" aria-hidden="true" set:html={item.icon} />
                  <p class="name">{item.title}</p>
                </div>
                <p class="description">{item.body}</p>
              </div>
            ))
          }
        </div>
        <ul class="list" role="list">
          {supportMoments.map((item) => <li>{item}</li>)}
        </ul>
        <a href="/contact?reason=course-enquiry#contact-form" class="anchor">
          Ask about the included support pack
        </a>
      </article>
    </div>
  </section>

  <section
    class="section course-interest flow-section flow-section--loose"
    aria-labelledby="course-interest-heading"
  >
    <div class="container" data-width="narrow">
      <div class="surface panel" data-tone="secondary">
        <div class="copy">
          <p class="kicker">Next step</p>
          <h2 class="heading" id="course-interest-heading">
            If this feels like the right fit, join the launch list or ask about
            enrolment
          </h2>
          <p class="body">
            If you want this mix of self-paced material and targeted 1:1
            support, leave your email for launch updates, pricing, and earliest
            enrolment details, or send a message directly.
          </p>
          <div class="cta">
            <a
              href="/contact?reason=course-enquiry#contact-form"
              class="button"
              data-variant="ink"
              data-size="large"
            >
              Send a message
            </a>
          </div>
        </div>
        <div class="slot">
          <CourseInterestForm
            idPrefix="courses-interest"
            source="courses-page"
            buttonLabel="Join the launch list"
            fineprint="Launch updates, first access, and earliest enrolment details only."
            successMessage="You're on the launch list. I'll email you when founding enrolment opens."
            ariaLabel="Register interest for courses from the courses page"
            stackFields
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const courseTabGroups = document.querySelectorAll("[data-course-tabs]");

  const getCourseTabFromHash = () => {
    const hash = window.location.hash.slice(1);

    if (hash === "course-catalogue" || hash.startsWith("course-")) {
      return "catalogue";
    }

    return null;
  };

  courseTabGroups.forEach((group) => {
    const tabs = Array.from(group.querySelectorAll("[role='tab']"));
    const panels = Array.from(group.querySelectorAll("[role='tabpanel']"));
    const switches = Array.from(group.querySelectorAll("[data-course-switch]"));

    const activateTab = (tabName, { focus = false } = {}) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.courseTab === tabName;

        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) {
          tab.focus();
        }
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.coursePanel !== tabName;
      });
    };

    const activateTabByIndex = (index) => {
      const targetTab = tabs[(index + tabs.length) % tabs.length];

      if (!targetTab?.dataset.courseTab) {
        return;
      }

      activateTab(targetTab.dataset.courseTab, { focus: true });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        if (tab.dataset.courseTab) {
          activateTab(tab.dataset.courseTab);
        }
      });

      tab.addEventListener("keydown", (event) => {
        switch (event.key) {
          case "ArrowRight":
          case "ArrowDown":
            event.preventDefault();
            activateTabByIndex(index + 1);
            break;
          case "ArrowLeft":
          case "ArrowUp":
            event.preventDefault();
            activateTabByIndex(index - 1);
            break;
          case "Home":
            event.preventDefault();
            activateTabByIndex(0);
            break;
          case "End":
            event.preventDefault();
            activateTabByIndex(tabs.length - 1);
            break;
        }
      });
    });

    switches.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const targetTab = trigger.getAttribute("data-course-switch");

        if (targetTab) {
          activateTab(targetTab);
        }
      });
    });

    const initialTab =
      getCourseTabFromHash() ??
      tabs.find((tab) => tab.getAttribute("aria-selected") === "true")?.dataset
        .courseTab ??
      tabs[0]?.dataset.courseTab;

    if (initialTab) {
      activateTab(initialTab);
    }

    if (window.location.hash && getCourseTabFromHash()) {
      const target = document.getElementById(window.location.hash.slice(1));

      if (target) {
        requestAnimationFrame(() => {
          target.scrollIntoView({ block: "start" });
        });
      }
    }

    window.addEventListener("hashchange", () => {
      const hashTab = getCourseTabFromHash();

      if (hashTab) {
        activateTab(hashTab);
      }
    });
  });
</script>

<style>
  .courses-model,
  .courses-bundle,
  .course-support,
  .course-interest {
    padding-top: 0;
    padding-bottom: 0;
  }

  .course-interest {
    padding-bottom: var(--space-section-tight);
    margin-bottom: var(--space-section-tight);
  }

  :where(.courses-bundle) .heading,
  :where(.courses-model) .heading,
  :where(.course-support) .heading,
  :where([data-kind="catalogue"]) .heading {
    margin: 0 0 1.5rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    line-height: 1.06;
    color: var(--text-primary);
  }

  :where(.courses-model) .grid,
  :where(.courses-bundle) .panels,
  :where(.courses-bundle) .courses,
  :where([data-kind="catalogue"]) .offerings {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    :where(.courses-model) .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    :where(.courses-bundle) .courses,
    :where([data-kind="catalogue"]) .offerings {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  :where(.courses-model) .card {
    position: relative;
    overflow: hidden;
    padding: 1.45rem 1.3rem;
    border: 1px solid
      color-mix(in srgb, var(--accent-secondary) 14%, var(--border-subtle));
    border-radius: var(--radius-panel);
    background:
      radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--accent-secondary) 12%, transparent) 0%,
        transparent 42%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--surface-elevated) 94%, white) 0%,
        var(--surface-elevated) 100%
      ),
      var(--surface-elevated);
    box-shadow: 0 14px 30px rgba(var(--shadow-rgb), 0.05);

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 1.3rem;
      width: 3.5rem;
      height: 2px;
      background: linear-gradient(
        90deg,
        var(--accent-secondary) 0%,
        transparent 100%
      );
      pointer-events: none;
    }
  }

  :where(.courses-model) .name,
  :where(.courses-bundle) .bundle,
  :where(.course-card) .heading,
  :where(.course-interest) .heading {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    line-height: 1.05;
    color: var(--text-primary);
  }

  :where(.courses-model) .name {
    font-size: 1.15rem;
  }

  :where(.courses-model) .header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  :where(.courses-model) .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: var(--radius-pill);
    background: color-mix(
      in srgb,
      var(--surface-page) 82%,
      var(--accent-secondary) 18%
    );
    color: var(--accent-secondary);
    flex-shrink: 0;

    :global(svg) {
      display: block;
    }
  }

  :where(.courses-model) .body,
  :where(.courses-bundle) .text,
  :where(.courses-bundle) .description,
  :where(.courses-bundle) .body,
  :where(.course-card) .summary,
  :where(.course-support) .body,
  :where(.course-interest) .body {
    margin: 0.7rem 0 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  :where(.courses-bundle) .surface {
    padding: clamp(1.45rem, 3vw, 2.25rem);
    border: 1px solid
      color-mix(in srgb, var(--accent-primary) 14%, var(--border-subtle));
    border-radius: var(--radius-panel-large);
    background:
      radial-gradient(
        ellipse 62% 74% at 0% 0%,
        color-mix(in srgb, var(--accent-primary) 10%, transparent) 0%,
        transparent 72%
      ),
      radial-gradient(
        ellipse 54% 62% at 100% 0%,
        color-mix(in srgb, var(--accent-secondary) 12%, transparent) 0%,
        transparent 74%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--surface-elevated) 96%, white) 0%,
        var(--surface-elevated) 100%
      ),
      var(--surface-elevated);
    box-shadow: 0 22px 48px rgba(var(--shadow-rgb), 0.08);
  }

  :where(.courses-bundle) .subheading {
    max-width: 38rem;
  }

  :where(.courses-bundle) .preface {
    max-width: 45rem;
  }

  :where(.courses-bundle) .text {
    max-width: 38rem;
  }

  :where(.courses-bundle) .tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 1.25rem;
    padding: 0.4rem;
    border: 1px solid color-mix(in srgb, var(--accent-primary) 12%, transparent);
    border-radius: calc(var(--radius-soft) + 0.25rem);
    background: color-mix(
      in srgb,
      var(--surface-page) 86%,
      var(--accent-primary) 14%
    );
  }

  :where(.courses-bundle) .tab {
    appearance: none;
    border: 0;
    border-radius: var(--radius-pill);
    min-height: 3rem;
    padding: 0.7rem 1rem;
    background: transparent;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
    transition:
      background 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;

    &:hover,
    &:focus-visible {
      color: var(--text-primary);
    }

    &:focus-visible {
      outline: 2px solid color-mix(in srgb, var(--accent-primary) 55%, white);
      outline-offset: 2px;
    }

    &[aria-selected="true"] {
      background: linear-gradient(
        135deg,
        color-mix(in srgb, var(--accent-primary) 96%, white) 0%,
        color-mix(in srgb, var(--accent-secondary) 74%, var(--accent-primary))
          100%
      );
      color: var(--text-on-strong);
      box-shadow: 0 12px 24px rgba(var(--shadow-rgb), 0.14);
    }
  }

  :where(.courses-bundle) .pane {
    margin-top: 1.25rem;
  }

  :where(.courses-bundle) .pane[hidden] {
    display: none;
  }

  :where(.courses-bundle) .panels {
    display: grid;
    gap: 1.25rem;
  }

  :where(.courses-bundle) .overview {
    max-width: 45rem;
  }

  :where(.courses-bundle) .kicker,
  :where(.course-support) .kicker,
  :where(.course-interest) .kicker,
  :where(.course-card) .eyebrow,
  :where(.courses-bundle) .focus,
  :where(.courses-bundle) .caption {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  :where(.courses-bundle) .kicker,
  :where(.course-card) .eyebrow,
  :where(.courses-bundle) .focus,
  :where(.course-interest) .kicker {
    color: var(--accent-primary);
  }

  :where(.course-card) .status {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 1.9rem;
    padding: 0.28rem 0.72rem;
    border-radius: var(--radius-pill);
    background: var(--accent-secondary);
    color: var(--text-on-strong);
    box-shadow: 0 10px 24px
      color-mix(in srgb, var(--accent-secondary) 22%, transparent);
  }

  :where(.course-support) .kicker,
  :where(.courses-bundle) .caption {
    color: var(--accent-secondary);
  }

  :where(.courses-bundle) .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0.9rem 0 1rem;
  }

  :where(.courses-bundle) .chip {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--accent-primary) 18%, transparent);
    background: color-mix(
