---
import BaseLayout from "../layouts/BaseLayout.astro";
import { audienceGuides } from "../data/audienceGuides";

const corePages = [
  {
    href: "/blog",
    label: "Blog",
    description: "Start with the latest writing and browse by topic.",
  },
  {
    href: "/about",
    label: "About",
    description: "Find out who I help and the kind of work I do.",
  },
  {
    href: "/contact",
    label: "Contact",
    description: "Get in touch about mentoring, consulting, or a question.",
  },
];
---

<BaseLayout
  pageTitle="Page not found — Sourcier"
  description="The page you're looking for doesn't exist."
>
  <div class="not-found flow-section flow-section--loose">
    <div class="container" data-width="narrow">
      <section class="hero" aria-labelledby="not-found-heading">
        <div class="panel surface">
          <div class="number" aria-hidden="true">404</div>
          <div class="copy">
            <p class="eyebrow">Page not found</p>
            <h1 class="heading" id="not-found-heading">Nothing here.</h1>
            <p class="subtitle">
              That URL may have moved, been deleted, or never existed. Start
              from the homepage, jump into the latest writing, or pick the guide
              that matches where you are now.
            </p>
            <div class="cta">
              <a
                href="/"
                class="button"
                data-variant="primary"
                data-size="large">Home</a
              >
              <a
                href="/blog"
                class="button"
                data-variant="subtle"
                data-size="large"
              >
                Browse the blog
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="paths" aria-labelledby="not-found-paths-heading">
        <p class="section-label">Try these instead</p>
        <h2 class="subheading" id="not-found-paths-heading">
          Start from a guide or a core page
        </h2>
        <div class="grid">
          {
            audienceGuides.map((guide) => (
              <article class="not-found-card" data-kind="guide">
                <p class="eyebrow">Guide</p>
                <h3 class="heading">{guide.title}</h3>
                <p class="body">{guide.summary}</p>
                <a href={guide.href} class="cta">
                  Open the guide
                </a>
              </article>
            ))
          }
          {
            corePages.map((page) => (
              <article class="not-found-card">
                <p class="eyebrow">Page</p>
                <h3 class="heading">{page.label}</h3>
                <p class="body">{page.description}</p>
                <a href={page.href} class="cta">
                  Open {page.label}
                </a>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding: clamp(3.5rem, 7vw, 4.5rem) 1.5rem var(--space-section-loose);
  }

  :where(.not-found) .surface {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 3rem;
    background:
      radial-gradient(
        circle at top right,
        color-mix(in srgb, var(--accent-secondary) 14%, transparent) 0%,
        transparent 34%
      ),
      linear-gradient(
        150deg,
        color-mix(in srgb, var(--accent-primary) 4%, var(--surface-elevated)) 0%,
        var(--surface-elevated) 62%
      ),
      var(--surface-elevated);

    @media (min-width: 768px) {
      grid-template-columns: minmax(9rem, 0.6fr) minmax(0, 1.4fr);
      gap: 2rem;
    }
  }

  :where(.not-found) .number {
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(6rem, 18vw, 12rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: transparent;
    /* The outlined numeral needs text-stroke, which has no standard equivalent. */
    -webkit-text-stroke: 2px var(--accent-primary);
    user-select: none;
    position: relative;

    &::after {
      content: "404";
      position: absolute;
      inset: 0;
      color: rgba(var(--accent-primary-rgb), 0.07);
      /* Avoid inheriting the outline on the filled shadow numeral. */
      -webkit-text-stroke: 0;
      transform: translate(6px, 6px);
      z-index: -1;
    }
  }

  :where(.not-found) .eyebrow {
    margin: 0 0 0.65rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-secondary);
  }

  :where(.not-found) .heading {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  :where(.not-found) .subtitle {
    margin: 0.95rem 0 0;
    max-width: 58ch;
    line-height: 1.75;
    color: var(--text-muted);
  }

  :where(.not-found) .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.4rem;
  }

  :where(.not-found) .subheading {
    margin: 0 0 1.5rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.02;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  :where(.not-found) .grid {
    display: grid;
    gap: 1rem;

    @media (min-width: 768px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .not-found-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-height: 100%;
    padding: 1.4rem;
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--accent-primary);
    border-radius: var(--radius-panel);
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--accent-primary) 4%, var(--surface-elevated)) 0%,
        var(--surface-elevated) 62%
      ),
      var(--surface-elevated);
    box-shadow: var(--shadow-panel);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;

    &:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-lift);
    }
  }

  [data-kind="guide"] {
    border-top-color: var(--accent-secondary);
    background:
      radial-gradient(
        circle at top right,
        color-mix(in srgb, var(--accent-secondary) 12%, transparent) 0%,
        transparent 34%
      ),
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--accent-primary) 3%, var(--surface-elevated)) 0%,
        var(--surface-elevated) 62%
      ),
      var(--surface-elevated);
  }

  :where(.not-found-card) .eyebrow {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  [data-kind="guide"] .eyebrow {
    color: var(--accent-secondary);
  }

  :where(.not-found-card) .heading {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.15rem;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  :where(.not-found-card) .body {
    margin: 0;
    line-height: 1.65;
    color: var(--text-muted);
  }

  :where(.not-found-card) .cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    padding-block: 0.75rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-primary);
    text-decoration: none;
  }

  [data-kind="guide"] .cta {
    color: var(--accent-secondary);
  }
</style>
