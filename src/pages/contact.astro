---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import MailingListCTA from "../components/MailingListCTA.astro";
import {
  faBriefcase,
  faArrowTrendUp,
  faUserGraduate,
  faSquareCaretDown,
} from "@fortawesome/free-solid-svg-icons";
import { faLinkedin, faGithub } from "@fortawesome/free-brands-svg-icons";
import { faIcon } from "../utils/icons";

const projectsIcon = faIcon(faBriefcase, { size: 24 });
const growthIcon = faIcon(faArrowTrendUp, { size: 24 });
const mentoringIcon = faIcon(faUserGraduate, { size: 24 });
const linkedinIcon = faIcon(faLinkedin, { size: 20 });
const githubIcon = faIcon(faGithub, { size: 20 });
const [caretWidth, caretHeight, , , caretPathData] = faSquareCaretDown.icon;
const caretPaths = Array.isArray(caretPathData)
  ? caretPathData
  : [caretPathData];
const selectCaretSvg = [
  `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${caretWidth} ${caretHeight}'>`,
  ...caretPaths.map((d) => `<path fill='black' d='${d}'/>`),
  `</svg>`,
].join("");
const selectCaretIcon = `url("data:image/svg+xml,${encodeURIComponent(selectCaretSvg)}")`;
const pageTitle = "Contact — Sourcier";
---

<BaseLayout
  pageTitle={pageTitle}
  description="Get in touch about courses, the day I set aside each month for charity or community work, career-transition support, engineering growth, or help improving how your team builds software."
>
  <PageHero
    kicker="Get in touch"
    title="Get support"
    tone="secondary"
    subtitle="Courses, the day I set aside each month for charity or community work, career-transition mentoring, engineering growth, and practical help for teams improving how they build software."
  />

  <!-- Contact reasons -->
  <div class="contact-reasons flow-section flow-section--loose">
    <div class="layout-container layout-container-narrow">
      <ul class="contact-reasons__list" role="list">
        <li class="contact-reasons__item" id="team-guidance">
          <span class="contact-reasons__icon-wrap">
            <span class="contact-reasons__icon" set:html={projectsIcon} />
          </span>
          <div>
            <p class="contact-reasons__title">Engineering practice</p>
            <p class="contact-reasons__desc">
              Help for teams that want better delivery, maintainability, and
              engineering habits.
            </p>
          </div>
        </li>
        <li class="contact-reasons__item">
          <span class="contact-reasons__icon-wrap">
            <span class="contact-reasons__icon" set:html={growthIcon} />
          </span>
          <div>
            <p class="contact-reasons__title">Career growth</p>
            <p class="contact-reasons__desc">
              Support for engineers who want to grow their confidence, judgment,
              and impact.
            </p>
          </div>
        </li>
        <li class="contact-reasons__item">
          <span class="contact-reasons__icon-wrap">
            <span class="contact-reasons__icon" set:html={mentoringIcon} />
          </span>
          <div>
            <p class="contact-reasons__title">Transition into tech</p>
            <p class="contact-reasons__desc">
              Guidance for people changing careers and trying to build the
              skills, context, and confidence to get started.
            </p>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <section class="section flow-section flow-section--tight">
    <div class="layout-container layout-container-narrow">
      <div class="contact-layout">
        <div class="contact-form-col">
          <div class="contact-form__panel page-panel page-panel--secondary">
            <p class="contact-form__intro">
              If you want to ask about the courses, are changing careers, trying
              to level up as an engineer, need help improving how your team
              builds software, or you work with a charity or community
              organisation that could use the day I set aside each month, send a
              note and I will get back to you as soon as I can.
            </p>

            <form
              id="contact-form"
              class="contact-form"
              name="contact"
              method="post"
              data-netlify="true"
              netlify-honeypot="bot-field"
            >
              <div class="contact-form__row">
                <div class="contact-form__field">
                  <label class="contact-form__label" for="contact-name"
                    >Name</label
                  >
                  <input
                    class="contact-form__input"
                    id="contact-name"
                    type="text"
                    placeholder="Your name"
                    name="name"
                    required
                  />
                </div>
                <div class="contact-form__field">
                  <label class="contact-form__label" for="contact-email"
                    >Email</label
                  >
                  <input
                    class="contact-form__input"
                    id="contact-email"
                    type="email"
                    placeholder="your@email.com"
                    name="email"
                    required
                  />
                </div>
              </div>

              <div class="contact-form__field">
                <label class="contact-form__label" for="contact-reason"
                  >Reason</label
                >
                <select
                  class="contact-form__input"
                  id="contact-reason"
                  name="reason"
                  style={`--contact-select-caret-icon: ${selectCaretIcon}`}
                  required
                >
                  <option value="" disabled selected>Select a reason…</option>
                  <option value="course-enquiry"
                    >Course questions or enrolment</option
                  >
                  <option value="career-transition">Transition into tech</option
                  >
                  <option value="career-growth">Career growth</option>
                  <option value="engineering-practice"
                    >Engineering practice</option
                  >
                  <option value="charity-support"
                    >Charity or community work</option
                  >
                  <option value="project">Project</option>
                  <option value="speaking">Speaking</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div
                class="contact-form__field is-hidden"
                id="other-reason-field"
              >
                <label class="contact-form__label" for="contact-other-reason"
                  >Please specify</label
                >
                <input
                  class="contact-form__input"
                  id="contact-other-reason"
                  type="text"
                  placeholder="Please specify your reason…"
                  name="other-reason"
                />
              </div>

              <div class="contact-form__field">
                <label class="contact-form__label" for="contact-message"
                  >Message</label
                >
                <textarea
                  class="contact-form__textarea"
                  id="contact-message"
                  placeholder="Tell me about your situation, your goals, or the team challenge you want to solve…"
                  name="message"
                  rows="6"
                  required></textarea>
              </div>

              <div class="field is-hidden" aria-hidden="true">
                <input name="bot-field" type="text" />
              </div>

              <button class="contact-form__submit" type="submit"
                >Send Message &rarr;</button
              >
            </form>

            <div class="contact-success is-hidden" data-success-message>
              <p class="contact-success__text">
                &#10003; Message sent — I'll get back to you soon.
              </p>
              <button class="contact-success__close" type="button"
                >Dismiss</button
              >
            </div>
          </div>
        </div>

        <aside class="contact-sidebar">
          <div class="contact-sidebar__panel page-panel">
            <h2 class="contact-sidebar__heading">Find me online</h2>
            <div class="contact-sidebar__links">
              <a
                class="contact-sidebar__link"
                href="https://www.linkedin.com/in/roger-rajaratnam"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="contact-sidebar__link-label">
                  <span
                    class="contact-sidebar__link-icon"
                    set:html={linkedinIcon}
                  />
                  LinkedIn
                </span>
                <span class="contact-sidebar__link-desc"
                  >Mentoring, growth, and engineering leadership</span
                >
              </a>

              <a
                class="contact-sidebar__link"
                href="https://github.com/sourcier"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="contact-sidebar__link-label">
                  <span
                    class="contact-sidebar__link-icon"
                    set:html={githubIcon}
                  />
                  GitHub
                </span>
                <span class="contact-sidebar__link-desc"
                  >Blog code, tooling, and experiments</span
                >
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <MailingListCTA />
</BaseLayout>

<style>
  :global(.page-hero) {
    min-height: clamp(220px, 28vw, 290px);
    padding-bottom: clamp(1.9rem, 4vw, 2.5rem);
  }

  /* ── Contact reasons bar ───────────────────────────────────── */
  .contact-reasons {
    padding: 0 1.5rem;
    margin-top: clamp(-1.8rem, -2.4vw, -1.1rem);
    position: relative;
    z-index: 1;
  }

  .contact-reasons__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;

    @media (min-width: 640px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .contact-reasons__item {
    --contact-reason-accent: var(--accent-secondary);
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1.5rem 1.25rem;
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--contact-reason-accent);
    border-radius: var(--radius-panel);
    background:
      radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--contact-reason-accent) 10%, transparent) 0%,
        transparent 40%
      ),
      linear-gradient(
        155deg,
        color-mix(
            in srgb,
            var(--contact-reason-accent) 7%,
            var(--surface-elevated)
          )
          0%,
        var(--surface-elevated) 58%
      ),
      var(--surface-elevated);
    box-shadow: var(--shadow-panel-soft);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;

    &:nth-child(2) {
      --contact-reason-accent: var(--accent-primary);
    }

    &:nth-child(3) {
      --contact-reason-accent: color-mix(
        in srgb,
        var(--accent-secondary) 70%,
        var(--accent-primary)
      );
    }

    &:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-lift);
      border-color: color-mix(
        in srgb,
        var(--contact-reason-accent) 20%,
        var(--border-subtle)
      );
    }
  }

  .contact-reasons__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: color-mix(
      in srgb,
      var(--contact-reason-accent) 10%,
      var(--surface-elevated)
    );
    transition:
      background-color 0.18s ease,
      transform 0.18s ease;

    .contact-reasons__item:hover & {
      background-color: color-mix(
        in srgb,
        var(--contact-reason-accent) 16%,
        var(--surface-elevated)
      );
      transform: translateY(-2px);
    }
  }

  .contact-reasons__icon {
    color: var(--contact-reason-accent);
    line-height: 1;
    display: flex;
  }

  .contact-reasons__title {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: none;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .contact-reasons__desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── Form intro ────────────────────────────────────────────── */
  .contact-form__intro {
    margin: 0;
    max-width: 60ch;
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .contact-form__panel {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    background:
      radial-gradient(
        ellipse 100% 100% at 100% 0%,
        color-mix(in srgb, var(--accent-secondary) 12%, transparent) 0%,
        transparent 56%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--accent-secondary) 4%, var(--surface-elevated))
          0%,
        var(--surface-elevated) 100%
      ),
      var(--surface-elevated);
  }

  /* ── Select styling ────────────────────────────────────────── */
  select.contact-form__input {
    appearance: none;
    background-color: var(--surface-elevated);
    background-image: var(--contact-select-caret-icon);
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 0.75rem 0.75rem;
    padding-right: 2.75rem;
    cursor: pointer;

    &.is-placeholder {
      color: var(--text-muted);
    }

    option {
      color: var(--text-primary);
      background-color: var(--surface-elevated);
    }
  }

  .contact-sidebar {
    padding-top: 0;

    @media (min-width: 768px) {
      padding-top: 0;
      position: sticky;
      top: 5rem;
      align-self: start;
    }
  }

  .contact-sidebar__panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-sidebar__heading {
    margin-bottom: 0.25rem;
  }

  .contact-sidebar__links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-sidebar__link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-soft);
    background: color-mix(in srgb, var(--text-primary) 2.5%, transparent);
    transition:
      padding-left 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;

    &:hover {
      padding-left: 1.2rem;
      border-color: color-mix(
        in srgb,
        var(--accent-secondary) 16%,
        var(--border-subtle)
      );
      background: color-mix(in srgb, var(--accent-secondary) 5%, transparent);

      .contact-sidebar__link-label {
        color: var(--accent-secondary);
      }

      .contact-sidebar__link-icon {
        color: var(--accent-secondary);
      }
    }
  }
</style>

<script>
  const handleSubmit = (event: Event) => {
    event.preventDefault();

    const form = event.target as HTMLFormElement;
    const formData = new FormData(form);

    fetch("/", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams(
        formData as unknown as Record<string, string>,
      ).toString(),
    })
      .then(() => {
        form.reset();
        form.style.display = "none";
        const successEl = document.querySelector(
          "[data-success-message]",
        ) as HTMLElement | null;
        successEl?.classList.remove("is-hidden");
        successEl?.setAttribute("tabindex", "-1");
        successEl?.focus();
      })
      .catch((error) => alert(error));
  };

  const handleSuccessMessageClose = () => {
    const form = document.querySelector(
      "form[name='contact']",
    ) as HTMLFormElement;
    const successMessage = document.querySelector(
      "[data-success-message]",
    ) as HTMLElement;

    form.style.display = "";
    successMessage.classList.add("is-hidden");
  };

  document
    .querySelector("form[name='contact']")
    ?.addEventListener("submit", handleSubmit);

  const reasonSelect = document.querySelector(
    "#contact-reason",
  ) as HTMLSelectElement | null;
  const otherReasonField = document.querySelector(
    "#other-reason-field",
  ) as HTMLElement | null;
  const otherReasonInput = document.querySelector(
    "#contact-other-reason",
  ) as HTMLInputElement | null;

  const syncReasonState = () => {
    if (!reasonSelect) {
      return;
    }

    const isOther = reasonSelect.value === "other";
    otherReasonField?.classList.toggle("is-hidden", !isOther);
    if (otherReasonInput) {
      otherReasonInput.required = isOther;
    }
    reasonSelect.classList.toggle("is-placeholder", reasonSelect.value === "");
  };

  reasonSelect?.addEventListener("change", syncReasonState);

  // Set initial placeholder state
  if (reasonSelect) {
    const requestedReason = new URLSearchParams(window.location.search).get(
      "reason",
    );
    const hasMatchingOption =
      requestedReason &&
      Array.from(reasonSelect.options).some(
        (option) => option.value === requestedReason,
      );

    if (hasMatchingOption) {
      reasonSelect.value = requestedReason;
    }

    syncReasonState();
  }

  document
    .querySelector("[data-success-message] .contact-success__close")
    ?.addEventListener("click", handleSuccessMessageClose);
</script>
