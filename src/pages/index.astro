---
import { getCollection } from "astro:content";
import { isPublished } from "../utils/drafts";
import readingTime from "reading-time";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
import MailingListCTA from "../components/MailingListCTA.astro";
import Testimonials from "../components/Testimonials.astro";
import CourseLaunchSection from "../components/CourseLaunchSection.astro";
import { audienceGuides } from "../data/audienceGuides";
import GuideCard from "../components/GuideCard.astro";
import BlogCardPlaceholder from "../components/BlogCardPlaceholder.astro";
import {
  faBriefcase,
  faCloud,
  faRectangleList,
} from "@fortawesome/free-solid-svg-icons";
import { faIcon } from "../utils/icons";

const allPosts = (await getCollection("posts"))
  .filter(isPublished)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const GRID_SIZE = 6;
const placeholderCount = Math.max(0, GRID_SIZE - allPosts.length);

const communityOfferItems = [
  {
    label: "Website, form, and accessibility improvements",
    icon: faIcon(faCloud, { size: 16 }),
  },
  {
    label: "Small workflow fixes or lightweight automation",
    icon: faIcon(faRectangleList, { size: 16 }),
  },
  {
    label: "Advice on scope, priorities, and next steps",
    icon: faIcon(faBriefcase, { size: 16 }),
  },
];
---

<BaseLayout
  pageTitle="Sourcier — Practical software engineering guidance"
  description="Practical software engineering guidance for people transitioning into tech, engineers growing in confidence, and teams improving how they build software."
>
  <section class="hero-intro">
    <div class="layout-container">
      <div class="hero-intro__layout">
        <div class="hero-intro__content">
          <span class="hero-kicker"
            >Sourcier &middot; Mentoring, career growth, and better software
            delivery</span
          >
          <h1 class="hero-title">Practical software engineering guidance</h1>
          <p class="hero-bio">
            I help people transition into tech, engineers grow with confidence,
            and teams improve how they build software. Writing about
            <span class="hero-cycle" aria-live="polite" aria-atomic="true"
              ><span class="hero-cycle__term" id="heroCycleTerm"
                >Breaking into Tech</span
              ></span
            >
          </p>
          <div class="action-group">
            <a
              href="/guides"
              class="action-button"
              data-variant="primary"
              data-size="large">Choose a guide</a
            >
            <a
              href="/contact"
              class="action-button"
              data-variant="subtle"
              data-size="large">Get guidance</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="content-section audience-paths flow-section flow-section--loose"
    id="audience-paths"
    aria-labelledby="audience-paths-heading"
  >
    <div class="layout-container layout-container-narrow">
      <p class="section-label section-label--secondary">Who this site is for</p>
      <h2 class="audience-paths__heading" id="audience-paths-heading">
        Choose the guide that matches where you are now
      </h2>
      <div class="audience-paths__grid">
        {
          audienceGuides.map((guide) => (
            <GuideCard
              slug={guide.slug}
              title={guide.title}
              summary={guide.summary}
              href={guide.href}
              publishedCount={guide.currentPostIds.length}
              plannedCount={guide.plannedArticles.length}
              variant="secondary"
              hideMeta
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="content-section flow-section" aria-label="Recent Posts">
    <div class="layout-container layout-container-narrow">
      <p class="section-label section-label--secondary">Latest writing</p>
      <div class="home-post-grid">
        {
          allPosts.map((post) => (
            <BlogPost
              title={post.data.title}
              subTitle={post.data.subTitle}
              description={post.data.description}
              url={`/blog/${post.id}`}
              cover={post.data.cover}
              pubDate={post.data.pubDate}
              draft={post.data.draft}
              readingTime={readingTime(post.body ?? "").text}
            />
          ))
        }
        {
          Array.from({ length: placeholderCount }).map(() => (
            <BlogCardPlaceholder />
          ))
        }
      </div>
    </div>
  </section>

  <CourseLaunchSection />

  <section
    class="content-section community-offer flow-section"
    aria-labelledby="community-offer-heading"
  >
    <div class="layout-container layout-container-narrow">
      <div class="community-offer__grid">
        <div class="community-offer__main page-panel page-panel--secondary">
          <div class="community-offer__intro">
            <p class="section-label section-label--secondary">Community</p>
            <div class="community-offer__chips" aria-label="Offer details">
              <span class="community-offer__chip">1 day/month</span>
              <span class="community-offer__chip">Free</span>
              <span class="community-offer__chip">Clearly scoped</span>
            </div>
            <h2 class="community-offer__heading" id="community-offer-heading">
              One free day each month for a charity
            </h2>
            <p class="community-offer__body">
              The charity sector is close to my heart, so I set aside one day
              each month for a charity or community organisation that could use
              practical help moving a digital problem or piece of work forward.
            </p>
          </div>
          <div class="community-offer__footer">
            <div class="community-offer__actions">
              <a
                href="/charity-support"
                class="action-button"
                data-variant="ink"
                data-size="large"
              >
                See how it works
              </a>
              <a
                href="/contact?reason=charity-support#contact-form"
                class="community-offer__link"
              >
                Ask if it is a fit
              </a>
            </div>
          </div>
        </div>

        <aside class="community-offer__aside page-panel page-panel--secondary">
          <p class="community-offer__aside-label">What a day can cover</p>
          <ul class="community-offer__list" role="list">
            {
              communityOfferItems.map((item) => (
                <li>
                  <span
                    class="community-offer__item-icon"
                    aria-hidden="true"
                    set:html={item.icon}
                  />
                  <span>{item.label}</span>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <Testimonials />
  <MailingListCTA />
</BaseLayout>

<style>
  .audience-paths {
    padding-top: 0;
    padding-bottom: 0;
  }

  .hero-intro__layout {
    display: grid;
    align-items: center;
    margin: -0.75rem;
  }

  .hero-intro__content {
    min-width: 0;
    padding: 0.75rem;
  }

  .home-post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;

    @media (min-width: 769px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .audience-paths__heading {
    margin: 0 0 1.5rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    line-height: 1.08;
    color: var(--text-primary);
  }

  .audience-paths__grid {
    display: grid;
    gap: 1rem;

    @media (min-width: 768px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .community-offer {
    padding-top: 0;
    padding-bottom: 0;
  }

  .community-offer__grid {
    display: grid;
    gap: 1rem;

    @media (min-width: 960px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .community-offer__main,
  .community-offer__aside {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .community-offer__main {
    @media (min-width: 960px) {
      grid-column: span 2;
    }
  }

  .community-offer__aside {
    justify-content: flex-start;

    @media (min-width: 960px) {
      grid-column: span 1;
      align-self: stretch;
    }
  }

  .community-offer__intro {
    display: grid;
    gap: 0.95rem;
  }

  .community-offer__heading {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    line-height: 1.05;
    color: var(--text-primary);
  }

  .community-offer__body {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .community-offer__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 34rem;
  }

  .community-offer__chip,
  .community-offer__aside-label {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .community-offer__chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    padding: 0.28rem 0.62rem;
    border-radius: var(--radius-pill);
    border: 1px solid
      color-mix(in srgb, var(--accent-secondary) 16%, transparent);
    background: color-mix(in srgb, var(--accent-secondary) 5%, transparent);
    color: var(--accent-secondary);
  }

  .community-offer__aside-label {
    margin: 0;
    color: var(--accent-secondary);
  }

  .community-offer__footer {
    display: grid;
    gap: 0.95rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid
      color-mix(in srgb, var(--border-subtle) 78%, transparent);
  }

  .community-offer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    align-items: center;

    @media (max-width: 639px) {
      align-items: stretch;

      > .action-button {
        width: 100%;
        justify-content: center;
      }
    }
  }

  .community-offer__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.55rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--accent-secondary);
    transition:
      color 0.15s ease,
      transform 0.15s ease;

    &:hover {
      color: var(--accent-primary);
      transform: translateY(-1px);
    }
  }

  .community-offer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .community-offer__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .community-offer__item-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.1rem;
    border-radius: var(--radius-pill);
    background: color-mix(
      in srgb,
      var(--surface-page) 84%,
      var(--accent-secondary) 16%
    );
    color: var(--accent-secondary);
    flex-shrink: 0;

    :global(svg) {
      display: block;
    }
  }
</style>

<script>
  const terms = [
    "Breaking into Tech",
    "Career Growth",
    "Engineering Practice",
    "Mentoring Engineers",
    "Shipping Better Software",
  ];

  const el = document.getElementById("heroCycleTerm");
  if (el && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let current = 0;

    setInterval(() => {
      current = (current + 1) % terms.length;

      el.classList.add("leaving");

      setTimeout(() => {
        el.classList.remove("leaving");
        el.classList.add("entering");
        el.textContent = terms[current];

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            el.classList.remove("entering");
          });
        });
      }, 250);
    }, 2800);
  }
</script>
