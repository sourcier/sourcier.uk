---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CareerTimeline from "../components/CareerTimeline.astro";
import MailingListCTA from "../components/MailingListCTA.astro";
import {
  faHtml5,
  faCss3Alt,
  faJs,
  faTypescript,
  faReact,
  faNodeJs,
  faGitAlt,
  faDocker,
  faAws,
  faMicrosoft,
  faPostgresql,
} from "@fortawesome/free-brands-svg-icons";
import {
  faBriefcase,
  faArrowTrendUp,
  faUserGraduate,
  faPaperPlane,
  faRectangleList,
  faHexagonNodes,
  faCloud,
} from "@fortawesome/free-solid-svg-icons";
import { faIcon } from "../utils/icons";

const frontendStack = [
  { label: "CSS / Sass", icon: faIcon(faCss3Alt, { size: 18 }) },
  { label: "HTML", icon: faIcon(faHtml5, { size: 18 }) },
  { label: "JavaScript", icon: faIcon(faJs, { size: 18 }) },
  { label: "TypeScript", icon: faIcon(faTypescript, { size: 18 }) },
];

const frameworksStack = [
  { label: "Astro", icon: faIcon(faPaperPlane, { size: 18 }) },
  { label: "React", icon: faIcon(faReact, { size: 18 }) },
];

const backendStack = [
  { label: "GraphQL", icon: faIcon(faHexagonNodes, { size: 18 }) },
  { label: "Node.js", icon: faIcon(faNodeJs, { size: 18 }) },
  { label: "PostgreSQL", icon: faIcon(faPostgresql, { size: 18 }) },
  { label: "REST APIs", icon: faIcon(faRectangleList, { size: 18 }) },
];

const toolingStack = [
  { label: "AWS", icon: faIcon(faAws, { size: 18 }) },
  { label: "Azure", icon: faIcon(faMicrosoft, { size: 18 }) },
  { label: "Docker", icon: faIcon(faDocker, { size: 18 }) },
  { label: "Git", icon: faIcon(faGitAlt, { size: 18 }) },
  { label: "Netlify", icon: faIcon(faCloud, { size: 18 }) },
];

const focusAreas = [
  {
    label: "Career switchers who need clarity",
    icon: faIcon(faUserGraduate, { size: 16 }),
  },
  {
    label: "Engineers growing into more ownership",
    icon: faIcon(faArrowTrendUp, { size: 16 }),
  },
  {
    label: "Teams raising the bar without process theatre",
    icon: faIcon(faBriefcase, { size: 16 }),
  },
];

const howIWorkIcon = faIcon(faRectangleList, { size: 14 });
const transitionIntoTechIcon = faIcon(faUserGraduate, { size: 14 });
const engineeringGrowthIcon = faIcon(faArrowTrendUp, { size: 14 });
const engineeringPracticeIcon = faIcon(faHexagonNodes, { size: 14 });

const pageTitle = "About — Roger Rajaratnam";
---

<BaseLayout
  pageTitle={pageTitle}
  description="Helping career switchers, growing engineers, and teams build better software engineering practice."
>
  <PageHero
    kicker="About"
    title="Roger Rajaratnam"
    tone="neutral"
    subtitle="Helping people move into tech, engineers grow, and teams improve how they build software"
  />

  <section
    class="about-intro flow-section flow-section--loose"
    aria-labelledby="about-intro-heading"
  >
    <div class="container" data-width="narrow">
      <div class="panel surface">
        <div class="copy">
          <p class="eyebrow">What I focus on</p>
          <h2 class="heading" id="about-intro-heading">
            Practical engineering improvement for people, teams, and products
          </h2>
          <p class="text">
            The work I keep coming back to is the work that makes engineering
            clearer: better habits, better delivery, and more confidence for the
            people doing the work.
          </p>
        </div>
        <ul class="list" role="list">
          {
            focusAreas.map(({ label, icon }) => (
              <li>
                <span class="icon" aria-hidden="true" set:html={icon} />
                <span>{label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <div class="about-stats flow-section">
    <div class="container" data-width="narrow">
      <ul class="list" role="list">
        <li class="item">
          <span class="caption">Years in software</span>
          <span class="value">20+</span>
        </li>
        <li class="item">
          <span class="caption">Current domain</span>
          <span class="value">Fintech</span>
        </li>
        <li class="item">
          <span class="caption">Teaching experience</span>
          <span class="value">Bootcamps</span>
        </li>
        <li class="item">
          <span class="caption">Career focus</span>
          <span class="value">Mentoring</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bio sections -->
  <section class="section about-bio flow-section" aria-labelledby="bio-heading">
    <div class="container" data-width="narrow">
      <div class="grid">
        <!-- Left: labelled narrative blocks -->
        <div class="main">
          <div class="block">
            <h2 class="kicker">
              <span class="icon" aria-hidden="true" set:html={howIWorkIcon} />
              <span>How I work</span>
            </h2>
            <p class="text">
              I am a software engineer based in London with more than 20 years
              of experience across product engineering, delivery, mentoring, and
              team leadership. The thread that runs through all of it is
              practical improvement: helping people and teams get better at
              building software without adding unnecessary ceremony.
            </p>
          </div>

          <div class="block" id="career-support">
            <h2 class="kicker">
              <span
                class="icon"
                aria-hidden="true"
                set:html={transitionIntoTechIcon}
              />
              <span>For people transitioning into tech</span>
            </h2>
            <p class="text">
              I teach the parts that often stay fuzzy when you are new: how the
              web stack fits together, how to think about trade-offs, how to go
              from tutorials to real projects, and how to build enough context
              to make better decisions. My bootcamp teaching experience made me
              care deeply about turning complex engineering work into something
              clear and usable.
            </p>
          </div>

          <div class="block" id="career-growth-support">
            <h2 class="kicker">
              <span
                class="icon"
                aria-hidden="true"
                set:html={engineeringGrowthIcon}
              />
              <span>For engineers growing in confidence</span>
            </h2>
            <p class="text">
              A lot of career progression comes down to better habits rather
              than flashy knowledge: debugging clearly, writing maintainable
              code, communicating trade-offs, and learning how to own outcomes.
              I enjoy helping engineers make that shift from delivering tasks to
              growing into trusted contributors.
            </p>
          </div>

          <div class="block" id="team-standards-support">
            <h2 class="kicker">
              <span
                class="icon"
                aria-hidden="true"
                set:html={engineeringPracticeIcon}
              />
              <span>For teams improving engineering practice</span>
            </h2>
            <p class="text">
              Most teams do not need more process. They need clearer
              expectations, healthier delivery habits, better testing, more
              thoughtful mentoring, and pragmatic technical direction. I work
              best where teams want to raise the bar without slowing everything
              down.
            </p>
          </div>
        </div>

        <!-- Right: sidebar cards -->
        <aside class="sidebar" aria-label="Quick facts">
          <div class="about-sidebar-card" data-tone="highlight">
            <p class="caption">Currently</p>
            <p class="heading">Staff Engineer</p>
            <p class="subtitle">NewDay · London</p>
          </div>

          <div class="about-sidebar-card">
            <p class="caption">Teaching background</p>
            <p class="heading">Full-Stack Bootcamp Instructor</p>
            <p class="subtitle">The Jump Digital School</p>
          </div>

          <div class="about-sidebar-card">
            <p class="caption">Who I help</p>
            <ul class="about-tag-list" role="list">
              <li>Career changers</li>
              <li>Engineers building confidence</li>
              <li>Engineers taking on more ownership</li>
              <li>Product teams</li>
              <li>Growing engineering teams</li>
            </ul>
          </div>

          <div class="about-sidebar-card">
            <p class="caption">Focus areas</p>
            <ul class="about-tag-list" role="list">
              <li>Mentoring and coaching</li>
              <li>Engineering practice</li>
              <li>Full-stack delivery</li>
              <li>Testing and automation</li>
              <li>Developer experience</li>
              <li>Pragmatic team leadership</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Pullquote -->
  <div class="about-pullquote stack-space" aria-hidden="false">
    <div class="container" data-width="narrow">
      <blockquote class="inner panel">
        <p>
          I write for people getting into tech, engineers figuring out their
          next level, and teams that want practical engineering practice rather
          than process theatre.
        </p>
      </blockquote>
    </div>
  </div>

  <!-- Tech stack section -->
  <section
    class="section about-stack flow-section"
    aria-labelledby="stack-heading"
  >
    <div class="container" data-width="narrow">
      <p class="section-label" id="stack-heading">Tech stack</p>
      <div class="grid">
        <div class="group">
          <h2 class="category">Frontend</h2>
          <ul class="list" role="list">
            {
              frontendStack.map(({ label, icon }) => (
                <li>
                  <span class="stack-icon" set:html={icon} />
                  {label}
                </li>
              ))
            }
          </ul>
          <h3 class="subtopic">Frameworks</h3>
          <ul class="list" role="list">
            {
              frameworksStack.map(({ label, icon }) => (
                <li>
                  <span class="stack-icon" set:html={icon} />
                  {label}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="group">
          <h2 class="category">Backend</h2>
          <ul class="list" role="list">
            {
              backendStack.map(({ label, icon }) => (
                <li>
                  <span class="stack-icon" set:html={icon} />
                  {label}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="group">
          <h2 class="category">Tooling &amp; Infrastructure</h2>
          <ul class="list" role="list">
            {
              toolingStack.map(({ label, icon }) => (
                <li>
                  <span class="stack-icon" set:html={icon} />
                  {label}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CareerTimeline />
  <MailingListCTA />
</BaseLayout>

<style>
  .about-intro {
    padding: 0 1.5rem;
  }

  :where(.about-intro) .surface {
    display: grid;
    gap: 1.5rem;
    background:
      radial-gradient(
        circle at top right,
        color-mix(in srgb, var(--accent-secondary) 14%, transparent) 0%,
        transparent 34%
      ),
      linear-gradient(
        150deg,
        color-mix(in srgb, var(--accent-primary) 4%, var(--surface-elevated)) 0%,
        var(--surface-elevated) 62%
      ),
      var(--surface-elevated);

    @media (min-width: 768px) {
      grid-template-columns: minmax(0, 1.45fr) minmax(16rem, 0.9fr);
      gap: 2rem;
      align-items: center;
    }
  }

  :where(.about-intro) .eyebrow {
    margin: 0 0 0.65rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-secondary);
  }

  :where(.about-intro) .heading {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 0.98;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  :where(.about-intro) .text {
    margin: 0.9rem 0 0;
    max-width: 58ch;
    line-height: 1.75;
    color: var(--text-muted);
  }

  :where(.about-intro) .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  :where(.about-intro) .list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 1rem;
    border: 1px solid var(--accent-secondary-alpha-16);
    border-radius: var(--radius-soft);
    background: color-mix(
      in srgb,
      var(--accent-secondary) 8%,
      var(--surface-elevated)
    );
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  :where(.about-intro) .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-pill);
    background: color-mix(
      in srgb,
      var(--surface-page) 84%,
      var(--accent-secondary) 16%
    );
    color: var(--accent-secondary);
    flex-shrink: 0;

    :global(svg) {
      display: block;
    }
  }

  /* ── Stats bar ─────────────────────────────────────────────── */
  .about-stats {
    padding: 0 1.5rem;
  }

  :where(.about-stats) .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;

    @media (min-width: 640px) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  :where(.about-stats) .item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: clamp(7.25rem, 14vw, 8.25rem);
    padding: 1.5rem 1.25rem 1.25rem;
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--accent-primary);
    border-radius: var(--radius-panel);
    background:
      linear-gradient(
        155deg,
        color-mix(in srgb, var(--accent-primary) 5%, var(--surface-elevated)) 0%,
        var(--surface-elevated) 58%
      ),
      var(--surface-elevated);
    position: relative;
    box-shadow: var(--shadow-panel);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;

    &:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-lift);
    }

    &:nth-child(even) {
      border-top-color: var(--accent-secondary);
      background:
        linear-gradient(
          155deg,
          color-mix(
              in srgb,
              var(--accent-secondary) 6%,
              var(--surface-elevated)
            )
            0%,
          var(--surface-elevated) 58%
        ),
        var(--surface-elevated);
    }
  }

  :where(.about-stats) .value {
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    line-height: 1;
  }

  :where(.about-stats) .caption {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  /* ── Bio grid ──────────────────────────────────────────────── */
  .about-bio {
    padding-top: 0;
    padding-bottom: 0;
  }

  :where(.about-bio) .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;

    @media (min-width: 768px) {
      grid-template-columns: 1fr 280px;
      gap: 4rem;
      align-items: start;
    }
  }

  :where(.about-bio) .main {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  :where(.about-bio) .block {
    padding-left: 1.25rem;
    border-left: 3px solid var(--accent-primary);
  }

  :where(.about-bio) .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    margin-bottom: 0.75rem;
  }

  :where(.about-bio) .icon {
    display: inline-flex;
    align-items: center;
    color: var(--accent-secondary);
    flex-shrink: 0;

    :global(svg) {
      display: block;
    }
  }

  :where(.about-bio) .text {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--text-primary);
    margin: 0;
  }

  /* ── Sidebar cards ─────────────────────────────────────────── */
  :where(.about-bio) .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-sidebar-card {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-panel);
    background:
      linear-gradient(
        150deg,
        color-mix(in srgb, var(--accent-primary) 4%, var(--surface-elevated)) 0%,
        var(--surface-elevated) 62%
      ),
      var(--surface-elevated);
    box-shadow: var(--shadow-panel);
    padding: 1.25rem 1.5rem;

    &:where([data-tone="highlight"]) {
      border-color: var(--accent-secondary-alpha-22);
      background:
        radial-gradient(
          circle at top right,
          var(--text-on-strong-alpha-12),
          transparent 34%
        ),
        linear-gradient(
          145deg,
          var(--accent-secondary-deep),
          var(--accent-secondary)
        );

      .caption {
        color: var(--text-on-strong-alpha-65);
      }

      .heading {
        color: var(--text-on-strong);
      }

      .subtitle {
        color: var(--text-on-strong-alpha-70);
      }
    }
  }

  :global([data-theme="dark"])
    :where(.about-sidebar-card)[data-tone="highlight"] {
    background:
      radial-gradient(
        circle at top right,
        var(--text-on-strong-alpha-08),
        transparent 34%
      ),
      linear-gradient(
        145deg,
        var(--accent-secondary-deep),
        var(--accent-secondary)
      );
  }

  :where(.about-sidebar-card) .caption {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    margin-bottom: 0.5rem;
  }

  :where(.about-sidebar-card) .heading {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  :where(.about-sidebar-card) .subtitle {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .about-tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    li {
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--text-primary);
      padding-left: 0.875rem;
      position: relative;

      &::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.45em;
        width: 5px;
        height: 5px;
        background-color: var(--accent-primary);
      }
    }
  }

  /* ── Tech stack section ────────────────────────────────────── */
  .about-stack {
    padding-top: 0;
    padding-bottom: 0;
  }

  :where(.about-stack) .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;

    @media (min-width: 640px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  :where(.about-stack) .group {
    padding: 1.75rem 1.5rem;
    background-color: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--accent-primary);
    border-radius: var(--radius-panel);
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--accent-primary) 5%, var(--surface-elevated)) 0%,
        var(--surface-elevated) 62%
      ),
      var(--surface-elevated);
    box-shadow: var(--shadow-panel);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;

    &:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-lift);
    }

    &:nth-child(2) {
      border-top-color: var(--accent-secondary);
      background:
        linear-gradient(
          160deg,
          color-mix(
              in srgb,
              var(--accent-secondary) 7%,
              var(--surface-elevated)
            )
            0%,
          var(--surface-elevated) 62%
        ),
        var(--surface-elevated);
    }
  }

  :where(.about-stack) .category {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    margin-bottom: 1.25rem;
  }

  :where(.about-stack) .subtopic {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-top: 1.5rem;
    margin-bottom: 1rem;
  }

  :where(.about-stack) .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;

    li {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--text-primary);
    }
  }

  .stack-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--accent-secondary);

    svg {
      display: block;
    }
  }

  /* ── Pullquote ─────────────────────────────────────────────── */
  .about-pullquote {
    padding: 0 1.5rem;
  }

  :where(.about-pullquote) .inner {
    margin: 0;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    position: relative;

    &::before {
      content: "\201C";
      position: absolute;
      left: 1.25rem;
      top: 0.45rem;
      font-family: "Barlow Condensed", sans-serif;
      font-size: 4rem;
      font-weight: 800;
      line-height: 1;
      color: var(--accent-primary);
    }

    p {
      font-family: "Barlow Condensed", sans-serif;
      font-size: clamp(1.4rem, 3vw, 2rem);
      font-weight: 700;
      line-height: 1.4;
      color: var(--text-primary);
      text-transform: uppercase;
      letter-spacing: 0.01em;
      margin: 0;
      padding-left: 1.75rem;
    }
  }
</style>
