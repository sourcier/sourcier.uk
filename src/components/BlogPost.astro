---
import { Image } from "astro:assets";
import { getPublicationStatus } from "../utils/drafts";
import { coverObjectPosition } from "../utils/coverFocalPoint";

const {
  description,
  title,
  subTitle,
  url,
  cover,
  pubDate,
  draft,
  readingTime,
} = Astro.props;

const publicationStatus = getPublicationStatus({ draft, pubDate });
const previewLabel =
  publicationStatus === "draft"
    ? "Draft"
    : publicationStatus === "scheduled"
      ? "Scheduled"
      : null;
const isPreview = publicationStatus !== "published";

const formattedDate = pubDate
  ? new Date(pubDate).toLocaleDateString("en-GB", {
      year: "numeric",
      month: "short",
      day: "numeric",
      timeZone: "Europe/London",
      timeZoneName: "short",
    })
  : null;
const coverPosition = coverObjectPosition(cover?.focalPoint);
---

<a
  href={url}
  class={`card card__blog${isPreview ? " card__blog--preview" : ""}`}
>
  {
    previewLabel && (
      <span
        class:list={[
          "card__status-badge",
          {
            "card__status-badge--scheduled": publicationStatus === "scheduled",
          },
        ]}
        aria-label={previewLabel}
      >
        {previewLabel}
      </span>
    )
  }
  {
    cover && (
      <div class="card__cover">
        <Image
          src={cover.image}
          alt={cover.alt ?? ""}
          widths={[400, 640, 960]}
          sizes="(max-width: 639px) calc(100vw - 2rem), (max-width: 1023px) calc(50vw - 1.5rem), 370px"
          loading="lazy"
          decoding="async"
          style={`object-position: ${coverPosition};`}
        />
        <div class="card__cover-overlay" aria-hidden="true" />
      </div>
    )
  }
  <div class="card__body">
    {
      formattedDate && (
        <p class="card-meta">
          {formattedDate}
          {readingTime && ` · ${readingTime}`}
        </p>
      )
    }
    <p class="card__title">{title}</p>
    {subTitle && <p class="card__subtitle">{subTitle}</p>}
    <p class="card__description">{description}</p>
  </div>
  <div class="card__cta">
    <span>Read Post</span>
    <span aria-hidden="true">&rarr;</span>
  </div>
</a>

<style lang="scss">
  .card__description {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.65;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: initial;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .card__title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .card__subtitle {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: initial;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .card__status-badge {
    position: absolute;
    top: 0.625rem;
    left: 0.625rem;
    z-index: 2;
    padding: 0.2rem 0.55rem;
    background-color: var(--accent-primary);
    color: var(--text-on-strong);
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1;

    &--scheduled {
      background-color: var(--accent-secondary);
    }
  }

  .card__blog--preview {
    position: relative;

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      background-color: var(--surface-page);
      opacity: 0.55;
      pointer-events: none;
      z-index: 1;
    }
  }

  @media (max-width: 639px) {
    .card__description {
      -webkit-line-clamp: 4;
    }
  }
</style>
