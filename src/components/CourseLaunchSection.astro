---
import CourseInterestForm from "./CourseInterestForm.astro";
import {
  courseLaunchLabel,
  courseOffers,
  courseSupportOffer,
} from "../data/courses";
import { getCourseIcon } from "../utils/contentIcons";

const launchModules = courseOffers.map((course) => ({
  slug: course.slug,
  title: course.title,
  teaser: course.teaser,
  icon: getCourseIcon(course.slug, 18),
}));

const launchSignals = [
  "Founding launch",
  "Self-paced",
  courseSupportOffer.singleShort,
];
---

<section
  class="course-launch stack-space"
  id="course-launch"
  aria-labelledby="course-launch-heading"
>
  <div class="container" data-width="narrow">
    <p class="section-label section-label--secondary eyebrow">Courses</p>
    <div class="card">
      <div class="intro">
        <div class="meta">
          <div class="signals" aria-label="Launch details">
            {
              launchSignals.map((signal) => (
                <span class="signal">{signal}</span>
              ))
            }
          </div>
          <p class="status">{courseLaunchLabel}</p>
        </div>
        <p class="kicker">
          For career switchers and engineers building confidence
        </p>
        <h2 class="heading" id="course-launch-heading">
          Choose the full bundle or start with one course
        </h2>
        <p class="body">
          Founding enrolment opens soon. Take the full bundle for end-to-end
          context, or pick up the single course that matches what you need right
          now. 1:1 support is included whether you start with one course or take
          the full bundle. {courseSupportOffer.additionalSessionsDetail}
        </p>
        <div class="links">
          <a
            href="/courses"
            class="button"
            data-variant="ink"
            data-size="large"
          >
            See the launch details
          </a>
          <a href="/contact?reason=course-enquiry#contact-form" class="link">
            Ask about the launch and support
          </a>
        </div>
      </div>

      <ul class="modules" role="list" aria-label="Course modules">
        {
          launchModules.map((module) => (
            <li>
              <a
                class="module"
                href={`/courses#course-${module.slug}`}
                aria-label={`Jump to ${module.title} details`}
              >
                <div class="module-header">
                  <span
                    class="module-icon"
                    aria-hidden="true"
                    set:html={module.icon}
                  />
                  <p class="module-heading">{module.title}</p>
                </div>
                <p class="module-copy">{module.teaser}</p>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="form">
        <CourseInterestForm
          idPrefix="course-launch"
          source="course-launch-home"
          buttonLabel="Join the launch list"
          fineprint="Launch updates, first access, and earliest enrolment details only."
          successMessage="You're on the launch list. I'll email you when founding enrolment opens."
          ariaLabel="Register interest for courses from the homepage"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .course-launch {
    padding: 0 1.5rem;
  }

  .eyebrow {
    margin-bottom: 1.5rem;
  }

  .card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-top: 4px solid var(--accent-secondary);
    border-radius: var(--radius-panel);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--accent-secondary) 10%, var(--surface-elevated))
          0%,
        var(--surface-elevated) 38%
      ),
      var(--surface-elevated);
    box-shadow: var(--shadow-panel);

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(
        ellipse 80% 80% at 100% 0%,
        color-mix(in srgb, var(--accent-secondary) 10%, transparent) 0%,
        transparent 58%
      );
      pointer-events: none;
    }
  }

  .intro {
    margin-bottom: 1rem;
  }

  .meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.75rem 1rem;
    margin-bottom: 0.85rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .signals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    min-width: 0;
    margin: 0;
  }

  .signal {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    padding: 0.28rem 0.7rem;
    border-radius: var(--radius-pill);
    border: 1px solid
      color-mix(in srgb, var(--accent-secondary) 14%, transparent);
    background: color-mix(
      in srgb,
      var(--surface-page) 86%,
      var(--accent-secondary) 14%
    );
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-primary) 84%, var(--accent-secondary));
  }

  .link {
    display: inline-flex;
    align-items: center;
    min-height: 2.85rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--accent-secondary);
  }

  .status {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    margin: 0;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-on-strong);
    background: var(--accent-secondary);
    box-shadow: 0 10px 24px
      color-mix(in srgb, var(--accent-secondary) 24%, transparent);
  }

  .kicker {
    margin: 0 0 0.35rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-secondary);
  }

  .heading {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1;
    color: var(--text-primary);
  }

  .body {
    margin: 0.65rem 0 0;
    color: var(--text-muted);
    max-width: 60ch;
  }

  .modules {
    list-style: none;
    margin: 0;
    padding: 0;
    padding-top: 0.75rem;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  .modules li {
    display: flex;
  }

  .module {
    display: flex;
    flex: 1;
    flex-direction: column;
    border: 1px solid color-mix(in srgb, var(--border-subtle) 75%, transparent);
    border-radius: var(--radius-compact);
    padding: 0.85rem 0.9rem;
    background: color-mix(
      in srgb,
      var(--surface-page) 88%,
      var(--accent-secondary) 12%
    );
    color: inherit;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
    animation: course-module-in 320ms ease backwards;

    &:hover,
    &:focus-visible {
      transform: translateY(-2px);
      border-color: color-mix(
        in srgb,
        var(--accent-secondary) 22%,
        transparent
      );
      box-shadow: 0 18px 34px
        color-mix(in srgb, var(--accent-secondary) 10%, transparent);
    }
  }

  .modules li:nth-child(2) .module {
    animation-delay: 80ms;
  }

  .modules li:nth-child(3) .module {
    animation-delay: 160ms;
  }

  .modules li:nth-child(4) .module {
    animation-delay: 240ms;
  }

  .module-heading {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-primary);
    font-weight: 700;
  }

  .module-header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .module-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: var(--radius-pill);
    background: color-mix(
      in srgb,
      var(--surface-page) 82%,
      var(--accent-secondary) 18%
    );
    color: var(--accent-secondary);
    flex-shrink: 0;

    :global(svg) {
      display: block;
    }
  }

  .module-copy {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .form {
    margin-top: 1rem;
  }

  @keyframes course-module-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 768px) {
    .modules {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .modules {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .module {
      animation: none;
    }
  }
</style>
