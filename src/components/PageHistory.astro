---
interface HistoryEntry {
  datetime: Date;
  note: string;
}

interface Props {
  entries: HistoryEntry[];
}

const { entries } = Astro.props;

function formatDatetime(date: Date): string {
  return date.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    timeZone: "Europe/London",
  });
}
---

<div class="page-history">
  <p class="heading">Page history</p>
  <ol class="log">
    {
      entries.map((entry) => (
        <li class="entry">
          <time class="time" datetime={entry.datetime.toISOString()}>
            {formatDatetime(entry.datetime)}
          </time>
          <span class="note" set:html={entry.note} />
        </li>
      ))
    }
  </ol>
</div>

<style>
  .page-history {
    min-width: 0;
  }

  .heading {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }

  .log {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1rem;
    border-left: 2px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.6rem 0;
    position: relative;

    & + & {
      border-top: 1px solid var(--border-subtle);
    }

    &::before {
      content: "";
      position: absolute;
      left: -1.35rem;
      top: 1rem;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--border-subtle);
      box-shadow: 0 0 0 2px var(--surface-elevated);
    }
  }

  .time {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    opacity: 0.7;
  }

  .note {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
