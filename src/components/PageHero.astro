---
import { tagSlug } from "../utils/tags";
import Breadcrumb from "./Breadcrumb.astro";
import SharePost from "./SharePost.astro";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  kicker?: string;
  title: string;
  subtitle?: string;
  coverImage?: { src: string; alt?: string };
  tone?: "primary" | "secondary" | "neutral";
  tags?: string[];
  author?: string;
  date?: string;
  readingTime?: string;
  crumbs?: Crumb[];
  shareUrl?: string;
  shareTitle?: string;
}

const {
  kicker,
  title,
  subtitle,
  coverImage,
  tone = "primary",
  tags,
  author,
  date,
  readingTime,
  crumbs,
  shareUrl,
  shareTitle,
} = Astro.props;

function autoCrumbs(path: string): Crumb[] {
  const segments = path.split("/").filter(Boolean);
  const meaningful = segments.filter((s) => s !== "page" && !/^\d+$/.test(s));
  return meaningful.map((seg, i) => ({
    label: seg.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
    href: "/" + meaningful.slice(0, i + 1).join("/"),
  }));
}

const resolvedCrumbs: Crumb[] = crumbs ?? autoCrumbs(Astro.url.pathname);
---

<header
  class="page-hero"
  style={coverImage ? `--cover-image: url('${coverImage.src}')` : ""}
  data-tone={tone}
  data-has-cover={coverImage ? "true" : "false"}
>
  <div class="container">
    <div class="content">
      {
        resolvedCrumbs.length > 0 && (
          <Breadcrumb crumbs={resolvedCrumbs} inverted />
        )
      }
      {kicker && <p class="kicker">{kicker}</p>}
      <h1 class="heading">{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      {
        (author || date || readingTime || (tags && tags.length > 0)) && (
          <div class="meta">
            {author && <span class="author">By {author}</span>}
            {date && <span class="date">{date}</span>}
            {readingTime && <span class="reading-time">{readingTime}</span>}
            {(date || readingTime) && tags && tags.length > 0 && (
              <span class="divider" aria-hidden="true" />
            )}
            {tags && tags.length > 0 && (
              <div class="tags">
                {tags.map((tag: string) => (
                  <a href={`/tags/${tagSlug(tag)}`} class="tag">
                    {tag}
                  </a>
                ))}
              </div>
            )}
          </div>
        )
      }
      {
        shareUrl && shareTitle && (
          <div class="share">
            <SharePost url={shareUrl} title={shareTitle} />
          </div>
        )
      }
    </div>
  </div>
</header>

<style>
  @keyframes dot-grid-breathe {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 1;
    }
  }

  .page-hero {
    --page-hero-accent: var(--accent-primary);
    --page-hero-accent-alt: var(--accent-secondary);
    --page-hero-ink: var(--text-primary);
    --page-hero-muted: color-mix(in srgb, var(--text-primary) 72%, transparent);
    --page-hero-soft: color-mix(in srgb, var(--text-primary) 56%, transparent);
    --page-hero-kicker-ink: var(--page-hero-accent);
    --page-hero-kicker-bg: color-mix(
      in srgb,
      var(--page-hero-accent) 10%,
      var(--surface-elevated)
    );
    --page-hero-kicker-border: color-mix(
      in srgb,
      var(--page-hero-accent) 22%,
      transparent
    );
    --page-hero-tag-bg: color-mix(
      in srgb,
      var(--page-hero-accent) 6%,
      var(--surface-elevated)
    );
    --page-hero-tag-border: color-mix(
      in srgb,
      var(--page-hero-accent) 18%,
      transparent
    );
    --page-hero-tag-text: color-mix(
      in srgb,
      var(--text-primary) 78%,
      var(--page-hero-accent)
    );
    min-height: clamp(250px, 34vw, 330px);
    display: flex;
    align-items: flex-end;
    padding: clamp(3.5rem, 7vw, 4.5rem) 1.5rem clamp(2.6rem, 5vw, 3.25rem);
    background:
      radial-gradient(
        ellipse 74% 84% at 8% 0%,
        color-mix(in srgb, var(--page-hero-accent) 14%, transparent) 0%,
        transparent 72%
      ),
      radial-gradient(
        ellipse 68% 76% at 100% 0%,
        color-mix(in srgb, var(--page-hero-accent-alt) 12%, transparent) 0%,
        transparent 74%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--surface-page-top) 44%, var(--surface-elevated))
          0%,
        color-mix(in srgb, var(--surface-page) 76%, var(--surface-elevated))
          100%
      );
    border-bottom: 1px solid var(--border-subtle);
    color: var(--page-hero-ink);
    position: relative;
    isolation: isolate;
    overflow: hidden;

    &:not([data-has-cover="true"])::before {
      content: "";
      position: absolute;
      left: 1.5rem;
      right: 1.5rem;
      bottom: 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--page-hero-accent) 40%, transparent) 0%,
        transparent 100%
      );
      pointer-events: none;
      opacity: 0.8;
    }

    &[data-has-cover="true"] {
      --page-hero-ink: var(--text-on-strong);
      --page-hero-muted: rgba(var(--text-on-strong-rgb), 0.8);
      --page-hero-soft: rgba(var(--text-on-strong-rgb), 0.56);
      --page-hero-kicker-ink: var(--text-on-strong);
      --page-hero-kicker-bg: rgba(var(--text-on-strong-rgb), 0.06);
      --page-hero-kicker-border: rgba(var(--text-on-strong-rgb), 0.16);
      --page-hero-tag-bg: rgba(var(--text-on-strong-rgb), 0.08);
      --page-hero-tag-border: rgba(var(--text-on-strong-rgb), 0.22);
      --page-hero-tag-text: rgba(var(--text-on-strong-rgb), 0.74);
      min-height: 420px;
      padding: 5rem 1.5rem 4rem;
      background-image: var(--cover-image);
      background-size: cover;
      background-position: center;
      border-bottom: none;

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background-image: radial-gradient(
          circle,
          rgba(var(--text-on-strong-rgb), 0.18) 1px,
          transparent 1px
        );
        background-size: 28px 28px;
        mask-image: radial-gradient(
          ellipse 90% 90% at 50% 50%,
          black 30%,
          transparent 90%
        );
        -webkit-mask-image: radial-gradient(
          ellipse 90% 90% at 50% 50%,
          black 30%,
          transparent 90%
        );
        pointer-events: none;

        @media (prefers-reduced-motion: no-preference) {
          animation: dot-grid-breathe 4s ease-in-out infinite;
        }
      }

      &::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -2;
        background: linear-gradient(
          to bottom,
          rgba(var(--overlay-rgb), 0.3) 0%,
          rgba(var(--overlay-rgb), 0.64) 52%,
          rgba(var(--overlay-rgb), 0.9) 100%
        );
        pointer-events: none;
      }
    }

    .container {
      position: relative;
      z-index: 1;
      width: 100%;
    }
  }

  .page-hero[data-tone="secondary"] {
    --page-hero-accent: var(--accent-secondary);
    --page-hero-accent-alt: var(--accent-primary);
  }

  .page-hero[data-tone="neutral"] {
    --page-hero-accent: color-mix(
      in srgb,
      var(--text-primary) 16%,
      transparent
    );
    --page-hero-accent-alt: var(--accent-secondary);
    --page-hero-kicker-ink: color-mix(
      in srgb,
      var(--text-primary) 84%,
      var(--accent-secondary-deep)
    );
    --page-hero-kicker-bg: color-mix(
      in srgb,
      var(--accent-secondary) 10%,
      var(--surface-elevated)
    );
    --page-hero-kicker-border: color-mix(
      in srgb,
      var(--accent-secondary) 22%,
      var(--border-subtle)
    );
  }

  .content {
    max-width: 760px;
  }

  .page-hero:not([data-has-cover="true"])
    :global(.breadcrumb-nav:where([data-inverted])) {
    margin-bottom: 1rem;
  }

  .page-hero:not([data-has-cover="true"])
    :global(.breadcrumb-nav:where([data-inverted]) .link) {
    color: color-mix(in srgb, var(--text-primary) 62%, transparent);
  }

  .page-hero:not([data-has-cover="true"])
    :global(.breadcrumb-nav:where([data-inverted]) .link:hover),
  .page-hero:not([data-has-cover="true"])
    :global(.breadcrumb-nav:where([data-inverted]) .link:focus-visible) {
    color: var(--page-hero-accent);
  }

  .page-hero:not([data-has-cover="true"])
    :global(.breadcrumb-nav:where([data-inverted]) .current) {
    color: var(--text-primary);
  }

  .page-hero:not([data-has-cover="true"])
    :global(
      .breadcrumb-nav:where([data-inverted]) .item:not(:last-child)::after
    ) {
    color: color-mix(in srgb, var(--text-primary) 28%, transparent);
  }

  .heading {
    font-size: clamp(2.15rem, 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-bottom: 0.85rem;
    color: var(--page-hero-ink);
  }

  .page-hero[data-has-cover="true"] .heading {
    font-size: clamp(2.35rem, 6vw, 4rem);
  }

  .subtitle {
    max-width: 60ch;
    font-size: clamp(1.02rem, 1.65vw, 1.16rem);
    line-height: 1.72;
    color: var(--page-hero-muted);
    margin-bottom: 1.4rem;
    font-weight: 400;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
    font-size: 0.95rem;
    font-family: "Barlow", sans-serif;
    text-transform: none;
    letter-spacing: 0.01em;
    color: var(--page-hero-soft);
  }

  .author {
    color: var(--page-hero-ink);
    font-weight: 600;
  }

  .date {
    &::before {
      content: "·";
      margin-right: 1rem;
      color: var(--accent-primary);
    }
  }

  .divider {
    &::before {
      content: "·";
      color: var(--accent-primary);
    }

    @media (max-width: 639px) {
      display: none;
    }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-block;
    font-family: "Barlow", sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0.01em;
    color: var(--page-hero-tag-text);
    border: 1px solid var(--page-hero-tag-border);
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.75rem;

    @media (max-width: 639px) {
      font-size: 0.8rem;
      padding: 0.4rem 0.75rem;
    }
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;

    &:hover {
      background-color: color-mix(
        in srgb,
        var(--page-hero-accent) 12%,
        var(--surface-elevated)
      );
      border-color: color-mix(
        in srgb,
        var(--page-hero-accent) 40%,
        transparent
      );
      color: var(--page-hero-accent);
    }
  }

  .kicker {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--page-hero-kicker-ink);
    border: 1px solid var(--page-hero-kicker-border);
    border-radius: var(--radius-pill);
    background: var(--page-hero-kicker-bg);
    margin-bottom: 0.75rem;
  }

  .share {
    margin-top: 1.5rem;

    :global(.share-post) {
      border-color: var(--page-hero-tag-border);
      border-bottom: none;
      padding: 1.25rem 0 0;
      margin: 0;
    }

    :global(:where(.share-post) .caption) {
      color: var(--page-hero-soft);
    }

    :global(:where(.share-post) .share) {
      color: var(--page-hero-soft);
      border-color: var(--page-hero-tag-border);
      background-color: var(--page-hero-tag-bg);

      &:hover {
        color: var(--page-hero-accent);
        border-color: color-mix(
          in srgb,
          var(--page-hero-accent) 40%,
          transparent
        );
        background-color: color-mix(
          in srgb,
          var(--page-hero-accent) 12%,
          var(--surface-elevated)
        );
      }
    }
  }
</style>
