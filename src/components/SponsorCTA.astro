---
interface Props {
  mode?: "article" | "support";
  placement?: "full" | "sidebar";
}

const { mode = "article", placement = "full" } = Astro.props;
const supportPublishableKey =
  import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY?.trim() ?? "";

const isArticle = mode === "article";
const isSidebar = placement === "sidebar";
const eyebrow = isSidebar
  ? "Enjoying the post?"
  : isArticle
    ? "Working on something similar?"
    : "Enjoying the site?";
const title = isSidebar
  ? "Support the writing"
  : isArticle
    ? "Need help raising the bar?"
    : "Support the writing";
const body = isSidebar
  ? "Found this useful? You can back the writing with a quick tip."
  : isArticle
    ? "I help teams improve engineering practice through hands-on delivery, pragmatic reviews, and mentoring. If you want a second pair of eyes or practical support, let's talk."
    : "If the blog has been useful, you can back the writing with a tip. If you need support with career growth or engineering practice instead, I'm available to help.";
const headingId = isSidebar
  ? "sidebar-support-cta"
  : isArticle
    ? "article-support-cta"
    : "site-support-cta";
const showHighlights = isArticle && !isSidebar;
const showSupportButton = Boolean(supportPublishableKey);
const showWorkButton = !isSidebar || !showSupportButton;
const showSupportIntro = showSupportButton && !isSidebar;
const supportButtonLabel = isSidebar ? "Leave a tip" : "Support the writing";
---

<section
  class={`support-cta stack-space support-cta--${mode} support-cta--${placement}`}
  aria-labelledby={headingId}
>
  <div class="container" data-width="narrow">
    <div class="support-cta__panel">
      <div class="support-cta__content">
        <p class="support-cta__eyebrow">{eyebrow}</p>
        <h2 class="support-cta__title" id={headingId}>{title}</h2>
        <p class="support-cta__text">{body}</p>

        {
          showHighlights && (
            <ul class="support-cta__highlights" role="list">
              <li>Engineering practice review</li>
              <li>Hands-on delivery</li>
              <li>Team mentoring</li>
            </ul>
          )
        }
      </div>

      <div class="support-cta__actions">
        {
          showWorkButton && (
            <a href="/contact" class="support-cta__btn support-cta__btn--work">
              Get guidance
            </a>
          )
        }

        {
          showSupportButton && (
            <>
              {showSupportIntro && (
                <p class="support-cta__aside">
                  If this has been useful, you can back the writing with a
                  one-off tip through a secure Stripe checkout.
                </p>
              )}
              <button
                type="button"
                class="support-cta__btn support-cta__btn--support"
                data-support-modal-open
              >
                {supportButtonLabel}
              </button>
            </>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .support-cta {
    padding: 0 1.5rem;
  }

  .support-cta--sidebar {
    margin: 1rem 0;
    padding: 0;
  }

  .support-cta__panel {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 2rem;
    padding: 2rem 1.5rem;
    border: 1px solid rgba(var(--accent-primary-rgb), 0.16);
    border-radius: var(--radius-panel-large);
    background:
      radial-gradient(
        circle at top right,
        rgba(var(--accent-primary-rgb), 0.16),
        transparent 32%
      ),
      linear-gradient(
        145deg,
        rgba(var(--text-on-strong-rgb), 0.95),
        color-mix(in srgb, var(--text-on-strong) 98%, var(--accent-primary) 2%)
      );
    box-shadow: 0 20px 60px rgba(var(--shadow-rgb), 0.08);

    @media (min-width: 768px) {
      grid-template-columns: minmax(0, 1.7fr) minmax(16rem, 1fr);
      gap: 2.5rem;
      padding: 2.5rem;
    }
  }

  .support-cta__panel::before,
  .support-cta__panel::after {
    content: "";
    position: absolute;
    border-radius: var(--radius-pill);
    pointer-events: none;
  }

  .support-cta__panel::before {
    width: 16rem;
    height: 16rem;
    right: -6rem;
    bottom: -9rem;
    background: rgba(var(--accent-primary-rgb), 0.08);
  }

  .support-cta__panel::after {
    width: 10rem;
    height: 10rem;
    right: 12%;
    top: -6rem;
    border: 1px solid rgba(var(--accent-primary-rgb), 0.12);
  }

  :global([data-theme="dark"]) .support-cta__panel {
    --support-cta-surface-top: rgba(18, 18, 18, 0.98);
    --support-cta-surface-bottom: rgba(26, 20, 24, 0.98);
    border-color: rgba(var(--accent-primary-rgb), 0.24);
    background:
      radial-gradient(
        circle at top right,
        rgba(var(--accent-primary-rgb), 0.18),
        transparent 32%
      ),
      linear-gradient(
        145deg,
        var(--support-cta-surface-top),
        var(--support-cta-surface-bottom)
      );
    box-shadow: 0 24px 80px rgba(var(--overlay-rgb), 0.28);
  }

  .support-cta__content,
  .support-cta__actions {
    position: relative;
    z-index: 1;
  }

  .support-cta__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.75rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-primary);
  }

  .support-cta__title {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.95;
    color: var(--text-primary);
    max-width: 14ch;
  }

  .support-cta--support .support-cta__title {
    max-width: 16ch;
  }

  .support-cta__text {
    margin: 0.9rem 0 0;
    max-width: 58ch;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .support-cta__highlights {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .support-cta__highlights li {
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(var(--accent-primary-rgb), 0.16);
    border-radius: var(--radius-pill);
    background: rgba(var(--text-on-strong-rgb), 0.65);
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-primary);
  }

  :global([data-theme="dark"]) .support-cta__highlights li {
    background: rgba(var(--text-on-strong-rgb), 0.04);
    border-color: rgba(var(--accent-primary-rgb), 0.22);
  }

  .support-cta__actions {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    justify-content: center;
  }

  .support-cta--sidebar .support-cta__panel {
    gap: 0.8rem;
    padding: 1rem 0.9rem;
    border-radius: var(--radius-soft);
    box-shadow: 0 10px 22px rgba(var(--shadow-rgb), 0.06);
  }

  @media (min-width: 768px) {
    .support-cta--sidebar .support-cta__panel {
      grid-template-columns: 1fr;
      gap: 0.8rem;
      padding: 1rem 0.9rem;
    }
  }

  .support-cta--sidebar .support-cta__panel::before {
    width: 8rem;
    height: 8rem;
    right: -3rem;
    bottom: -4rem;
  }

  .support-cta--sidebar .support-cta__panel::after {
    width: 5.5rem;
    height: 5.5rem;
    right: -0.5rem;
    top: -2rem;
  }

  .support-cta--sidebar .support-cta__title {
    max-width: none;
    font-size: clamp(1.35rem, 2.5vw, 1.7rem);
  }

  .support-cta--sidebar .support-cta__text {
    max-width: none;
    margin-top: 0.45rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .support-cta--sidebar .support-cta__actions {
    gap: 0.55rem;
  }

  .support-cta--sidebar .support-cta__btn {
    width: 100%;
    min-height: 2.65rem;
    padding: 0.7rem 0.95rem;
    font-size: 0.82rem;
  }

  .support-cta--sidebar .support-cta__eyebrow {
    margin-bottom: 0.45rem;
    font-size: 0.72rem;
  }

  .support-cta__btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 3rem;
    padding: 0.85rem 1.2rem;
    border: 0;
    border-radius: var(--radius-pill);
    appearance: none;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      background-color 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease;
  }

  .support-cta__btn:hover {
    transform: translateY(-2px);
  }

  .support-cta__btn:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 3px;
  }

  .support-cta__btn--work {
    background: linear-gradient(
      135deg,
      var(--accent-primary),
      color-mix(in srgb, var(--accent-primary) 72%, var(--text-on-strong) 28%)
    );
    color: var(--text-on-strong);
    box-shadow: 0 12px 30px rgba(var(--accent-primary-rgb), 0.22);
  }

  .support-cta__btn--work:hover {
    box-shadow: 0 16px 36px rgba(var(--accent-primary-rgb), 0.28);
  }

  .support-cta__btn--support {
    border: 1px solid rgba(var(--accent-primary-rgb), 0.16);
    background: rgba(var(--text-on-strong-rgb), 0.82);
    color: var(--text-primary);
    box-shadow: 0 10px 24px rgba(var(--shadow-rgb), 0.05);
  }

  .support-cta__btn--support:hover {
    border-color: rgba(var(--accent-primary-rgb), 0.32);
    background: color-mix(
      in srgb,
      var(--text-on-strong) 96%,
      var(--accent-primary) 4%
    );
    box-shadow: 0 16px 32px rgba(var(--shadow-rgb), 0.08);
  }

  :global([data-theme="dark"]) .support-cta__btn--support {
    border-color: rgba(var(--accent-primary-rgb), 0.24);
    background: rgba(var(--text-on-strong-rgb), 0.04);
    color: var(--text-on-strong);
    box-shadow: none;
  }

  :global([data-theme="dark"]) .support-cta__btn--support:hover {
    border-color: rgba(var(--accent-primary-rgb), 0.34);
    background: rgba(var(--accent-primary-rgb), 0.08);
  }

  .support-cta__aside {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .support-cta--support {
    padding-bottom: 0;
  }

  .support-cta--sidebar.support-cta--support {
    padding-bottom: 0;
  }
</style>
