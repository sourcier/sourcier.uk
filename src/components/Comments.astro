---
interface Props {
  postId: string;
}
const { postId } = Astro.props;
---

<section class="section comments stack-space stack-space--tight" id="comments">
  <div class="container" data-width="narrow">
    <div class="inner">
      <div class="list-section">
        <h2 class="heading">Comments</h2>
        <div
          class="list"
          id="comments-list"
          data-post-slug={postId}
          aria-live="polite"
        >
          <p class="status-line">Loading comments…</p>
        </div>
      </div>

      <div class="form">
        <h2 class="heading">Leave a comment</h2>

        <!--
        data-netlify="true" causes Netlify's build bot to register this form.
        The hidden form-name field is required for AJAX submissions.
        The bot-field honeypot helps filter automated spam. The hidden
        parentId field is unused here (top-level comments have no parent) —
        it only needs to exist so Netlify's build-time schema includes it,
        since reply forms are created dynamically at runtime and reuse this
        same registered "blog-comments" schema.
      -->
        <form
          id="comment-form"
          name="blog-comments"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          novalidate
        >
          <input type="hidden" name="form-name" value="blog-comments" />
          <input type="hidden" name="postSlug" value={postId} />
          <input type="hidden" name="parentId" value="" />

          <p class="hidden" aria-hidden="true">
            <label
              >Leave this blank: <input name="bot-field" tabindex="-1" /></label
            >
          </p>

          <div class="field">
            <label class="label" for="comment-name">Name</label>
            <div class="control">
              <input
                class="input"
                type="text"
                id="comment-name"
                name="name"
                required
                placeholder="Your name"
                autocomplete="name"
                maxlength="100"
              />
            </div>
          </div>

          <div class="field">
            <label class="label" for="comment-email">
              Email <span class="optional">(never published)</span>
            </label>
            <div class="control">
              <input
                class="input"
                type="email"
                id="comment-email"
                name="email"
                required
                placeholder="you@example.com"
                autocomplete="email"
                maxlength="254"
              />
            </div>
          </div>

          <div class="field">
            <label class="label" for="comment-body">Comment</label>
            <div class="control">
              <textarea
                class="textarea"
                id="comment-body"
                name="comment"
                required
                rows="5"
                placeholder="What are your thoughts?"
                maxlength="5000"></textarea>
            </div>
          </div>

          <div class="fields">
            <div class="control">
              <button
                class="button"
                data-variant="primary"
                type="submit"
                id="comment-submit"
              >
                Post comment
              </button>
            </div>
            <p class="form-status" id="comment-form-status" aria-live="polite">
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
  <!--
  Hidden form registered with Netlify at build time so the edge knows the
  approved-comments form schema. Data is submitted here programmatically by
  the approve-comment Netlify Function — it is never shown to users.
-->
  <form name="approved-comments" data-netlify="true" hidden aria-hidden="true">
    <input type="hidden" name="postSlug" />
    <input type="hidden" name="name" />
    <input type="hidden" name="email" />
    <input type="hidden" name="comment" />
    <input type="hidden" name="originalDate" />
    <input type="hidden" name="commentId" />
    <input type="hidden" name="parentId" />
  </form>

  <script>
    const listEl = document.getElementById("comments-list") as HTMLElement;
    const form = document.getElementById("comment-form") as HTMLFormElement;
    const submitBtn = document.getElementById(
      "comment-submit",
    ) as HTMLButtonElement;
    const formStatus = document.getElementById(
      "comment-form-status",
    ) as HTMLElement;
    const postSlug = listEl?.dataset.postSlug ?? "";

    interface Comment {
      id: string;
      parentId: string | null;
      name: string;
      comment: string;
      date: string;
      emailHash?: string | null;
    }

    interface CommentNode extends Comment {
      replies: CommentNode[];
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function formatDate(iso: string): string {
      return new Date(iso).toLocaleDateString("en-GB", {
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "Europe/London",
        timeZoneName: "short",
      });
    }

    // Groups a flat, chronologically-sorted list into a tree keyed by
    // parentId. Replies whose parent isn't in the list (e.g. the parent was
    // later removed) are kept at the top level rather than dropped.
    function buildCommentTree(comments: Comment[]): CommentNode[] {
      const nodes = new Map<string, CommentNode>();
      comments.forEach((c) => nodes.set(c.id, { ...c, replies: [] }));

      const roots: CommentNode[] = [];
      nodes.forEach((node) => {
        const parent = node.parentId ? nodes.get(node.parentId) : undefined;
        if (parent) {
          parent.replies.push(node);
        } else {
          roots.push(node);
        }
      });
      return roots;
    }

    function renderComment(c: CommentNode): string {
      const initial = escapeHtml(c.name.charAt(0).toUpperCase());
      const avatarInner = c.emailHash
        ? `<img class="avatar-img" src="https://www.gravatar.com/avatar/${c.emailHash}?s=72&d=404" alt="" loading="lazy" onload="this.nextElementSibling.style.display='none'" onerror="this.style.display='none'" /><span class="initial">${initial}</span>`
        : `<span class="initial">${initial}</span>`;
      const repliesHtml = c.replies.length
        ? `<div class="replies">${c.replies.map(renderComment).join("")}</div>`
        : "";
      return `
        <article class="comment" id="comment-${escapeHtml(c.id)}" data-comment-id="${escapeHtml(c.id)}" aria-label="${escapeHtml(c.name)}">
          <div class="avatar">${avatarInner}</div>
          <div class="content">
            <div class="meta">
              <span class="author">${escapeHtml(c.name)}</span>
              <span class="separator" aria-hidden="true">&middot;</span>
              <time class="date" datetime="${c.date}">${formatDate(c.date)}</time>
              <span class="separator" aria-hidden="true">&middot;</span>
              <button
                type="button"
                class="link-btn"
                data-comment-id="${escapeHtml(c.id)}"
                aria-label="Copy link to this comment"
              >Link</button>
            </div>
            <p class="body">${escapeHtml(c.comment)}</p>
            <button
              type="button"
              class="reply-btn"
              data-comment-id="${escapeHtml(c.id)}"
              data-comment-name="${escapeHtml(c.name)}"
            >Reply</button>
            <div class="reply-slot" data-comment-id="${escapeHtml(c.id)}"></div>
          </div>
        </article>
        ${repliesHtml}`;
    }

    function buildCommentsHtml(comments: Comment[]): string {
      if (!comments.length) {
        return '<p class="empty">No comments yet — be the first.</p>';
      }
      return buildCommentTree(comments).map(renderComment).join("");
    }

    function renderComments(comments: Comment[], animate = false) {
      if (!listEl) return;
      const html = buildCommentsHtml(comments);
      if (!animate) {
        listEl.innerHTML = html;
        return;
      }
      listEl.classList.add("fading");
      listEl.addEventListener(
        "animationend",
        () => {
          listEl.innerHTML = html;
          listEl.classList.remove("fading");
          listEl.classList.add("entering");
          listEl.addEventListener(
            "animationend",
            () => listEl.classList.remove("entering"),
            { once: true },
          );
        },
        { once: true },
      );
    }

    // Posts a comment (top-level or reply) via Netlify's AJAX form pattern.
    // Shared by the main form and every dynamically-created reply form so
    // both follow the same submit / status / disable behaviour.
    async function submitComment(
      formEl: HTMLFormElement,
      submitButton: HTMLButtonElement,
      statusEl: HTMLElement,
      statusClass: string,
      onSuccess: () => void,
    ) {
      submitButton.disabled = true;
      statusEl.textContent = "Posting…";
      statusEl.className = statusClass;
      statusEl.removeAttribute("data-status");

      try {
        const data = new FormData(formEl);
        const res = await fetch(window.location.pathname, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(
            Array.from(data.entries(), ([key, value]) => [key, String(value)]),
          ).toString(),
        });

        if (res.ok) {
          statusEl.textContent =
            "Thanks — your comment has been submitted and will appear once approved.";
          statusEl.dataset.status = "success";
          onSuccess();
          loadComments();
        } else {
          statusEl.textContent = "Something went wrong. Please try again.";
          statusEl.dataset.status = "error";
          submitButton.disabled = false;
        }
      } catch {
        statusEl.textContent = "Something went wrong. Please try again.";
        statusEl.dataset.status = "error";
        submitButton.disabled = false;
      }
    }

    // Builds a standalone reply form scoped to a single comment. It's a
    // separate DOM tree (not a clone of the main form) so it can be inserted
    // directly under the comment being replied to, keeping the main "Leave a
    // comment" form untouched at the bottom of the page.
    function buildReplyForm(commentId: string, name: string): HTMLElement {
      const uid = commentId.replace(/[^a-zA-Z0-9_-]/g, "");
      const wrapper = document.createElement("div");
      wrapper.className = "reply-form";
      wrapper.dataset.commentId = commentId;
      wrapper.innerHTML = `
        <div class="reply-heading">Replying to ${escapeHtml(name)}</div>
        <form>
          <input type="hidden" name="form-name" value="blog-comments" />
          <input type="hidden" name="postSlug" value="${escapeHtml(postSlug)}" />
          <input type="hidden" name="parentId" value="${escapeHtml(commentId)}" />
          <p class="hidden" aria-hidden="true">
            <label>Leave this blank: <input name="bot-field" tabindex="-1" /></label>
          </p>
          <div class="field">
            <label class="label" for="reply-name-${uid}">Name</label>
            <div class="control">
              <input class="input" type="text" id="reply-name-${uid}" name="name" required placeholder="Your name" autocomplete="name" maxlength="100" />
            </div>
          </div>
          <div class="field">
            <label class="label" for="reply-email-${uid}">
              Email <span class="optional">(never published)</span>
            </label>
            <div class="control">
              <input class="input" type="email" id="reply-email-${uid}" name="email" required placeholder="you@example.com" autocomplete="email" maxlength="254" />
            </div>
          </div>
          <div class="field">
            <label class="label" for="reply-body-${uid}">Reply</label>
            <div class="control">
              <textarea class="textarea" id="reply-body-${uid}" name="comment" required rows="4" placeholder="Write your reply…" maxlength="5000"></textarea>
            </div>
          </div>
          <div class="fields">
            <div class="control">
              <button
                class="button"
                data-variant="primary"
                type="submit">Post reply</button>
            </div>
            <div class="control">
              <button
                type="button"
                class="button reply-cancel"
                data-variant="subtle">Cancel</button>
            </div>
            <p class="reply-status" aria-live="polite"></p>
          </div>
        </form>
      `;

      const replyFormEl = wrapper.querySelector("form") as HTMLFormElement;
      const replySubmitBtn = replyFormEl.querySelector(
        "button[type='submit']",
      ) as HTMLButtonElement;
      const replyStatus = wrapper.querySelector(".reply-status") as HTMLElement;
      const cancelBtn = wrapper.querySelector(
        ".reply-cancel",
      ) as HTMLButtonElement;

      cancelBtn.addEventListener("click", () => wrapper.remove());

      replyFormEl.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!replyFormEl.reportValidity()) return;
        await submitComment(
          replyFormEl,
          replySubmitBtn,
          replyStatus,
          "reply-status",
          () => wrapper.remove(),
        );
      });

      return wrapper;
    }

    function toggleReplyForm(commentId: string, name: string) {
      const openSlot = listEl?.querySelector(
        ".reply-slot:not(:empty)",
      ) as HTMLElement | null;
      const targetSlot = listEl?.querySelector(
        `.reply-slot[data-comment-id="${CSS.escape(commentId)}"]`,
      ) as HTMLElement | null;

      const wasAlreadyOpenForThis = openSlot === targetSlot;
      if (openSlot) openSlot.innerHTML = "";
      if (wasAlreadyOpenForThis || !targetSlot) return;

      const replyForm = buildReplyForm(commentId, name);
      targetSlot.appendChild(replyForm);
      replyForm.scrollIntoView({ behavior: "smooth", block: "center" });
      (
        replyForm.querySelector("input[name='name']") as HTMLInputElement | null
      )?.focus();
    }

    listEl?.addEventListener("click", (e) => {
      const replyBtn = (e.target as HTMLElement).closest(
        ".reply-btn",
      ) as HTMLButtonElement | null;
      if (replyBtn) {
        toggleReplyForm(
          replyBtn.dataset.commentId ?? "",
          replyBtn.dataset.commentName ?? "",
        );
        return;
      }

      const linkBtn = (e.target as HTMLElement).closest(
        ".link-btn",
      ) as HTMLButtonElement | null;
      if (linkBtn) {
        copyCommentLink(linkBtn);
      }
    });

    async function copyCommentLink(btn: HTMLButtonElement) {
      const commentId = btn.dataset.commentId ?? "";
      const url = `${window.location.origin}${window.location.pathname}#comment-${commentId}`;
      let copied = false;
      try {
        await navigator.clipboard.writeText(url);
        copied = true;
      } catch {
        // Clipboard API may be unavailable (older browsers, insecure context);
        // updating the URL bar's hash is still a usable fallback.
      }
      history.replaceState(null, "", `#comment-${commentId}`);
      const original = btn.textContent;
      btn.textContent = copied ? "Copied!" : "Link ready";
      setTimeout(() => {
        btn.textContent = original;
      }, 2000);
    }

    // Scrolls to and briefly highlights the comment referenced by the URL
    // hash (e.g. shared via the per-comment "Link" button). Comments render
    // asynchronously, so this runs after loadComments() resolves rather than
    // on DOMContentLoaded.
    function scrollToHashComment() {
      const hash = window.location.hash;
      if (!hash.startsWith("#comment-")) return;
      const target = document.getElementById(hash.slice(1));
      if (!target) return;
      target.scrollIntoView({ behavior: "smooth", block: "center" });
      target.classList.add("highlighted");
      target.addEventListener(
        "animationend",
        () => target.classList.remove("highlighted"),
        { once: true },
      );
    }

    async function loadComments() {
      if (!postSlug || !listEl) return;
      try {
        const res = await fetch(
          `/.netlify/functions/get-comments?slug=${encodeURIComponent(postSlug)}`,
        );
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const { comments } = await res.json();
        renderComments(comments, !window.location.hash.startsWith("#comment-"));
        scrollToHashComment();
      } catch {
        if (listEl) {
          listEl.innerHTML =
            '<p class="empty">Comments unavailable right now.</p>';
        }
      }
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      await submitComment(form, submitBtn, formStatus, "form-status", () =>
        form.reset(),
      );
    });

    loadComments();
  </script>

  <style>
    .comments {
      padding: clamp(3rem, 5vw, 3.75rem) 1.5rem;
      border-top: 1px solid var(--border-subtle);
      background-color: var(--surface-elevated);

      .inner {
        margin-left: auto;
        margin-right: auto;
      }
    }

    .heading {
      font-family: "Barlow Condensed", sans-serif;
      font-weight: 800;
      font-size: 1.75rem;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      color: var(--text-primary);
      margin-bottom: 2rem;
    }

    .list-section {
      margin-bottom: 3.5rem;
    }

    :global(:where(.comments) .comment) {
      display: flex;
      gap: 1rem;
      padding: 1.5rem;
      margin-bottom: 1rem;
      background-color: var(--surface-page);
      border: 1px solid var(--border-subtle);
      border-left: 3px solid var(--accent-primary);
    }

    :global(:where(.comments) .avatar) {
      flex-shrink: 0;
      position: relative;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 50%;
      background-color: var(--accent-primary);
      color: var(--text-on-strong);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      user-select: none;
    }

    :global(:where(.comments) .initial) {
      font-family: "Barlow Condensed", sans-serif;
      font-weight: 800;
      font-size: 1.25rem;
      line-height: 1;
    }

    :global(:where(.comments) .avatar-img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }

    :global(:where(.comments .comment) .content) {
      flex: 1;
      min-width: 0;
    }

    :global(:where(.comments .comment) .meta) {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.625rem;
    }

    :global(:where(.comments .comment) .author) {
      font-family: "Barlow Condensed", sans-serif;
      font-weight: 700;
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-primary);
    }

    :global(:where(.comments .comment) .separator) {
      color: var(--accent-primary);
      font-size: 0.875rem;
      line-height: 1;
    }

    :global(:where(.comments .comment) .date) {
      font-size: 0.8125rem;
      color: var(--text-muted);
      letter-spacing: 0.02em;
    }

    :global(:where(.comments .comment) .body) {
      margin: 0;
      padding: 0;
      border: none;
      font-size: 0.9375rem;
      line-height: 1.8;
      color: var(--text-primary);
      white-space: pre-wrap;
    }

    :global(:where(.comments) .reply-btn) {
      margin-top: 0.5rem;
      padding: 0;
      background: none;
      border: none;
      font-family: "Barlow Condensed", sans-serif;
      font-weight: 700;
      font-size: 0.8125rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--accent-primary);
      cursor: pointer;

      &:hover {
        text-decoration: underline;
      }
    }

    :global(:where(.comments) .link-btn) {
      padding: 0;
      background: none;
      border: none;
      font-size: 0.8125rem;
      color: var(--text-muted);
      cursor: pointer;

      &:hover {
        color: var(--accent-primary);
        text-decoration: underline;
      }
    }

    :global(:where(.comments) .comment.highlighted) {
      animation: comment-highlight-fade 2.4s ease;
    }

    @keyframes comment-highlight-fade {
      0%,
      35% {
        background-color: color-mix(
          in srgb,
          var(--accent-primary) 16%,
          transparent
        );
      }
      100% {
        background-color: transparent;
      }
    }

    :global(:where(.comments) .replies) {
      margin-left: clamp(1.25rem, 4vw, 2.75rem);
      margin-top: 1rem;
    }

    :global(:where(.comments) .replies .comment) {
      border-left-color: var(--border-subtle);
      background-color: var(--surface-elevated);
    }

    .status-line {
      font-size: 0.875rem;
      color: var(--text-muted);
    }

    :global(:where(.comments) .reply-slot:not(:empty)) {
      margin-top: 1rem;
    }

    :global(:where(.comments) .reply-form) {
      padding-top: 1rem;
      border-top: 1px dashed var(--border-subtle);
    }

    :global(:where(.comments) .reply-heading) {
      font-family: "Barlow Condensed", sans-serif;
      font-weight: 700;
      font-size: 0.8125rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-primary);
      margin-bottom: 0.875rem;
    }

    :global(:where(.comments) .reply-form .field) {
      margin-bottom: 0.75rem;
    }

    :global(:where(.comments) .reply-form .label) {
      color: var(--text-primary);
      font-weight: 600;
      font-size: 0.8125rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    :global(:where(.comments) .reply-form .input),
    :global(:where(.comments) .reply-form .textarea) {
      background-color: var(--surface-elevated);
      border-color: var(--border-subtle);
      color: var(--text-primary);
      border-radius: var(--radius-tight);
    }

    :global(:where(.comments) .reply-form .input:focus),
    :global(:where(.comments) .reply-form .textarea:focus) {
      border-color: var(--accent-primary);
      box-shadow: 0 0 0 2px rgba(var(--accent-primary-rgb), 0.15);
    }

    :global(:where(.comments) .reply-form .button[data-variant="primary"]) {
      background-color: var(--accent-primary);
      border-color: var(--accent-primary);
      color: var(--text-on-strong);
      font-family: "Barlow Condensed", sans-serif;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border-radius: var(--radius-tight);
    }

    :global(
      :where(.comments) .reply-form .button[data-variant="primary"]:hover
    ) {
      background-color: var(--accent-primary-deep);
      border-color: var(--accent-primary-deep);
    }

    :global(
      :where(.comments) .reply-form .button[data-variant="primary"]:disabled
    ) {
      opacity: 0.5;
      cursor: not-allowed;
    }

    :global(:where(.comments) .reply-status) {
      font-size: 0.8125rem;
      padding-left: 0.5rem;
      align-self: center;
    }

    :global(:where(.comments) .reply-status[data-status="success"]) {
      color: var(--color-success);
    }

    :global(:where(.comments) .reply-status[data-status="error"]) {
      color: var(--accent-primary);
    }

    :global([data-theme="dark"]) {
      :global(:where(.comments) .reply-form .input),
      :global(:where(.comments) .reply-form .textarea) {
        background-color: var(--surface-page);
        border-color: var(--border-subtle);
        color: var(--text-primary);

        &::placeholder {
          color: var(--text-muted);
        }
      }

      :global(:where(.comments) .reply-status[data-status="success"]) {
        color: var(--color-success-bright);
      }
    }

    @keyframes comments-fade-out {
      from {
        opacity: 1;
        transform: translateY(0);
      }
      to {
        opacity: 0;
        transform: translateY(-6px);
      }
    }

    @keyframes comments-fade-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    :global(#comments-list.fading) {
      animation: comments-fade-out 0.2s ease forwards;
    }

    :global(#comments-list.entering) {
      animation: comments-fade-in 0.25s ease forwards;
    }

    .form {
      padding-top: 0.5rem;

      .label {
        color: var(--text-primary);
        font-weight: 600;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .input,
      .textarea {
        background-color: var(--surface-elevated);
        border-color: var(--border-subtle);
        color: var(--text-primary);
        border-radius: var(--radius-tight);

        &:focus {
          border-color: var(--accent-primary);
          box-shadow: 0 0 0 2px rgba(var(--accent-primary-rgb), 0.15);
        }
      }

