<footer class="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__intro">
        <p class="footer__eyebrow">Sourcier</p>
        <p class="footer__summary">
          Practical software engineering guidance for people breaking into tech,
          engineers growing in confidence, and teams improving engineering
          practice.
        </p>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">&copy; 2026 Roger Rajaratnam</p>
      <nav class="footer__links" aria-label="Footer links">
        <a class="footer__link" href="/guides">Guides</a>
        <a class="footer__link" href="/courses">Courses</a>
        <a class="footer__link" href="/projects">Projects</a>
        <a class="footer__link" href="/blog">Blog</a>
        <a class="footer__link" href="/about">About</a>
        <a class="footer__link" href="/charity-support">Charity support</a>
        <a class="footer__link" href="/contact">Contact</a>
        <a class="footer__link" href="/rss.xml">RSS feed</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse 80% 70% at 18% 0%,
        rgba(var(--accent-primary-rgb), 0.18) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 70% 60% at 85% 0%,
        color-mix(in srgb, var(--accent-secondary) 18%, transparent) 0%,
        transparent 58%
      ),
      linear-gradient(
        180deg,
        var(--surface-footer-top) 0%,
        var(--surface-footer-bottom) 100%
      );
    color: rgba(var(--text-on-strong-rgb), 0.64);
    /* Extra bottom clearance keeps the fixed page-menu button (bottom-right, */
    /* ~84px tall footprint on desktop) from overlapping the footer links. */
    padding: 3rem 1.5rem 6.5rem;

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(
        circle,
        rgba(var(--text-on-strong-rgb), 0.12) 1px,
        transparent 1px
      );
      background-size: 28px 28px;
      mask-image: radial-gradient(
        ellipse 90% 90% at 50% 50%,
        black 30%,
        transparent 90%
      );
      -webkit-mask-image: radial-gradient(
        ellipse 90% 90% at 50% 50%,
        black 30%,
        transparent 90%
      );
      opacity: 0.3;
      pointer-events: none;
    }
  }

  .footer__inner {
    position: relative;
    z-index: 1;
    max-width: 75rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.35rem);
  }

  .footer__top {
    display: flex;
    justify-content: center;
  }

  .footer__intro {
    display: grid;
    gap: 0.6rem;
    max-width: 39rem;
    margin: 0 auto;
    text-align: center;
  }

  .footer__eyebrow {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
  }

  .footer__summary {
    margin: 0;
    max-width: 36rem;
    margin-inline: auto;
    font-size: 1.02rem;
    line-height: 1.8;
    color: rgba(var(--text-on-strong-rgb), 0.76);
  }

  .footer__bottom {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-top: 1.1rem;
    margin-top: 0;

    @media (min-width: 768px) {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer__bottom::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 1px;
    background: rgba(var(--text-on-strong-rgb), 0.08);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .footer__copy {
    font-size: 0.82rem;
    color: rgba(var(--text-on-strong-rgb), 0.38);
    margin: 0;
    text-align: center;
  }

  .footer__links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.5rem 0.8rem;
    border-radius: var(--radius-pill);
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(var(--text-on-strong-rgb), 0.75);
    text-decoration: none;
    background: rgba(var(--text-on-strong-rgb), 0.04);
    border: 1px solid rgba(var(--text-on-strong-rgb), 0.08);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;

    &:hover,
    &:focus-visible {
      color: var(--accent-primary);
      border-color: rgba(var(--accent-primary-rgb), 0.28);
      background: rgba(var(--accent-primary-rgb), 0.08);
      transform: translateY(-1px);
    }
  }

  @media (max-width: 767px) {
    .footer {
      padding-top: 2.65rem;
      padding-bottom: 6rem;
    }

    .footer__inner {
      gap: 1.35rem;
    }

    .footer__intro {
      gap: 0.7rem;
    }

    .footer__bottom {
      gap: 0.9rem;
      padding-top: 1.05rem;
    }

    .footer__links {
      width: 100%;
    }

    .footer__link {
      min-height: 2.5rem;
    }
  }
</style>
