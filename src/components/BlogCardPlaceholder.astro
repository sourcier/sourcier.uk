<div class="blog-card" data-placeholder aria-hidden="true">
  <div class="inner">
    <span class="caption">More posts coming soon</span>
  </div>
</div>

<style>
  .blog-card:where([data-placeholder]) {
    pointer-events: none;
    border: 2px dashed var(--accent-secondary-alpha-22);
    border-top-color: var(--accent-secondary-alpha-32);
    background: color-mix(
      in srgb,
      var(--accent-secondary) 4%,
      var(--surface-elevated)
    );
    box-shadow: none;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 2rem 1.5rem;
  }

  .caption {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--text-muted) 45%, transparent);
  }
</style>
