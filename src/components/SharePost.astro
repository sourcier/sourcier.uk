---
import { faLinkedin, faRedditAlien } from "@fortawesome/free-brands-svg-icons";
import { faLink, faEnvelope } from "@fortawesome/free-solid-svg-icons";
import { faIcon } from "../utils/icons";

interface Props {
  title: string;
  url: string;
  vertical?: boolean;
  variant?: "default" | "hero" | "sidebar" | "menu";
}

const { title, url, vertical = false, variant = "default" } = Astro.props;

const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
const redditUrl = `https://www.reddit.com/submit?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`;
const emailBody = `I thought you might find this interesting:\n\n"${title}"\n\n${url}`;
const emailUrl = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(emailBody)}`;

const linkedinIcon = faIcon(faLinkedin, { size: 16 });
const redditIcon = faIcon(faRedditAlien, { size: 16 });
const linkIcon = faIcon(faLink, { size: 16 });
const emailIcon = faIcon(faEnvelope, { size: 16 });
---

<div
  class="share-post"
  data-variant={variant}
  data-vertical={vertical || undefined}
>
  <span class="caption">Share this post</span>
  <div class="buttons">
    <a
      href={linkedinUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share"
      aria-label="Share on LinkedIn"
      title="Share on LinkedIn"
    >
      <span class="icon">
        <Fragment set:html={linkedinIcon} />
      </span>
      <span class="text">LinkedIn</span>
    </a>
    <a
      href={redditUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share"
      aria-label="Share on Reddit"
      title="Share on Reddit"
    >
      <span class="icon">
        <Fragment set:html={redditIcon} />
      </span>
      <span class="text">Reddit</span>
    </a>
    <a
      href={emailUrl}
      class="share"
      aria-label="Share by email"
      title="Share by email"
    >
      <span class="icon">
        <Fragment set:html={emailIcon} />
      </span>
      <span class="text">Email</span>
    </a>
    <button
      type="button"
      class="share"
      data-copy-link-btn
      aria-label="Copy link"
      data-url={url}
      title="Copy link"
    >
      <span class="icon copy-link-icon" set:html={linkIcon} />
      <span class="text copy-link-label">Copy link</span>
    </button>
  </div>
</div>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-link-btn]")
    .forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";

      btn.addEventListener("click", async () => {
        const url = btn.dataset.url ?? window.location.href;

        try {
          await navigator.clipboard.writeText(url);
        } catch {
          window.prompt("Copy this link", url);
        }

        const label = btn.querySelector(".copy-link-label");
        if (label) {
          btn.setAttribute("aria-label", "Link copied");
          btn.setAttribute("title", "Link copied");
          label.textContent = "Copied!";
          setTimeout(() => {
            label.textContent = "Copy link";
            btn.setAttribute("aria-label", "Copy link");
            btn.setAttribute("title", "Copy link");
          }, 2000);
        }
      });
    });
</script>

<style>
  .share-post {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin: 2.5rem 0;

    @media (max-width: 639px) {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    &:where([data-vertical]) {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      border-top: 2px solid var(--accent-primary);
      border-bottom: none;
      padding-top: 1.25rem;
      padding-bottom: 0;
      margin: 2rem 0 2rem;

      .buttons {
        flex-direction: column;
        width: 100%;
      }

      .share {
        width: 100%;
        justify-content: flex-start;
      }
    }

    &:where([data-variant="hero"]) {
      align-items: flex-start;
      gap: 0.75rem;
      padding: 1.15rem 0 0;
      margin: 1.15rem 0 0;
      border-top: 1px solid rgba(var(--overlay-rgb), 0.12);
      border-bottom: none;

      .caption {
        color: color-mix(in srgb, var(--text-primary) 72%, transparent);
      }

      .buttons {
        gap: 0.45rem;
      }

      .share {
        border-color: color-mix(
          in srgb,
          rgba(var(--overlay-rgb), 0.16) 35%,
          var(--border-subtle)
        );
        background: color-mix(
          in srgb,
          var(--surface-elevated) 76%,
          rgba(var(--overlay-rgb), 0.08)
        );
        color: color-mix(in srgb, var(--text-primary) 84%, transparent);
        backdrop-filter: blur(8px);

        &:hover {
          color: var(--accent-primary);
          border-color: color-mix(
            in srgb,
            var(--accent-primary) 28%,
            transparent
          );
          background: color-mix(
            in srgb,
            var(--accent-primary) 9%,
            rgba(var(--overlay-rgb), 0.04)
          );
        }
      }

      @media (max-width: 1023px) {
        flex-direction: column;
        align-items: flex-start;

        .buttons {
          width: 100%;
        }
      }
    }

    &:where([data-variant="sidebar"]) {
      flex-direction: column;
      align-items: stretch;
      gap: 0.9rem;
      margin: 1.5rem 0 1.75rem;
      padding: 1rem;
      border: 1px solid
        color-mix(in srgb, var(--accent-secondary) 14%, var(--border-subtle));
      border-radius: var(--radius-panel);
      background:
        radial-gradient(
          circle at 100% 0%,
          color-mix(in srgb, var(--accent-secondary) 10%, transparent) 0%,
          transparent 44%
        ),
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--surface-elevated) 96%, white) 0%,
          var(--surface-elevated) 100%
        ),
        var(--surface-elevated);
      box-shadow: 0 14px 30px rgba(var(--shadow-rgb), 0.05);

      .caption {
        color: var(--accent-secondary);
      }

      .buttons {
        flex-direction: column;
        width: 100%;
      }

      .share {
        width: 100%;
        justify-content: flex-start;
        padding: 0.55rem 0.75rem;
        border-color: color-mix(
          in srgb,
          rgba(var(--overlay-rgb), 0.16) 35%,
          var(--border-subtle)
        );
        background: color-mix(
          in srgb,
          var(--surface-elevated) 84%,
          rgba(var(--overlay-rgb), 0.03)
        );
        color: color-mix(in srgb, var(--text-primary) 84%, transparent);

        &:hover {
          color: var(--accent-primary);
          border-color: color-mix(
            in srgb,
            var(--accent-primary) 28%,
            transparent
          );
          background: color-mix(
            in srgb,
            var(--accent-primary) 7%,
            rgba(var(--overlay-rgb), 0.03)
          );
        }
      }
    }

    &:where([data-variant="menu"]) {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      margin: 0;
      padding: 0;
      border: 0;

      .caption {
        color: var(--accent-primary);
      }

      .buttons {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        width: 100%;
        gap: 0.45rem;
      }

      .share {
        width: 100%;
        min-height: 2.3rem;
        justify-content: flex-start;
        padding: 0.5rem 0.7rem;
        border-color: color-mix(
          in srgb,
          rgba(var(--overlay-rgb), 0.16) 35%,
          var(--border-subtle)
        );
        background: color-mix(
          in srgb,
          var(--surface-elevated) 84%,
          rgba(var(--overlay-rgb), 0.03)
        );
        color: color-mix(in srgb, var(--text-primary) 84%, transparent);

        &:hover {
          color: var(--accent-primary);
          border-color: color-mix(
            in srgb,
            var(--accent-primary) 28%,
            transparent
          );
          background: color-mix(
            in srgb,
            var(--accent-primary) 7%,
            rgba(var(--overlay-rgb), 0.03)
          );
        }
      }
    }
  }

  .caption {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .share {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-tight);
    background: transparent;
    color: var(--text-muted);
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.75rem;

    @media (max-width: 639px) {
      font-size: 0.8rem;
      padding: 0.4rem 0.75rem;
    }
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;

    svg {
      display: block;
    }

    &:hover {
      color: var(--accent-primary);
      border-color: var(--accent-primary);
      background-color: rgba(var(--accent-primary-rgb), 0.05);
    }
  }
</style>
