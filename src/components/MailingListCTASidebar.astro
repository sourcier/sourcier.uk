---

---

<div class="sidebar-subscribe" aria-labelledby="sidebar-subscribe-heading">
  <p class="sidebar-subscribe__kicker">Free · Practical · One email per post</p>
  <p class="sidebar-subscribe__heading" id="sidebar-subscribe-heading">
    Get practical software engineering notes
  </p>
  <p class="sidebar-subscribe__body">
    Useful if you are transitioning into tech, trying to grow as an engineer, or
    working on stronger engineering practice across your team.
  </p>

  <form id="sidebar-subscribe-form" novalidate aria-label="Newsletter sign up">
    <p class="sidebar-subscribe__honeypot" aria-hidden="true">
      <label for="sidebar-subscribe-website">Leave this blank</label>
      <input
        id="sidebar-subscribe-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </p>
    <label for="sidebar-subscribe-email" class="visually-hidden"
      >Email address</label
    >
    <input
      id="sidebar-subscribe-email"
      name="email"
      type="email"
      class="sidebar-subscribe__input"
      placeholder="your@email.com"
      autocomplete="email"
      required
    />
    <button type="submit" class="sidebar-subscribe__btn">
      Join the list
    </button>
    <p
      class="sidebar-subscribe__feedback"
      id="sidebar-subscribe-feedback"
      aria-live="polite"
      hidden
    >
    </p>
  </form>
</div>

<script>
  import { bindSubscribeForm } from "../utils/subscribeForm";

  bindSubscribeForm({
    formId: "sidebar-subscribe-form",
    emailId: "sidebar-subscribe-email",
    feedbackClass: "sidebar-subscribe__feedback",
    feedbackSuccessClass: "sidebar-subscribe__feedback--success",
    feedbackErrorClass: "sidebar-subscribe__feedback--error",
    successLabel: "You're subscribed! Check your inbox for a confirmation.",
    defaultButtonLabel: "Join the list",
  });
</script>

<style>
  .sidebar-subscribe {
    margin-top: 2rem;
    padding: 1.25rem;
    background-color: var(--text-primary);
    border-radius: var(--radius-compact);
    border-top: 3px solid var(--accent-primary);
    border-left: 1px solid var(--text-on-strong-alpha-06);
    border-right: 1px solid var(--text-on-strong-alpha-06);
    border-bottom: 1px solid var(--text-on-strong-alpha-06);
  }

  .sidebar-subscribe__kicker {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-primary);
    margin-bottom: 0.4rem;
  }

  .sidebar-subscribe__heading {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--text-on-strong);
    line-height: 1.15;
    margin-bottom: 0.6rem;
  }

  .sidebar-subscribe__body {
    font-size: 0.8125rem;
    color: rgba(var(--text-on-strong-rgb), 0.55);
    line-height: 1.5;
    margin-bottom: 0.9rem;
  }

  .sidebar-subscribe__input {
    display: block;
    width: 100%;
    padding: 0.4rem 0.6rem;
    font-size: 0.875rem;
    color: var(--text-on-strong);
    background-color: rgba(var(--text-on-strong-rgb), 0.08);
    border: 1px solid rgba(var(--text-on-strong-rgb), 0.15);
    border-radius: var(--radius-tight);
    margin-bottom: 0.5rem;
    outline: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;

    &::placeholder {
      color: rgba(var(--text-on-strong-rgb), 0.35);
    }

    &:focus {
      border-color: var(--accent-primary);
      box-shadow: 0 0 0 2px rgba(var(--accent-primary-rgb), 0.2);
    }
  }

  .sidebar-subscribe__btn {
    display: block;
    width: 100%;
    padding: 0.45rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-on-strong);
    background-color: var(--accent-primary);
    border: none;
    border-radius: var(--radius-tight);
    cursor: pointer;
    transition: background-color 0.15s ease;

    &:hover:not(:disabled) {
      background-color: var(--accent-primary-deep);
    }

    &:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }
  }

  .sidebar-subscribe__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .sidebar-subscribe__feedback {
    margin-top: 0.5rem;
    font-size: 0.8125rem;

    &:where(.sidebar-subscribe__feedback--success) {
      color: var(--color-success-bright);
    }

    &:where(.sidebar-subscribe__feedback--error) {
      color: var(--color-danger-bright);
    }
  }
</style>
