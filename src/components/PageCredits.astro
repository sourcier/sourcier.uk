---
interface CreditEntry {
  label: string;
  text: string;
  url?: string;
}

interface Props {
  entries: CreditEntry[];
}

const { entries } = Astro.props;
---

<div class="page-credits">
  <p class="heading">Credits</p>
  <ul class="list" role="list">
    {
      entries.map((entry) => (
        <li class="item">
          <span class="caption">{entry.label}</span>
          {entry.url ? (
            <a
              class="value"
              href={entry.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {entry.text}
            </a>
          ) : (
            <span class="value">{entry.text}</span>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .page-credits {
    min-width: 0;
  }

  .heading {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }

  .list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-tight);
    font-size: 0.75rem;
    line-height: 1.3;

    @media (max-width: 639px) {
      font-size: 0.8rem;
      padding: 0.4rem 0.75rem;
    }
    transition: border-color 0.15s ease;

    &:has(a):hover {
      border-color: var(--accent-primary);
      cursor: pointer;
    }
  }

  .caption {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);

    &::after {
      content: "·";
      margin: 0 0.3rem;
      opacity: 0.4;
    }
  }

  .value {
    color: var(--text-muted);
    text-decoration: none;

    .item:has(a):hover & {
      color: var(--accent-primary);
    }
  }
</style>
