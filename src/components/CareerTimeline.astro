---
import { faSquareCaretDown } from "@fortawesome/free-solid-svg-icons";
import { faIcon } from "../utils/icons";

const careerToggleIcon = faIcon(faSquareCaretDown, {
  size: 12,
  class: "career-timeline__more-icon",
});
---

<section
  class="content-section flow-section"
  aria-labelledby="career-section-title"
>
  <div class="layout-container layout-container-narrow">
    <h2 class="career-section-title" id="career-section-title">
      Experience across mentoring, delivery, and team leadership
    </h2>
    <p class="career-section-intro">
      My background spans hands-on software engineering, teaching career
      changers, mentoring growing engineers, and helping product teams deliver
      with more confidence.
    </p>
  </div>
  <div class="career-timeline">
    <div class="career-timeline__track">
      <div class="career-timeline__header" aria-hidden="true">
        <span>Present</span>
      </div>

      <ul class="career-timeline__list">
        <li class="career-timeline__item" aria-current="true">
          <div class="career-timeline__marker"></div>
          <div class="career-timeline__content">
            <p class="career-timeline__period">Apr 2026 — Present</p>
            <p class="career-timeline__role">Staff Engineer</p>
            <p class="career-timeline__company">NewDay · Full-time · London</p>
          </div>
        </li>

        <li class="career-timeline__item">
          <div class="career-timeline__marker"></div>
          <div class="career-timeline__content">
            <p class="career-timeline__period">2024 — Apr 2026</p>
            <p class="career-timeline__role">Technical Lead</p>
            <p class="career-timeline__company">NewDay · Full-time · London</p>
          </div>
        </li>

        <li class="career-timeline__item">
          <div class="career-timeline__marker"></div>
          <div class="career-timeline__content">
            <p class="career-timeline__period">2024</p>
            <p class="career-timeline__role">Senior Software Engineer</p>
            <p class="career-timeline__company">NewDay · Full-time · London</p>
          </div>
        </li>

        <li class="career-timeline__item">
          <div class="career-timeline__marker"></div>
          <div class="career-timeline__content">
            <p class="career-timeline__period">2023 — 2024</p>
            <p class="career-timeline__role">Full-Stack Bootcamp Instructor</p>
            <p class="career-timeline__company">
              The Jump Digital School · Contract · Remote
            </p>
          </div>
        </li>

        <li class="career-timeline__item">
          <div class="career-timeline__marker"></div>
          <div class="career-timeline__content">
            <p class="career-timeline__period">2023</p>
            <p class="career-timeline__role">Senior Software Engineer</p>
            <p class="career-timeline__company">
              IWSR Drinks Market Analysis · Contract · Remote
            </p>
          </div>
        </li>

        <li class="career-timeline__item">
          <div class="career-timeline__marker"></div>
          <div class="career-timeline__content">
            <p class="career-timeline__period">2023</p>
            <p class="career-timeline__role">Senior Software Engineer</p>
            <p class="career-timeline__company">ammonite · Contract · Remote</p>
          </div>
        </li>

        <li class="career-timeline__item">
          <div class="career-timeline__marker"></div>
          <div class="career-timeline__content">
            <p class="career-timeline__period">2021 — 2023</p>
            <p class="career-timeline__role">Senior Software Engineer</p>
            <p class="career-timeline__company">NewDay · Contract · Remote</p>
          </div>
        </li>

        <li class="career-timeline__item">
          <div class="career-timeline__marker"></div>
          <div class="career-timeline__content">
            <p class="career-timeline__period">2021</p>
            <p class="career-timeline__role">Senior Software Engineer</p>
            <p class="career-timeline__company">Sylvera · Contract · Remote</p>
          </div>
        </li>

        <li class="career-timeline__item">
          <div class="career-timeline__marker"></div>
          <div class="career-timeline__content">
            <p class="career-timeline__period">2021</p>
            <p class="career-timeline__role">Senior Software Engineer</p>
            <p class="career-timeline__company">
              Caution Your Blast · Contract · Remote
            </p>
          </div>
        </li>
      </ul>

      <div id="career-older" class="career-timeline__older" hidden>
        <ul class="career-timeline__list">
          <li class="career-timeline__item">
            <div class="career-timeline__marker"></div>
            <div class="career-timeline__content">
              <p class="career-timeline__period">2019 — 2021</p>
              <p class="career-timeline__role">Senior Software Engineer</p>
              <p class="career-timeline__company">
                JustGiving · Contract · Remote
              </p>
            </div>
          </li>

          <li class="career-timeline__item">
            <div class="career-timeline__marker"></div>
            <div class="career-timeline__content">
              <p class="career-timeline__period">2018 — 2019</p>
              <p class="career-timeline__role">Senior Software Engineer</p>
              <p class="career-timeline__company">Karhoo · Contract · Remote</p>
            </div>
          </li>

          <li class="career-timeline__item">
            <div class="career-timeline__marker"></div>
            <div class="career-timeline__content">
              <p class="career-timeline__period">2018</p>
              <p class="career-timeline__role">Senior Software Engineer</p>
              <p class="career-timeline__company">
                XenZone · Contract · Remote
              </p>
            </div>
          </li>

          <li class="career-timeline__item">
            <div class="career-timeline__marker"></div>
            <div class="career-timeline__content">
              <p class="career-timeline__period">2017 — 2018</p>
              <p class="career-timeline__role">Senior Software Engineer</p>
              <p class="career-timeline__company">
                Financial Times · Contract · Remote
              </p>
            </div>
          </li>

          <li class="career-timeline__item">
            <div class="career-timeline__marker"></div>
            <div class="career-timeline__content">
              <p class="career-timeline__period">2017</p>
              <p class="career-timeline__role">Senior Software Engineer</p>
              <p class="career-timeline__company">
                GuideSmiths · Contract · Remote
              </p>
            </div>
          </li>

          <li class="career-timeline__item">
            <div class="career-timeline__marker"></div>
            <div class="career-timeline__content">
              <p class="career-timeline__period">2016 — 2017</p>
              <p class="career-timeline__role">Senior Software Engineer</p>
              <p class="career-timeline__company">
                Channel 4 · Contract · Remote
              </p>
            </div>
          </li>

          <li class="career-timeline__item">
            <div class="career-timeline__marker"></div>
            <div class="career-timeline__content">
              <p class="career-timeline__period">2014 — 2016</p>
              <p class="career-timeline__role">Senior Software Engineer</p>
              <p class="career-timeline__company">
                Bauer Media Group · Contract · Remote
              </p>
            </div>
          </li>

          <li class="career-timeline__item">
            <div class="career-timeline__marker"></div>
            <div class="career-timeline__content">
              <p class="career-timeline__period">2012 — 2014</p>
              <p class="career-timeline__role">Senior Software Engineer</p>
              <p class="career-timeline__company">
                Into Film · Contract · Remote
              </p>
            </div>
          </li>

          <li class="career-timeline__item">
            <div class="career-timeline__marker"></div>
            <div class="career-timeline__content">
              <p class="career-timeline__period">2007 — 2012</p>
              <p class="career-timeline__role">Senior Software Engineer</p>
              <p class="career-timeline__company">
                Sony BMG · Full-time · Germany &amp; Dubai
              </p>
            </div>
          </li>

          <li class="career-timeline__item">
            <div class="career-timeline__marker"></div>
            <div class="career-timeline__content">
              <p class="career-timeline__period">2005 — 2007</p>
              <p class="career-timeline__role">Software Engineer</p>
              <p class="career-timeline__company">
                William Hill · Full-time · Leeds
              </p>
            </div>
          </li>
        </ul>

        <div class="career-timeline__header" aria-hidden="true">
          <span>Education</span>
        </div>

        <ul class="career-timeline__list">
          <li class="career-timeline__item">
            <div class="career-timeline__marker"></div>
            <div class="career-timeline__content">
              <p class="career-timeline__period">2002 — 2005</p>
              <p class="career-timeline__role">
                BSc Computer Software Engineering
              </p>
              <p class="career-timeline__company">University of Westminster</p>
            </div>
          </li>
        </ul>
      </div><!-- /#career-older -->
    </div><!-- /.career-timeline__track -->

    <div class="career-timeline__more">
      <button
        class="career-timeline__more-btn"
        type="button"
        aria-expanded="false"
        aria-controls="career-older"
      >
        Show full history
        <span set:html={careerToggleIcon} />
      </button>
    </div>
  </div>

  <style>
    .career-section-title {
      font-family: "Barlow Condensed", sans-serif;
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      font-weight: 800;
      letter-spacing: -0.01em;
      color: var(--text-primary);
      margin-bottom: 1rem;

      @media (min-width: 640px) {
        text-align: center;
      }
    }

    .career-section-intro {
      max-width: 60ch;
      margin: 0 auto 2.5rem;
      color: var(--text-muted);
      line-height: 1.7;

      @media (min-width: 640px) {
        text-align: center;
      }
    }

    .career-timeline {
      position: relative;
      max-width: 780px;
      margin: 0 auto;
      padding: 0 1.5rem 1.5rem;
    }

    .career-timeline__track {
      position: relative;

      &::before {
        content: "";
        position: absolute;
        left: 10px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--border-subtle);

        @media (min-width: 640px) {
          left: 50%;
          transform: translateX(-50%);
        }
      }
    }

    .career-timeline__list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .career-timeline__header {
      text-align: left;
      position: relative;
      margin-bottom: 3rem;

      @media (min-width: 640px) {
        text-align: center;
      }

      span {
        display: inline-block;
        background: var(--accent-primary);
        color: var(--text-on-strong);
        font-family: "Barlow Condensed", sans-serif;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        padding: 0.35rem 1rem;
        margin-left: 11px;
        transform: translateX(-50%);

        @media (min-width: 640px) {
          margin-left: 0;
          transform: none;
        }
      }
    }

    .career-timeline__item {
      position: relative;
      padding-left: calc(1.5rem + 36px);
      margin-bottom: clamp(1.75rem, 3vw, 2.15rem);

      @media (min-width: 640px) {
        width: 50%;
        padding-left: 0;
        padding-right: 3rem;

        &:nth-child(even) {
          margin-left: 50%;
          padding-right: 0;
          padding-left: 3rem;
        }
      }
    }

    .career-timeline__marker {
      position: absolute;
      left: -1px;
      top: 4px;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--surface-elevated);
      border: 2px solid var(--accent-primary);
      z-index: 1;
      transition:
        background-color 0.18s ease,
        box-shadow 0.18s ease;

      .career-timeline__item:hover & {
        background: var(--accent-primary);
        box-shadow: var(--shadow-accent-primary-focus);
      }

      .career-timeline__item:where([aria-current="true"]) & {
        background: var(--accent-primary);
        box-shadow: var(--shadow-accent-primary-focus);
      }

      @media (min-width: 640px) {
        left: auto;
        right: -11px;
      }
    }

    .career-timeline__item:nth-child(even) .career-timeline__marker {
      @media (min-width: 640px) {
        right: auto;
        left: -11px;
      }
    }

    .career-timeline__content {
      background:
        linear-gradient(
          160deg,
          color-mix(in srgb, var(--accent-primary) 4%, var(--surface-elevated))
            0%,
          var(--surface-elevated) 62%
        ),
        var(--surface-elevated);
      border: 1px solid var(--border-subtle);
      border-top: 3px solid var(--accent-primary-alpha-24);
      border-radius: var(--radius-panel);
      padding: 1.25rem 1.5rem;
      box-shadow: var(--shadow-panel);
      transition:
        transform 0.18s ease,
        box-shadow 0.18s ease;

      &:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lift);
      }
    }

    .career-timeline__item:nth-child(even) .career-timeline__content {
      background:
        linear-gradient(
          160deg,
          color-mix(
              in srgb,
              var(--accent-secondary) 6%,
              var(--surface-elevated)
            )
            0%,
          var(--surface-elevated) 62%
        ),
        var(--surface-elevated);
      border-top-color: var(--accent-secondary-alpha-24);
    }

    .career-timeline__period {
      font-family: "Barlow Condensed", sans-serif;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent-primary);
      margin-bottom: 0.4rem;
    }

    .career-timeline__role {
      font-family: "Barlow Condensed", sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
      line-height: 1.2;
      color: var(--text-primary);
      margin-bottom: 0.2rem;
    }

    .career-timeline__company {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 0.75rem;
    }

    .career-timeline__more {
      display: flex;
      justify-content: center;
      padding: 0.5rem 0 0.5rem;
    }

    .career-timeline__more-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: "Barlow Condensed", sans-serif;
      font-size: 0.8125rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
      background: none;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-tight);
      padding: 0.6rem 1.25rem;
      cursor: pointer;
      transition:
        color 0.15s ease,
        border-color 0.15s ease;

      :global(.career-timeline__more-icon) {
        transition: transform 0.2s ease;
      }

      &:hover {
        color: var(--accent-primary);
        border-color: var(--accent-primary);
      }

      &[aria-expanded="true"] :global(.career-timeline__more-icon) {
        transform: rotate(180deg);
      }
    }

    .career-timeline__older {
      &[hidden] {
        display: none;
      }
    }

    .career-timeline__description {
      font-size: 0.9rem;
      line-height: 1.7;
      color: var(--text-muted);
    }
  </style>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>(
    ".career-timeline__more-btn",
  );
  const older = document.getElementById("career-older");

  btn?.addEventListener("click", () => {
    const expanded = btn.getAttribute("aria-expanded") === "true";
    if (expanded) {
      older?.setAttribute("hidden", "");
      btn.setAttribute("aria-expanded", "false");
      btn.childNodes[0].textContent = "Show full history";
    } else {
      older?.removeAttribute("hidden");
      btn.setAttribute("aria-expanded", "true");
      btn.childNodes[0].textContent = "Hide full history";
    }
  });
</script>
