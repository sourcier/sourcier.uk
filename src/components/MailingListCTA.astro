---

---

<section class="mailing-cta stack-space stack-space--tight">
  <div class="layout-container layout-container-narrow">
    <div class="mailing-cta__card" aria-labelledby="mailing-cta-heading">
      <div class="mailing-cta__inner">
        <div class="mailing-cta__copy">
          <p class="mailing-cta__kicker">
            Free · Practical · One email per post
          </p>
          <h2 class="mailing-cta__heading" id="mailing-cta-heading">
            Get practical engineering notes
          </h2>
          <p class="mailing-cta__body">
            One short email when a new article goes live. Useful if you are
            breaking into tech, growing as an engineer, or improving engineering
            practice on your team.
          </p>
        </div>

        <form
          class="mailing-cta__form"
          id="mailing-cta-form"
          novalidate
          aria-label="Newsletter sign up"
        >
          <p class="mailing-cta__honeypot" aria-hidden="true">
            <label for="mailing-cta-website">Leave this blank</label>
            <input
              id="mailing-cta-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </p>
          <div class="mailing-cta__field">
            <label for="mailing-cta-email" class="mailing-cta__label">
              <span class="mailing-cta__label-title">Email for new posts</span>
              <span class="mailing-cta__label-note"
                >One short email when something practical goes live.</span
              >
            </label>
            <input
              id="mailing-cta-email"
              name="email"
              type="email"
              class="text-input mailing-cta__input"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
            <button type="submit" class="action-button mailing-cta__btn">
              Join the list
            </button>
          </div>
          <p
            class="mailing-cta__feedback"
            id="mailing-cta-feedback"
            aria-live="polite"
            hidden
          >
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { bindSubscribeForm } from "../utils/subscribeForm";

  bindSubscribeForm({
    formId: "mailing-cta-form",
    emailId: "mailing-cta-email",
    feedbackClass: "mailing-cta__feedback",
    feedbackSuccessClass: "mailing-cta__feedback--success",
    feedbackErrorClass: "mailing-cta__feedback--error",
    successLabel: "You're subscribed! Check your inbox for a confirmation.",
    defaultButtonLabel: "Join the list",
  });
</script>

<style>
  .mailing-cta {
    padding: 0 1.5rem 3rem;
  }

  .mailing-cta__card {
    --mailing-cta-surface-top: #121714;
    --mailing-cta-surface-bottom: #09100d;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-panel);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-top: 3px solid var(--accent-secondary);
    border-left: 1px solid rgba(var(--text-on-strong-rgb), 0.06);
    border-right: 1px solid rgba(var(--text-on-strong-rgb), 0.06);
    border-bottom: 1px solid rgba(var(--text-on-strong-rgb), 0.06);
    background:
      radial-gradient(
        ellipse 95% 85% at 100% 0%,
        color-mix(in srgb, var(--accent-secondary) 42%, transparent) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 70% 60% at 0% 0%,
        rgba(var(--accent-primary-rgb), 0.08) 0%,
        transparent 52%
      ),
      linear-gradient(
        180deg,
        var(--mailing-cta-surface-top) 0%,
        var(--mailing-cta-surface-bottom) 100%
      );
    box-shadow: 0 24px 48px rgba(var(--overlay-rgb), 0.24);

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(
        circle,
        rgba(var(--text-on-strong-rgb), 0.12) 1px,
        transparent 1px
      );
      background-size: 28px 28px;
      mask-image: radial-gradient(
        ellipse 90% 90% at 50% 50%,
        black 30%,
        transparent 90%
      );
      -webkit-mask-image: radial-gradient(
        ellipse 90% 90% at 50% 50%,
        black 30%,
        transparent 90%
      );
      opacity: 0.3;
      pointer-events: none;
    }
  }

  .mailing-cta__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;

    @media (min-width: 768px) {
      flex-direction: row;
      align-items: center;
      gap: 3rem;
    }
  }

  .mailing-cta__copy {
    flex: 1;
    max-width: 40rem;
  }

  .mailing-cta__kicker {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(
      in srgb,
      var(--accent-secondary) 72%,
      var(--text-on-strong) 28%
    );
    margin-bottom: 0.4rem;
  }

  .mailing-cta__heading {
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text-on-strong);
    margin-bottom: 0.5rem;
  }

  .mailing-cta__body {
    color: rgba(var(--text-on-strong-rgb), 0.72);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }

  .mailing-cta__form {
    flex-shrink: 0;
    width: 100%;
    padding: 1rem;
    border-radius: var(--radius-field);
    background: rgba(var(--text-on-strong-rgb), 0.05);
    border: 1px solid rgba(var(--text-on-strong-rgb), 0.1);
    backdrop-filter: blur(12px);

    @media (min-width: 768px) {
      width: 22rem;
    }
  }

  .mailing-cta__field {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mailing-cta__label {
    display: grid;
    gap: 0.2rem;
    margin: 0;
  }

  .mailing-cta__label-title {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-on-strong);
  }

  .mailing-cta__label-note {
    font-size: 0.8rem;
    line-height: 1.45;
    color: rgba(var(--text-on-strong-rgb), 0.68);
  }

  .mailing-cta__input {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
    height: 3rem;
    background-color: rgba(var(--text-on-strong-rgb), 0.08);
    border-color: rgba(var(--text-on-strong-rgb), 0.15);
    color: var(--text-on-strong);
    border-radius: var(--radius-tight);

    &::placeholder {
      color: rgba(var(--text-on-strong-rgb), 0.35);
    }

    &:focus {
      border-color: var(--accent-secondary);
      box-shadow: 0 0 0 2px
        color-mix(in srgb, var(--accent-secondary) 24%, transparent);
      outline: none;
    }
  }

  .mailing-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background-color: var(--text-on-strong);
    border-color: rgba(var(--text-on-strong-rgb), 0.92);
    color: var(--accent-secondary-deep);
    font-weight: 600;
    white-space: nowrap;
    min-height: 3rem;
    height: 3rem;
    box-shadow: 0 12px 24px rgba(var(--overlay-rgb), 0.24);

    &:hover:not(:disabled) {
      background-color: color-mix(
        in srgb,
        var(--text-on-strong) 92%,
        var(--accent-secondary) 8%
      );
      border-color: color-mix(
        in srgb,
        var(--text-on-strong) 92%,
        var(--accent-secondary) 8%
      );
      color: var(--accent-secondary-deep);
    }

    &:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }
  }

  .mailing-cta__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .mailing-cta__feedback {
    margin-top: 0.625rem;
    font-size: 0.875rem;

    &:where(.mailing-cta__feedback--success) {
      color: var(--color-success-bright);
    }

    &:where(.mailing-cta__feedback--error) {
      color: var(--color-danger-bright);
    }
  }
</style>
