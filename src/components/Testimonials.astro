---
import newdayLogo from "../../assets/images/newday-favicon.png";
import intofilmLogo from "../../assets/images/intofilm-favicon.png";
import { faLinkedin } from "@fortawesome/free-brands-svg-icons";
import { faPause, faPlay } from "@fortawesome/free-solid-svg-icons";
import { faIcon } from "../utils/icons";

const linkedinIcon = faIcon(faLinkedin, { size: 14 });
const pauseIcon = faIcon(faPause, { size: 11 });
const playIcon = faIcon(faPlay, { size: 11 });

const testimonials = [
  {
    quote:
      "Roger has been an exceptional tech lead and manager during my time at NewDay. He has a real ability to quickly unblock problems and create an environment where engineers can do their best work. He has been a great mentor to me and played a significant role in helping me progress from a mid-level to a senior engineer. I've learned a huge amount from working with him and really value the experience of having worked together.",
    name: "Gladwin Dosunmu",
    title: "Senior Engineer",
    company: "NewDay",
    logo: newdayLogo,
    website: "https://www.newday.co.uk",
    linkedin: "https://www.linkedin.com/in/gladwin-dosunmu-80691b107/",
  },
  {
    quote:
      "Roger is, without question, one of the best technologists I know—a genuine visionary who translates innovative ideas into real-world impact and helps define best practices. His leadership is calm, thoughtful, and earns respect at every level. What sets him apart most is his gift as a teacher and mentor; throughout my career he has been my go-to for complex technical challenges and important career decisions alike.",
    name: "Syed Shah",
    title: "Senior Security Engineer",
    linkedin: "https://www.linkedin.com/in/syed-shah-6a881917/",
  },
  {
    quote:
      "As a product designer I've enjoyed working with Roger on New Day's SaaS product Fusion. He's a collaborative engineering lead who is deeply engaged in problem solving and thinks outside the box to find the best solutions for both business and users. Easy to approach, calm and always happy to talk through ideas, Roger is a great colleague to work with.",
    name: "Elise Ten Cate",
    title: "Product Designer",
    company: "NewDay",
    logo: newdayLogo,
    website: "https://www.newday.co.uk",
    linkedin: "https://www.linkedin.com/in/elisabethtencate/",
  },
  {
    quote:
      "When we hired Roger a decade ago at Into Film, we couldn't decide between him and another candidate—so naturally, we took them both. Turns out Roger was worth it. As a principal software engineer, he solves problems I didn't even know existed, with a calm that makes the chaos of charity work look orderly. Ten years later, I still think hiring him was the smarter half of that indecision.",
    name: "Chris Breen",
    title: "Lead Engineer",
    company: "Into Film",
    logo: intofilmLogo,
    website: "https://www.intofilm.org",
    linkedin: "https://www.linkedin.com/in/chris-breen-b608aa42/",
  },
];
---

<section
  class="testimonials stack-space"
  aria-labelledby="testimonials-heading"
>
  <div class="container" data-width="narrow">
    <div class="header">
      <p
        class="section-label section-label--secondary"
        id="testimonials-heading"
      >
        Growth, mentoring, and team impact
      </p>
      <button
        class="pause-btn"
        type="button"
        aria-label="Pause slideshow"
        aria-pressed="false"
      >
        <span class="pause-icon" set:html={pauseIcon} />
        <span class="play-icon" set:html={playIcon} />
      </button>
    </div>

    <p class="intro">
      The feedback I hear most often is about calm leadership, helping engineers
      grow, and making teams work better together.
    </p>

    <div
      class="carousel"
      role="region"
      aria-roledescription="carousel"
      aria-label="Testimonials"
    >
      <div class="track-wrapper">
        <div class="track">
          {
            testimonials.map((t, i) => (
              <div
                class="item"
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${testimonials.length}`}
              >
                <blockquote class="quote">
                  <p>&ldquo;{t.quote}&rdquo;</p>
                </blockquote>
                <footer class="byline">
                  <div class="attribution">
                    <div>
                      <p class="name">
                        <span class="name-group">
                          <a
                            href={t.linkedin}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="name-link"
                          >
                            {t.name}
                          </a>
                          <a
                            href={t.linkedin}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="linkedin"
                            aria-label={`${t.name} on LinkedIn`}
                            set:html={linkedinIcon}
                          />
                        </span>
                      </p>
                      <p class="meta">
                        {t.title && t.company
                          ? `${t.title} · ${t.company}`
                          : (t.title ?? t.company)}
                      </p>
                    </div>
                    {t.logo && (
                      <a
                        href={t.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="logo-link"
                        aria-label={`Visit ${t.company} website`}
                      >
                        <img
                          src={t.logo.src}
                          alt={t.company}
                          class="logo"
                          width="64"
                          height="64"
                          loading="lazy"
                        />
                      </a>
                    )}
                  </div>
                </footer>
              </div>
            ))
          }
        </div>
      </div>

      <div class="dots" role="group" aria-label="Slide navigation">
        {
          testimonials.map((t, i) => (
            <button
              class="dot"
              type="button"
              aria-label={`Go to slide ${i + 1}: ${t.name}`}
              aria-current={i === 0 ? "true" : "false"}
              data-index={i}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>(".testimonials");
  if (section) {
    const track = section.querySelector<HTMLElement>(".track")!;
    const dots = section.querySelectorAll<HTMLButtonElement>(".dot");
    const pauseBtn = section.querySelector<HTMLButtonElement>(".pause-btn")!;
    const carousel = section.querySelector<HTMLElement>(".carousel")!;
    const total = dots.length;
    let current = 0;
    let paused = false;
    let timer: ReturnType<typeof setInterval> | null = null;

    function getLayout() {
      const wrapper = track.parentElement as HTMLElement;
      const items = track.querySelectorAll<HTMLElement>(".item");
      const wrapperWidth = wrapper.getBoundingClientRect().width;
      const itemWidth = items[0]?.getBoundingClientRect().width ?? wrapperWidth;
      let stepPct = 100;
      if (items.length > 1) {
        const r0 = items[0].getBoundingClientRect();
        const r1 = items[1].getBoundingClientRect();
        stepPct = ((r1.left - r0.left) / wrapperWidth) * 100;
      }
      const visible = Math.round(wrapperWidth / itemWidth);
      const maxIndex = Math.max(0, total - visible);
      return { stepPct, maxIndex };
    }

    function goTo(index: number) {
      const { stepPct, maxIndex } = getLayout();
      current = ((index % (maxIndex + 1)) + (maxIndex + 1)) % (maxIndex + 1);
      track.style.transform = `translateX(-${current * stepPct}%)`;
      dots.forEach((d, i) => {
        const hidden = i > maxIndex;
        d.classList.toggle("hidden", hidden);
        d.setAttribute("aria-current", i === current ? "true" : "false");
      });
    }

    function startTimer() {
      if (timer) clearInterval(timer);
      timer = setInterval(() => goTo(current + 1), 5000);
    }

    function stopTimer() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        goTo(parseInt(dot.dataset.index!, 10));
        stopTimer();
        if (!paused) startTimer();
      });
    });

    pauseBtn.addEventListener("click", () => {
      paused = !paused;
      pauseBtn.setAttribute("aria-pressed", String(paused));
      pauseBtn.setAttribute(
        "aria-label",
        paused ? "Play slideshow" : "Pause slideshow",
      );
      if (paused) stopTimer();
      else startTimer();
    });

    carousel.addEventListener("mouseenter", stopTimer);
    carousel.addEventListener("mouseleave", () => {
      if (!paused) startTimer();
    });
    carousel.addEventListener("focusin", stopTimer);
    carousel.addEventListener("focusout", (e) => {
      if (
        !carousel.contains((e as FocusEvent).relatedTarget as Node) &&
        !paused
      ) {
        startTimer();
      }
    });

    carousel.addEventListener("keydown", (e) => {
      const key = (e as KeyboardEvent).key;
      if (key === "ArrowLeft" || key === "ArrowRight") {
        goTo(key === "ArrowLeft" ? current - 1 : current + 1);
        stopTimer();
        if (!paused) startTimer();
      }
    });

    new ResizeObserver(() => goTo(current)).observe(track.parentElement!);

    goTo(0);

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      startTimer();
    }
  }
</script>

<style>
  .testimonials {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 3.5vw, 2.4rem) 1.5rem clamp(2rem, 3.5vw, 2.6rem);
    background:
      radial-gradient(
        ellipse 90% 70% at 100% 0%,
        color-mix(in srgb, var(--accent-secondary) 12%, transparent) 0%,
        transparent 62%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--accent-secondary) 4%, var(--surface-page)) 0%,
        var(--surface-elevated) 100%
      );
    border-top: 1px solid
      color-mix(in srgb, var(--border-subtle) 72%, transparent);
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;

    .section-label {
      margin-bottom: 0;
    }
  }

  .intro {
    max-width: 62ch;
    margin: 0 0 1.5rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .pause-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--accent-secondary) 4%, transparent);
    border: 1px solid
      color-mix(in srgb, var(--accent-secondary) 18%, transparent);
    border-radius: var(--radius-tight);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;

    .play-icon {
      display: none;
    }

    &[aria-pressed="true"] {
      .pause-icon {
        display: none;
      }
      .play-icon {
        display: flex;
      }
    }

    &:hover {
      color: var(--accent-secondary);
      border-color: color-mix(
        in srgb,
        var(--accent-secondary) 42%,
        transparent
      );
    }
  }

  .carousel {
    position: relative;
  }

  .track-wrapper {
    overflow: hidden;
  }

  .track {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .item {
    flex: 0 0 100%;
    min-width: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--accent-secondary);
    border-radius: var(--radius-panel);
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--accent-secondary) 8%, var(--surface-page)) 0%,
      var(--surface-page) 48%,
      var(--surface-page) 100%
    );
    box-shadow: var(--shadow-panel);

    @media (min-width: 640px) {
      flex: 0 0 calc(50% - 0.625rem);
    }
  }

  .quote {
    flex: 1;
    margin: 0 0 1.5rem;

    p {
      font-size: 0.9375rem;
      line-height: 1.8;
      color: var(--text-primary);
      margin: 0;
      font-style: italic;
    }
  }

  .byline {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
  }

  .attribution {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo {
    flex-shrink: 0;
    max-width: 64px;
    max-height: 32px;
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0.65;
    filter: grayscale(1);
    transition:
      opacity 0.18s ease,
      filter 0.18s ease;

    html[data-theme="dark"] & {
      filter: grayscale(1) invert(1);
    }
  }

  .item:hover .logo {
    opacity: 1;
    filter: grayscale(0);

    html[data-theme="dark"] & {
      filter: grayscale(0) invert(0);
    }
  }

  .name {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    margin: 0 0 0.2rem;
  }

  .name-group {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;

    &:hover .name-link {
      color: var(--accent-secondary);
    }

    &:hover .linkedin {
      color: var(--accent-secondary);
    }
  }

  .name-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .linkedin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--text-muted);
    transition: color 0.15s ease;
    flex-shrink: 0;
  }

  .meta {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
  }

  .dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding-top: 1.5rem;
  }

  .dot {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;

    &::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--border-subtle);
      transition:
        background 0.2s ease,
        transform 0.2s ease;
    }

    &[aria-current="true"]::after {
      background: var(--accent-secondary);
      transform: translate(-50%, -50%) scale(1.375);
    }

    &:hover:not([aria-current="true"])::after {
      background: var(--text-muted);
    }
  }
</style>
