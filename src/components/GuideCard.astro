---
import { getGuideIcon } from "../utils/contentIcons";

interface Props {
  slug: string;
  title: string;
  summary: string;
  href: string;
  publishedCount: number;
  plannedCount: number;
  /** Controls accent colour and card style. Defaults to "primary". */
  variant?: "primary" | "secondary";
  /** Suppress the post-count meta row (used on the homepage). */
  hideMeta?: boolean;
}

const {
  slug,
  title,
  summary,
  href,
  publishedCount,
  plannedCount,
  variant = "primary",
  hideMeta = false,
} = Astro.props;
---

<article class="guide-card" data-variant={variant}>
  <div class="header">
    <span class="icon" aria-hidden="true" set:html={getGuideIcon(slug, 18)} />
    <div class="heading-group">
      <h3 class="heading">{title}</h3>
    </div>
  </div>
  <p class="body">{summary}</p>
  {
    !hideMeta && (
      <div class="meta" aria-label="Guide coverage">
        <span>{publishedCount} published now</span>
        <span>{plannedCount} planned next</span>
      </div>
    )
  }
  <a class="cta" href={href}>Open the guide</a>
</article>

<style>
  .guide-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 100%;
    padding: 1.55rem 1.5rem 1.45rem;
    border-radius: var(--radius-panel);
    box-shadow: 0 14px 30px rgba(var(--shadow-rgb), 0.05);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 1.5rem;
      width: 3.6rem;
      height: 2px;
      pointer-events: none;
    }
  }

  /* ── primary variant (pink) ── */
  .guide-card:where([data-variant="primary"]) {
    border: 1px solid
      color-mix(in srgb, var(--accent-primary) 10%, var(--border-subtle));
    background:
      radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--accent-primary) 10%, transparent) 0%,
        transparent 42%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--surface-elevated) 95%, white) 0%,
        var(--surface-elevated) 100%
      ),
      var(--surface-elevated);

    &::before {
      background: linear-gradient(
        90deg,
        var(--accent-primary) 0%,
        transparent 100%
      );
    }

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 18px 34px rgba(var(--accent-primary-rgb), 0.1);
      border-color: rgba(var(--accent-primary-rgb), 0.26);
    }

    .icon {
      background: color-mix(
        in srgb,
        var(--surface-page) 82%,
        var(--accent-primary) 18%
      );
      color: var(--accent-primary);
    }

    .cta {
      color: var(--accent-primary);
    }

    .meta span {
      background: color-mix(in srgb, var(--accent-primary) 8%, transparent);
    }
  }

  /* ── secondary variant (green) ── */
  .guide-card:where([data-variant="secondary"]) {
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--accent-secondary);
    background:
      radial-gradient(
        circle at top right,
        color-mix(in srgb, var(--accent-secondary) 12%, transparent) 0%,
        transparent 32%
      ),
      linear-gradient(
        155deg,
        color-mix(in srgb, var(--accent-primary) 4%, var(--surface-elevated)) 0%,
        var(--surface-elevated) 58%
      ),
      var(--surface-elevated);
    box-shadow: var(--shadow-panel);

    &::before {
      display: none;
    }

    &:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
      border-color: var(--accent-secondary-alpha-24);
    }

    .icon {
      background: color-mix(
        in srgb,
        var(--surface-page) 82%,
        var(--accent-secondary) 18%
      );
      color: var(--accent-secondary);
    }

    .heading {
      text-transform: uppercase;
    }

    .cta {
      color: var(--accent-secondary);
    }

    .meta {
      font-family: "Barlow Condensed", sans-serif;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;

      span {
        padding: 0.3rem 0.55rem;
        border-radius: var(--radius-pill);
        background: color-mix(in srgb, var(--accent-secondary) 8%, transparent);
      }
    }
  }

  /* ── shared sub-element styles ── */
  .header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .heading-group {
    display: grid;
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-pill);
    flex-shrink: 0;

    :global(svg) {
      display: block;
    }
  }

  .heading {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.2rem;
    line-height: 1.1;
    color: var(--text-primary);
  }

  .body {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-family: "Barlow", sans-serif;
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text-muted);
  }

  .cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    padding-block: 0.75rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
</style>
