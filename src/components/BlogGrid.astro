---
import type { CollectionEntry } from "astro:content";
import BlogPost from "./BlogPost.astro";
import BlogCardPlaceholder from "./BlogCardPlaceholder.astro";
import readingTime from "reading-time";

interface Props {
  posts: CollectionEntry<"posts">[];
  currentPage: number;
  totalPages: number;
  prevUrl: string | null;
  nextUrl: string | null;
  paginationBase?: string;
  sectionLabel?: string;
  sectionTitle?: string;
  sectionDescription?: string;
}

const { posts, currentPage, totalPages, prevUrl, nextUrl, paginationBase } =
  Astro.props;

const showGhostCards = currentPage === totalPages;
const TABLET_COLS = 2;
const DESKTOP_COLS = 3;
const tabletGhostCount = showGhostCards
  ? (TABLET_COLS - (posts.length % TABLET_COLS)) % TABLET_COLS
  : 0;
const desktopGhostCount = showGhostCards
  ? (DESKTOP_COLS - (posts.length % DESKTOP_COLS)) % DESKTOP_COLS
  : 0;
const sharedGhostCount = Math.min(tabletGhostCount, desktopGhostCount);
const tabletOnlyGhostCount = tabletGhostCount - sharedGhostCount;
const desktopOnlyGhostCount = desktopGhostCount - sharedGhostCount;

function pageUrl(n: number) {
  if (paginationBase) {
    return n === 1 ? paginationBase : `${paginationBase}/${n}`;
  }
  return n === 1 ? "/blog" : `/blog/page/${n}`;
}
---

<section class="section blog-grid-section flow-section">
  <div class="container" data-width="narrow">
    {
      (Astro.props.sectionLabel || Astro.props.sectionTitle) && (
        <div class="header">
          {Astro.props.sectionLabel && (
            <p class="section-label">{Astro.props.sectionLabel}</p>
          )}
          {Astro.props.sectionTitle && (
            <h2 class="heading">{Astro.props.sectionTitle}</h2>
          )}
          {Astro.props.sectionDescription && (
            <p class="description">{Astro.props.sectionDescription}</p>
          )}
        </div>
      )
    }
    <div class="layout">
      {
        posts.map((post) => (
          <div class="cell">
            <BlogPost
              title={post.data.title}
              subTitle={post.data.subTitle}
              description={post.data.description}
              url={`/blog/${post.id}`}
              cover={post.data.cover}
              pubDate={post.data.pubDate}
              draft={post.data.draft}
              readingTime={readingTime(post.body ?? "").text}
            />
          </div>
        ))
      }
      {
        Array.from({ length: sharedGhostCount }).map(() => (
          <div class="cell ghost" data-viewport="tablet-up">
            <BlogCardPlaceholder />
          </div>
        ))
      }
      {
        Array.from({ length: tabletOnlyGhostCount }).map(() => (
          <div class="cell ghost" data-viewport="tablet-only">
            <BlogCardPlaceholder />
          </div>
        ))
      }
      {
        Array.from({ length: desktopOnlyGhostCount }).map(() => (
          <div class="cell ghost" data-viewport="desktop-only">
            <BlogCardPlaceholder />
          </div>
        ))
      }
    </div>

    {
      totalPages > 1 && (
        <nav class="pagination-nav" aria-label="Blog pagination">
          <a
            href={prevUrl}
            class="step"
            aria-disabled={!prevUrl}
            tabindex={!prevUrl ? -1 : 0}
          >
            &larr; Previous
          </a>

          <div class="pages" role="list">
            {Array.from({ length: totalPages }).map((_, i) => {
              const n = i + 1;
              return (
                <a
                  href={pageUrl(n)}
                  role="listitem"
                  class="page"
                  aria-current={n === currentPage ? "page" : undefined}
                >
                  {n}
                </a>
              );
            })}
          </div>

          <a
            href={nextUrl}
            class="step"
            aria-disabled={!nextUrl}
            tabindex={!nextUrl ? -1 : 0}
          >
            Next &rarr;
          </a>
        </nav>
      )
    }
  </div>
</section>

<style>
  .blog-grid-section {
    padding-top: 0;
    padding-bottom: 0;
  }

  .header {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .heading {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .description {
    margin: 0;
    max-width: 60ch;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;

    @media (min-width: 640px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (min-width: 1024px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    > .cell {
      min-width: 0;

      > * {
        width: 100%;
        height: 100%;
      }
    }
  }

  /* ── Pagination ───────────────────────────────────────────── */
  .pagination-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.25rem;
    padding-top: 0.9rem;
    border-top: 1px solid
      color-mix(in srgb, var(--border-subtle) 82%, transparent);
  }

  .pages {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid color-mix(in srgb, var(--border-subtle) 55%, transparent);
    border-radius: var(--radius-pill);
    background-color: transparent;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;

    &:hover {
      background-color: color-mix(
        in srgb,
        var(--accent-primary) 6%,
        var(--surface-elevated)
      );
      border-color: var(--accent-primary-alpha-16);
      transform: translateY(-1px);
    }

    &:where([aria-current="page"]) {
      background-color: var(--accent-secondary);
      border-color: var(--accent-secondary);
      color: var(--text-on-strong);
      box-shadow: var(--shadow-secondary-soft);

      &:hover {
        background-color: var(--accent-secondary);
        border-color: var(--accent-secondary);
        transform: none;
      }
    }
  }

  .step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.55rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--border-subtle) 65%, transparent);
    border-radius: var(--radius-pill);
    background-color: color-mix(
      in srgb,
      var(--surface-elevated) 88%,
      transparent
    );
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;

    &:hover {
      color: var(--accent-primary);
      border-color: var(--accent-primary-alpha-18);
      transform: translateY(-1px);
    }

    &:where([aria-disabled="true"]) {
      color: var(--text-muted);
      background-color: transparent;
      pointer-events: none;
      border-color: color-mix(in srgb, var(--border-subtle) 35%, transparent);
    }
  }

  .ghost {
    display: none;
  }

  @media (min-width: 640px) {
    .ghost:where([data-viewport="tablet-only"]),
    .ghost:where([data-viewport="tablet-up"]) {
      display: block;
    }
  }

  @media (min-width: 1024px) {
    .ghost:where([data-viewport="tablet-only"]) {
      display: none;
    }

    .ghost:where([data-viewport="desktop-only"]),
    .ghost:where([data-viewport="tablet-up"]) {
      display: block;
    }
  }

  @media (max-width: 639px) {
    .pagination-nav {
      align-items: stretch;
    }

    .pages {
      order: 3;
      width: 100%;
    }

    .step {
      flex: 1 1 10rem;
    }
  }
</style>
